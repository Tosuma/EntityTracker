<UserControl x:Class="EntityTracker.Wpf.Controls.SortableColumnHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <!-- A sort-only header: each click moves to the next sort, and the arrow shows the current one.
         Sized like FilterableColumnHeader so the header row stays aligned. -->
    <Button x:Name="SortButton"
            MinHeight="28"
            Padding="5,2"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="{Binding Description, ElementName=Root}"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding Command, ElementName=Root}"
            Cursor="Hand"
            ToolTip="{Binding Description, ElementName=Root}">
        <DockPanel LastChildFill="True">
            <controls:Icon DockPanel.Dock="Right"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           Size="14"
                           IconKey="Icon.ArrowUp"
                           Foreground="{DynamicResource Brush.Indicator.Active}"
                           Visibility="{Binding IsAscending, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <controls:Icon DockPanel.Dock="Right"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           Size="14"
                           IconKey="Icon.ArrowDown"
                           Foreground="{DynamicResource Brush.Indicator.Active}"
                           Visibility="{Binding IsDescending, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Text="{Binding Title, ElementName=Root}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Button>
</UserControl>
