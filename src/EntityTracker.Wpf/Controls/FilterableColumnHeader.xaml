<UserControl x:Class="EntityTracker.Wpf.Controls.FilterableColumnHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Button x:Name="MenuButton"
                MinHeight="28"
                Padding="5,2"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{Binding Filter.Title, ElementName=Root, StringFormat=Filter {0}}"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding Filter.OpenCommand, ElementName=Root}"
                Cursor="Hand"
                ToolTip="{Binding Filter.Title, ElementName=Root, StringFormat=Filter {0}}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Margin="7,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Text="▼">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filter.IsApplied, ElementName=Root}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Green100}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Filter.IsSorted, ElementName=Root}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Green100}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.Brand.Green100}"
                           Text="↑"
                           Visibility="{Binding Filter.IsSortAscending, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.Brand.Green100}"
                           Text="↓"
                           Visibility="{Binding Filter.IsSortDescending, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           Text="{Binding Filter.Title, ElementName=Root}" />
            </DockPanel>
        </Button>

        <Popup Placement="Bottom"
               PlacementTarget="{Binding ElementName=MenuButton}"
               StaysOpen="False"
               AllowsTransparency="True"
               DataContext="{Binding Filter, ElementName=Root}"
               IsOpen="{Binding IsOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <Border Width="270"
                    MaxHeight="430"
                    Margin="0,3,0,0"
                    Padding="12"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Border.Strong}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.16" ShadowDepth="2" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Visibility="{Binding CanSort, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,0,0,6"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   Text="Sort" />
                        <WrapPanel Margin="0,0,0,10">
                            <Button Margin="0,0,6,6"
                                    Command="{Binding SortAscendingCommand}"
                                    Content="Ascending"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="0,0,6,6"
                                    Command="{Binding SortDescendingCommand}"
                                    Content="Descending"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="0,0,0,6"
                                    Command="{Binding ClearSortCommand}"
                                    Content="Clear sort"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Margin="0,0,0,8"
                             Padding="7,5"
                             AutomationProperties.Name="Search filter values"
                             Text="{Binding OptionSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search values" />

                    <ScrollViewer Grid.Row="2"
                                  MaxHeight="220"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button Margin="0,0,0,5"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SelectAllCommand}"
                                    Content="Select all"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <ItemsControl ItemsSource="{Binding VisibleOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="1,4"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="No available values">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVisibleOptions}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <Separator Grid.Row="3" Margin="0,9" />

                    <DockPanel Grid.Row="4">
                        <Button DockPanel.Dock="Left"
                                Command="{Binding ClearFilterCommand}"
                                Content="Clear filter"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ApplyCommand}"
                                Content="Apply"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </DockPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
