<Window x:Class="EntityTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls"
        xmlns:domain="clr-namespace:EntityTracker.Domain;assembly=EntityTracker.Domain"
        xmlns:reporting="clr-namespace:EntityTracker.Reporting;assembly=EntityTracker.Reporting"
        xmlns:viewModels="clr-namespace:EntityTracker.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="EntityTracker"
        Icon="Assets/v2/EntityTracker.ico"
        Width="1120"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        Background="{StaticResource Brush.Surface.Page}"
        Foreground="{StaticResource Brush.Text.Primary}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <Style x:Key="SummaryFilterButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.Brand.Green100}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Card" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid" BasedOn="{StaticResource EntityTrackerDataGridStyle}">
            <EventSetter Event="PreviewMouseWheel" Handler="OnDataGridPreviewMouseWheel" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Editor.CancelCommand}" />
    </Window.InputBindings>

    <Grid>
    <DockPanel>
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <Setter Property="IsEnabled" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Editor.IsOpen}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>
        <Border DockPanel.Dock="Top"
                Padding="26,18"
                Background="{StaticResource Brush.Surface.Primary}">
            <StackPanel>
                <TextBlock Foreground="{StaticResource Brush.Text.OnDark}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Text="EntityTracker" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                           Text="Dependency-safe implementation overview" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="18,10"
                Background="{StaticResource Brush.Surface.Subtle}"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="110"
                             Height="5"
                             Margin="0,0,12,0"
                             IsIndeterminate="True" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           Text="{Binding BusyMessage}" />
            </StackPanel>
        </Border>

        <TabControl Margin="18"
                    SelectedValue="{Binding SelectedTab}"
                    SelectedValuePath="Tag">
            <TabItem Header="Overview" Tag="{x:Static viewModels:MainWindowTab.Overview}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="{Binding OverviewSearchResultSummary}" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding ActiveTable.ClearAllFiltersCommand}"
                                    Content="Clear filters &amp; sort"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding OpenOverviewSearchCommand}"
                                    Click="OnOpenOverviewSearchClick"
                                    Content="Search"
                                    ToolTip="Search entities (Ctrl+F)"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Command="{Binding RefreshCommand}"
                                    Content="Refresh"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="Persisted entities" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="Entities are grouped by priority while dependencies remain before the entities that use them." />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">

                        <Button AutomationProperties.Name="Show all active entities"
                                Command="{Binding ActiveTable.ClearAllFiltersCommand}"
                                ToolTip="Show all active entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Green100}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" Text="Total" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding TotalEntityCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Show not started entities"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.NotStarted}"
                                ToolTip="Show not started entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNotStartedSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Green100}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" Text="Not started" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding NotStartedCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Show in progress entities"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.InProgress}"
                                ToolTip="Show in progress entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInProgressSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Green100}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" Text="In progress" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding InProgressCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Show rework needed entities"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.ReworkNeeded}"
                                ToolTip="Show rework needed entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReworkNeededSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="9"
                                            Height="9"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource Brush.Status.ReworkNeeded}"
                                            CornerRadius="5" />
                                    <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" Text="Rework needed" />
                                </StackPanel>
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="{Binding ReworkNeededCount}" />
                            </StackPanel>
                        </Button>

                        <Button AutomationProperties.Name="Show development completed entities"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.DevelopmentCompleted}"
                                ToolTip="Show development completed entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDevelopmentCompletedSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Green100}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" Text="Dev. completed" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding DevelopmentCompletedCount}" />
                            </StackPanel>
                        </Button>

                        <Button AutomationProperties.Name="Show reconciled entities"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.Reconciled}"
                                ToolTip="Show reconciled entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReconciledSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Green100}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" Text="Reconciled" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ReconciledCount}" />
                            </StackPanel>
                        </Button>

                        <Border Margin="0,0,0,8"
                                Style="{StaticResource SummaryCardStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="{Binding ImplementedPercentage, StringFormat={}{0:F0}% implemented}" />
                                <Grid Height="10" Margin="0,9,0,0">
                                    <ProgressBar Foreground="{StaticResource Brush.Status.DevelopmentCompleted}"
                                                 Maximum="100"
                                                 Value="{Binding ImplementedPercentage, Mode=OneWay}" />
                                    <ProgressBar Background="Transparent"
                                                 Foreground="{StaticResource Brush.Status.ReworkNeeded}"
                                                 Maximum="100"
                                                 Value="{Binding ReconciledAndReworkPercentage, Mode=OneWay}" />
                                    <ProgressBar Background="Transparent"
                                                 Foreground="{StaticResource Brush.Status.Reconciled}"
                                                 Maximum="100"
                                                 Value="{Binding ReconciledPercentage, Mode=OneWay}" />
                                </Grid>
                                <WrapPanel Margin="0,6,0,0">
                                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                        <Border Width="8"
                                                Height="8"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource Brush.Status.DevelopmentCompleted}"
                                                CornerRadius="4" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   Text="Dev. completed" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                        <Border Width="8"
                                                Height="8"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource Brush.Status.ReworkNeeded}"
                                                CornerRadius="4" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   Text="Rework needed" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8"
                                                Height="8"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource Brush.Status.Reconciled}"
                                                CornerRadius="4" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   Text="Reconciled" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <Border Grid.Row="2"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Border.Medium}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding IsOverviewSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="OverviewSearchTextBox"
                                     MinWidth="280"
                                     Padding="9,7"
                                     ToolTip="Search active entities"
                                     Text="{Binding OverviewSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearOverviewSearchCommand}"
                                    Content="Clear"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Command="{Binding CloseOverviewSearchCommand}"
                                    Content="Close search"
                                    Style="{StaticResource SecondaryButtonStyle}" />

                            <CheckBox Grid.Row="1"
                                      Margin="0,9,0,0"
                                      VerticalAlignment="Center"
                                      Content="Search dependency names"
                                      IsEnabled="{Binding ActiveTable.CanSearchDependencies}"
                                      IsChecked="{Binding SearchOverviewDependencies}" />
                        </Grid>
                    </Border>

                    <Border x:Name="BulkStatusToolbar"
                            Grid.Row="3"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="{StaticResource Brush.Surface.Subtle}"
                            BorderBrush="{StaticResource Brush.Border.Medium}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DockPanel LastChildFill="False">
                            <TextBlock Margin="0,0,18,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="{Binding BulkSelectionSummary}" />
                            <TextBlock Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="Set status to" />
                            <ComboBox MinWidth="155"
                                      Margin="0,0,8,0"
                                      AutomationProperties.Name="Bulk target status"
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding BulkStatusOptions}"
                                      SelectedValue="{Binding SelectedBulkStatus}"
                                      SelectedValuePath="Value" />
                            <Button AutomationProperties.Name="Apply status to selected entities"
                                    Command="{Binding ApplyBulkStatusCommand}"
                                    Content="Apply status"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="4">
                    <Border Margin="0,0,0,12"
                            Padding="12"
                            Background="{StaticResource Brush.Surface.Subtle}"
                            BorderBrush="{StaticResource Brush.Border.Strong}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding HasOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{StaticResource Brush.Text.Primary}"
                                   Text="{Binding OperationMessage}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border
                            Margin="0,0,0,12"
                            MaxHeight="120"
                            Padding="12"
                            Background="{StaticResource Brush.Surface.Alert}"
                            BorderBrush="{StaticResource Brush.Accent}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding HasOverviewError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="{Binding OverviewErrorMessage}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    </StackPanel>

                    <Grid Grid.Row="5">
                        <DataGrid x:Name="OverviewDataGrid"
                                  ItemsSource="{Binding OverviewItems}"
                                  SelectionChanged="OnOverviewSelectionChanged"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="72" Binding="{Binding Priority}" Header="Priority" />
                                <DataGridTextColumn Width="70" Binding="{Binding Rank}" Header="Rank" />
                                <DataGridTemplateColumn Width="2.2*" Header="Entity">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding SourceName}" />
                                                <Button Width="24"
                                                        Height="24"
                                                        Margin="6,0,0,0"
                                                        Padding="2"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding GraphIssueTitle}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding GraphIssueTitle}"
                                                        Visibility="{Binding HasGraphIssue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Click="OnContextMenuButtonClick">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDirectlyUnresolved}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Viewbox Width="18"
                                                             Height="18"
                                                             IsHitTestVisible="False">
                                                        <Canvas Width="24" Height="24">
                                                            <Ellipse Width="20"
                                                                     Height="20"
                                                                     Canvas.Left="2"
                                                                     Canvas.Top="2"
                                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                     StrokeThickness="2" />
                                                            <Path Data="M12,6 L12,14"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeThickness="2" />
                                                            <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Canvas.Left="10.75"
                                                                     Canvas.Top="17"
                                                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Focusable="False" IsHitTestVisible="False">
                                                                <MenuItem.Template>
                                                                    <ControlTemplate TargetType="MenuItem">
                                                                        <ContentPresenter ContentSource="Header" />
                                                                    </ControlTemplate>
                                                                </MenuItem.Template>
                                                                <MenuItem.Header>
                                                                    <StackPanel Width="320" Margin="12">
                                                                        <TextBlock FontSize="15"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource Brush.Text.Primary}"
                                                                                   Text="{Binding GraphIssueTitle}" />
                                                                        <TextBlock Margin="0,8,0,0"
                                                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                                                   Text="{Binding GraphIssueDescription}"
                                                                                   TextWrapping="Wrap" />
                                                                        <TextBlock Margin="0,10,0,0"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource Brush.Text.Primary}"
                                                                                   Text="{Binding GraphIssueNames}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </MenuItem.Header>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="150"
                                                    Binding="{Binding ResponsibleDeveloperDisplay}">
                                    <DataGridTextColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding DataContext.ActiveTable.ResponsibleDeveloperFilter, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="145"
                                                    Binding="{Binding GroupNameDisplay}">
                                    <DataGridTextColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding DataContext.ActiveTable.GroupFilter, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="125" Binding="{Binding Provenance}" Header="Source" />
                                <DataGridTextColumn Width="130" Binding="{Binding Status}">
                                    <DataGridTextColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding DataContext.ActiveTable.StatusFilter, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="130" Binding="{Binding WorkStatus}">
                                    <DataGridTextColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding DataContext.ActiveTable.WorkStatusFilter, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="105" Binding="{Binding DependencyCount}" Header="Dependencies" />
                                <DataGridTextColumn Width="2.2*" Binding="{Binding MissingDependencies}" Header="Missing Dependencies" />
                                <DataGridTextColumn Width="2*" Binding="{Binding Notes}" Header="Notes" />
                                <DataGridTemplateColumn Width="52" Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="30"
                                                    Height="28"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Content="⋮"
                                                    Cursor="Hand"
                                                    FontSize="19"
                                                    ToolTip="Entity actions"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="OnContextMenuButtonClick">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{Binding PlacementTarget.DataContext.ActionLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Command="{Binding PlacementTarget.Tag.EditOverviewEntityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="{StaticResource Brush.Surface.Subtle}"
                                BorderBrush="{StaticResource Brush.Border.Default}"
                                BorderThickness="1"
                                Visibility="{Binding ShowOverviewEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="No active entities" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="Add an entity manually or open Schema Synchronization to import a CSV." />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Brush.Surface.Subtle}"
                                BorderBrush="{StaticResource Brush.Border.Default}"
                                BorderThickness="1"
                                Visibility="{Binding ShowOverviewSearchEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="No matching entities" />
                                <TextBlock Margin="0,7,0,12"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="Try another search or clear one of the active column filters."
                                           TextWrapping="Wrap" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding ClearOverviewSearchCommand}"
                                            Content="Clear search"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Command="{Binding ActiveTable.ClearAllFiltersCommand}"
                                            Content="Clear filters &amp; sort"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Archived" Tag="{x:Static viewModels:MainWindowTab.Archived}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding ArchivedTable.ClearAllFiltersCommand}"
                                    Content="Clear filters &amp; sort"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding ArchivedTable.OpenSearchCommand}"
                                    Click="OnOpenOverviewSearchClick"
                                    Content="Search"
                                    ToolTip="Search archived entities (Ctrl+F)"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Command="{Binding RefreshCommand}"
                                    Content="Refresh"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="Archived entities" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="Inspect archived metadata or restore an entity to the active dependency graph." />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Border.Medium}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding ArchivedTable.IsSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ArchivedSearchTextBox"
                                     MinWidth="280"
                                     Padding="9,7"
                                     ToolTip="Search archived entities"
                                     Text="{Binding ArchivedTable.SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding ArchivedTable.ClearSearchCommand}"
                                    Content="Clear"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Command="{Binding ArchivedTable.CloseSearchCommand}"
                                    Content="Close search"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock Margin="0,0,0,8"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="{Binding ArchivedSearchResultSummary}" />
                        <Border Margin="0,0,0,12"
                                MaxHeight="120"
                                Padding="12"
                                Background="{StaticResource Brush.Surface.Alert}"
                                BorderBrush="{StaticResource Brush.Accent}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding HasOverviewError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="{Binding OverviewErrorMessage}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <DataGrid x:Name="ArchivedDataGrid"
                                  ItemsSource="{Binding ArchivedItems}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="2.2*" Binding="{Binding SourceName}" Header="Entity" />
                                <DataGridTextColumn Width="150" Binding="{Binding ResponsibleDeveloperDisplay}">
                                    <DataGridTextColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding DataContext.ArchivedTable.ResponsibleDeveloperFilter, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="145" Binding="{Binding GroupNameDisplay}">
                                    <DataGridTextColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding DataContext.ArchivedTable.GroupFilter, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="125" Binding="{Binding Provenance}" Header="Source" />
                                <DataGridTextColumn Width="130" Binding="{Binding Status}">
                                    <DataGridTextColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding DataContext.ArchivedTable.StatusFilter, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="2*" Binding="{Binding Notes}" Header="Notes" />
                                <DataGridTemplateColumn Width="52" Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="30"
                                                    Height="28"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Content="⋮"
                                                    Cursor="Hand"
                                                    FontSize="19"
                                                    ToolTip="Archived entity actions"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="OnContextMenuButtonClick">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{Binding PlacementTarget.DataContext.ActionLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Command="{Binding PlacementTarget.Tag.EditOverviewEntityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="{StaticResource Brush.Surface.Subtle}"
                                BorderBrush="{StaticResource Brush.Border.Default}"
                                BorderThickness="1"
                                Visibility="{Binding ShowArchivedEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="No archived entities" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="Archived entities will appear here and can be inspected or restored." />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Brush.Surface.Subtle}"
                                BorderBrush="{StaticResource Brush.Border.Default}"
                                BorderThickness="1"
                                Visibility="{Binding ShowArchivedSearchEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="No matching archived entities" />
                                <TextBlock Margin="0,7,0,12"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="Try another search or clear one of the active column filters." />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding ArchivedTable.ClearSearchCommand}"
                                            Content="Clear search"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Command="{Binding ArchivedTable.ClearAllFiltersCommand}"
                                            Content="Clear filters &amp; sort"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Schema Synchronization" Tag="{x:Static viewModels:MainWindowTab.SchemaSynchronization}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding OpenSqlQueryCommand}"
                                    Content="Get SQL Query"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Command="{Binding ImportCsvCommand}"
                                    Content="Choose CSV and Review"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="Schema synchronization" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="{Binding Review.SelectedFileName}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="{StaticResource Brush.Surface.Card}"
                            BorderBrush="{StaticResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <Border Margin="0,0,0,12"
                                    Padding="10"
                                    Background="{StaticResource Brush.Surface.Subtle}"
                                    BorderBrush="{StaticResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}"
                                               Text="{Binding LatestImportHeadline}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               Text="{Binding LatestImportDetails}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock FontWeight="SemiBold" Text="Import type" />
                            <RadioButton Margin="0,8,0,0"
                                         GroupName="ImportMode"
                                         IsEnabled="{Binding Review.CanSelectImportMode}"
                                         IsChecked="{Binding Review.IsCompleteImport}"
                                         Content="Complete database snapshot (default)" />
                            <TextBlock Margin="22,2,0,0"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="The CSV contains the entire schema. Existing entities missing from the file will be archived." />
                            <RadioButton Margin="0,9,0,0"
                                         GroupName="ImportMode"
                                         IsEnabled="{Binding Review.CanSelectImportMode}"
                                         IsChecked="{Binding Review.IsPartialImport}"
                                         Content="Partial database snapshot" />
                            <TextBlock Margin="22,2,0,0"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="The CSV contains only part of the schema. Existing entities missing from the file will be left unchanged." />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       FontWeight="SemiBold"
                                       Text="Import type is locked for while reviewing. Cancel the review to choose a different type."
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Review.HasReview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="SchemaReviewScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnReviewPreviewMouseWheel"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Margin="0,0,0,8"
                                        MaxHeight="120"
                                        Padding="10"
                                        Background="{StaticResource Brush.Surface.Subtle}"
                                        BorderBrush="{StaticResource Brush.Accent}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding Review.HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Review.Warnings}" />
                                    </ScrollViewer>
                                </Border>

                                <Border Margin="0,0,0,8"
                                        MaxHeight="120"
                                        Padding="10"
                                        Background="{StaticResource Brush.Surface.Alert}"
                                        BorderBrush="{StaticResource Brush.Accent}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding Review.HasDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Review.Diagnostics}" />
                                    </ScrollViewer>
                                </Border>

                                <StackPanel Visibility="{Binding Review.HasReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Margin="0,0,0,10"
                                               FontWeight="SemiBold"
                                               Text="{Binding Review.ImportModeLabel, StringFormat=Import mode: {0}}" />

                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasNewEntities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Brand.Green100}" Text="New entities" />
                                        <ItemsControl ItemsSource="{Binding Review.NewEntities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0" Padding="10" Background="{StaticResource Brush.Surface.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right"
                                                                        Width="30"
                                                                        Height="28"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Content="⋮"
                                                                        Cursor="Hand"
                                                                        FontSize="19"
                                                                        ToolTip="Entity actions"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Click="OnContextMenuButtonClick">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Edit dependencies"
                                                                                      Command="{Binding PlacementTarget.Tag.EditReviewEntityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SourceName, StringFormat=+ {0}}" />
                                                            </DockPanel>
                                                            <TextBlock Margin="16,3,0,0" Foreground="{StaticResource Brush.Text.Secondary}" Text="{Binding Details}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasChangedEntities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Text="Changed entities" />
                                        <ItemsControl ItemsSource="{Binding Review.ChangedEntities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0" Padding="10" Background="{StaticResource Brush.Surface.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right"
                                                                        Width="30"
                                                                        Height="28"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Content="⋮"
                                                                        Cursor="Hand"
                                                                        FontSize="19"
                                                                        ToolTip="Entity actions"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Click="OnContextMenuButtonClick">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Edit dependencies"
                                                                                      Command="{Binding PlacementTarget.Tag.EditReviewEntityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SourceName, StringFormat=~ {0}}" />
                                                            </DockPanel>
                                                            <TextBlock Margin="16,3,0,0" Foreground="{StaticResource Brush.Text.Secondary}" Text="{Binding Details}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel x:Name="MissingReviewSection"
                                                Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasMissingEntities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Padding="8,5"
                                                Background="{StaticResource Brush.Review.Missing.Header}"
                                                CornerRadius="3">
                                            <TextBlock FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text.Primary}"
                                                       Text="Missing / possibly removed" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Review.MissingEntities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0"
                                                            Padding="10"
                                                            Background="{StaticResource Brush.Review.Missing.Surface}"
                                                            BorderBrush="{StaticResource Brush.Review.Missing.Border}"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding SourceName, StringFormat=− {0}}" />
                                                            <TextBlock Margin="16,3,0,0" Foreground="{StaticResource Brush.Text.Primary}" Text="{Binding Details}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasManualOnlyEntities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Brand.Green100}"
                                                   Text="Manual entities not yet in CSV — kept active" />
                                        <ItemsControl ItemsSource="{Binding Review.ManualOnlyEntities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0"
                                                            Padding="10"
                                                            Background="{StaticResource Brush.Surface.Subtle}"
                                                            BorderBrush="{StaticResource Brush.Border.Strong}"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Text="{Binding SourceName, StringFormat=• {0}}" />
                                                            <TextBlock Margin="16,3,0,0"
                                                                       Foreground="{StaticResource Brush.Text.Primary}"
                                                                       Text="{Binding Details}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel x:Name="UnresolvedReviewSection"
                                                Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasUnresolvedEntities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Review.Warning.Header}"
                                                   Text="Unresolved dependencies" />
                                        <ItemsControl ItemsSource="{Binding Review.UnresolvedEntities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0"
                                                            Padding="10"
                                                            Background="{StaticResource Brush.Review.Warning.Surface}"
                                                            BorderBrush="{StaticResource Brush.Review.Warning.Border}"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding SourceName, StringFormat=! {0}}" />
                                                            <TextBlock Margin="16,3,0,0"
                                                                       Foreground="{StaticResource Brush.Review.Warning.Text}"
                                                                       Text="{Binding Details}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasProgressImpacts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Accent}"
                                                   Text="Completed entities with dependency changes" />
                                        <TextBlock Margin="0,3,0,4"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   Text="Choose whether each entity keeps its current status or needs rework before importing."
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Review.ProgressImpacts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0"
                                                            Padding="10"
                                                            Background="{StaticResource Brush.Surface.Subtle}"
                                                            BorderBrush="{StaticResource Brush.Accent}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Foreground="{StaticResource Brush.Text.Primary}"
                                                                           Text="{Binding CurrentStatus, StringFormat=Current: {0}}" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Brush.Text.Primary}"
                                                                           Text="{Binding DecisionText}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1"
                                                                        Margin="12,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Orientation="Horizontal">
                                                                <Button Margin="0,0,8,0"
                                                                        Command="{Binding DataContext.KeepSynchronizationStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="Keep current status"
                                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                                <Button Command="{Binding DataContext.MarkSynchronizationReworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="Mark Rework needed"
                                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Padding="10" Background="{StaticResource Brush.Surface.Subtle}" BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
                                        <TextBlock Foreground="{StaticResource Brush.Text.Primary}"
                                                   Text="{Binding Review.UnchangedEntityCount, StringFormat=✓ {0} imported entities unchanged}" />
                                    </Border>
                                </StackPanel>

                                <Border Padding="20"
                                        Background="{StaticResource Brush.Surface.Subtle}"
                                        BorderBrush="{StaticResource Brush.Border.Default}"
                                        BorderThickness="1"
                                        Visibility="{Binding Review.ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   Text="Choose an import type, then select a CSV to review. Nothing is saved until Import Changes." />
                                        <TextBlock Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   Text="Need an export query? Get it separately with Get SQL Query." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding Review.HasReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Margin="0,0,8,0"
                                Command="{Binding CancelSynchronizationCommand}"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Command="{Binding ApplySynchronizationCommand}"
                                Content="Import Changes"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Add Entity" Tag="{x:Static viewModels:MainWindowTab.AddEntity}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   Text="Create a tracked entity" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="Add a new entity and its initial mandatory dependencies. Unknown names are kept as unresolved warnings."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnReviewPreviewMouseWheel"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock FontWeight="SemiBold" Text="Entity name" />
                            <TextBox Margin="0,6,0,12"
                                     MinWidth="420"
                                     Padding="9,7"
                                     Text="{Binding ManualCreation.EntityName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock FontWeight="SemiBold" Text="Responsible developer" />
                            <TextBox Margin="0,6,0,18"
                                     MinWidth="420"
                                     Padding="9,7"
                                     Text="{Binding ManualCreation.ResponsibleDeveloper, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock FontWeight="SemiBold" Text="Group" />
                            <TextBlock Margin="0,3,0,7"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="Type a new group or choose an existing group below."
                                       TextWrapping="Wrap" />
                            <TextBox MinWidth="420"
                                     Padding="9,7"
                                     Text="{Binding ManualCreation.GroupName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="{Binding ManualCreation.GroupSearchMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ManualCreation.HasGroupSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl Margin="0,6,0,18"
                                          ItemsSource="{Binding ManualCreation.GroupSuggestions}"
                                          Visibility="{Binding ManualCreation.HasGroupSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,5"
                                                Padding="8"
                                                Background="{StaticResource Brush.Surface.Card}"
                                                BorderBrush="{StaticResource Brush.Border.Default}"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Padding="12,5"
                                                        Command="{Binding DataContext.ManualCreation.UseGroupSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Use"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock FontWeight="SemiBold" Text="Add dependencies" />
                            <TextBlock Margin="0,3,0,7"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="Search active entities, or deliberately keep an unknown name as unresolved."
                                       TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox MinWidth="420"
                                         Padding="9,7"
                                         Text="{Binding ManualCreation.DependencyQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding ManualCreation.AddUnresolvedCommand}"
                                        Content="Add as unresolved"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="{Binding ManualCreation.SearchMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ManualCreation.HasSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <ItemsControl Margin="0,6,0,0"
                                          ItemsSource="{Binding ManualCreation.Suggestions}"
                                          Visibility="{Binding ManualCreation.HasSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,5"
                                                Padding="8"
                                                Background="{StaticResource Brush.Surface.Card}"
                                                BorderBrush="{StaticResource Brush.Border.Default}"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Padding="12,5"
                                                        Command="{Binding DataContext.ManualCreation.AddExistingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Add"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding SourceName}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,18,0,7"
                                       FontWeight="SemiBold"
                                       Text="Selected dependencies" />
                            <ItemsControl ItemsSource="{Binding ManualCreation.SelectedDependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="9"
                                                Background="{StaticResource Brush.Surface.Card}"
                                                BorderBrush="{StaticResource Brush.Border.Default}"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Padding="12,5"
                                                        Command="{Binding DataContext.ManualCreation.RemoveDependencyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Remove"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                                               Text="{Binding ResolutionLabel}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,12,0,0"
                                    MaxHeight="110"
                                    Padding="10"
                                    Background="{StaticResource Brush.Surface.Subtle}"
                                    BorderBrush="{StaticResource Brush.Accent}"
                                    BorderThickness="1"
                                    Visibility="{Binding ManualCreation.HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ManualCreation.Warnings}" />
                                </ScrollViewer>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="10"
                                    Background="{StaticResource Brush.Surface.Subtle}"
                                    BorderBrush="{StaticResource Brush.Accent}"
                                    BorderThickness="1"
                                    Visibility="{Binding ManualCreation.HasArchivedEntityMatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Margin="12,0,0,0"
                                            Command="{Binding ManualCreation.RestoreArchivedCommand}"
                                            Content="Restore existing entity"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Text.Primary}"
                                               Text="{Binding ManualCreation.ArchivedEntityMessage}"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    MaxHeight="110"
                                    Padding="10"
                                    Background="{StaticResource Brush.Surface.Alert}"
                                    BorderBrush="{StaticResource Brush.Accent}"
                                    BorderThickness="1"
                                    Visibility="{Binding ManualCreation.HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ManualCreation.Errors}" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Margin="0,12,0,0"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="{Binding ManualCreation.OperationMessage}"
                                       Visibility="{Binding ManualCreation.HasOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Command="{Binding ManualCreation.CancelCommand}"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Command="{Binding ManualCreation.CreateCommand}"
                                Content="Create Entity"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Progress" Tag="{x:Static viewModels:MainWindowTab.Progress}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnReviewPreviewMouseWheel"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="History" />
                                <ComboBox MinWidth="145"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding Progress.RangeOptions}"
                                          SelectedValue="{Binding Progress.SelectedRange}"
                                          SelectedValuePath="Value" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="Progress history" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="Current work status and persisted implementation/readiness trends." />
                            </StackPanel>
                        </DockPanel>

                        <Border Margin="0,0,0,12"
                                Padding="12"
                                Background="{StaticResource Brush.Surface.Card}"
                                BorderBrush="{StaticResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding Progress.IsCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Text="From" />
                                    <DatePicker Width="145" SelectedDate="{Binding Progress.CustomFrom}" />
                                    <TextBlock Margin="14,0,7,0" VerticalAlignment="Center" Text="To" />
                                    <DatePicker Width="145" SelectedDate="{Binding Progress.CustomTo}" />
                                    <Button Margin="12,0,0,0"
                                            Command="{Binding Progress.ApplyRangeCommand}"
                                            Content="Apply range"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="{Binding Progress.RangeValidationMessage}"
                                           Visibility="{Binding Progress.HasRangeValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,12"
                                MaxHeight="100"
                                Padding="10"
                                Background="{StaticResource Brush.Surface.Alert}"
                                BorderBrush="{StaticResource Brush.Accent}"
                                BorderThickness="1"
                                Visibility="{Binding Progress.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="{Binding Progress.ErrorMessage}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <Border Margin="0,0,0,12"
                                MaxHeight="100"
                                Padding="10"
                                Background="{StaticResource Brush.Surface.Subtle}"
                                BorderBrush="{StaticResource Brush.Border.Strong}"
                                BorderThickness="1"
                                Visibility="{Binding Progress.HasExportMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="{Binding Progress.ExportMessage}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <Border Margin="0,0,0,12"
                                Padding="14,12"
                                Background="{StaticResource Brush.Surface.Card}"
                                BorderBrush="{StaticResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Visibility="{Binding Progress.HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               Text="{Binding Progress.ManagerDateSummary}" />
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="Manager summary" />
                                </DockPanel>
                                <UniformGrid Columns="5">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" Text="Active" />
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Progress.ManagerSummary.ActiveEntityCount}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" Text="Implemented" />
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Progress.ManagerSummary.ImplementedEntityCount}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" Text="Reconciled" />
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Progress.ManagerSummary.ReconciledEntityCount}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" Text="Ready" />
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Progress.ManagerSummary.ReadyEntityCount}" />
                                    </StackPanel>
                                    <Border Margin="6,0,0,0"
                                            Padding="8,4"
                                            Background="{StaticResource Brush.Status.Blocked}"
                                            CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" Text="Blocked" />
                                            <TextBlock FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text.Primary}"
                                                       Text="{Binding Progress.ManagerSummary.BlockedEntityCount}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,8"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="No persisted progress history is available in this range."
                                   Visibility="{Binding Progress.ShowNoHistoricalData, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <UniformGrid Columns="2">
                            <Border Height="290" Margin="0,0,6,12" Padding="12" Background="{StaticResource Brush.Surface.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Entities by current work status" />
                                        <Button Grid.Column="1" Margin="8,0,5,0" Padding="10,5"
                                                Command="{Binding Progress.SaveChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.CurrentStatus}"
                                                Content="Save PNG" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Save a report-ready PNG" />
                                        <Button Grid.Column="2" Padding="10,5"
                                                Command="{Binding Progress.CopyChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.CurrentStatus}"
                                                Content="Copy" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Copy a report-ready PNG to the clipboard" />
                                    </Grid>
                                    <lvc:PieChart Grid.Row="1"
                                                  LegendPosition="Right"
                                                  Series="{Binding Progress.CurrentStatusSeries}" />
                                </Grid>
                            </Border>
                            <Border Height="290" Margin="6,0,0,12" Padding="12" Background="{StaticResource Brush.Surface.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Implemented entities over time" />
                                        <Button Grid.Column="1" Margin="8,0,5,0" Padding="10,5"
                                                Command="{Binding Progress.SaveChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.ImplementedOverTime}"
                                                Content="Save PNG" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Save a report-ready PNG" />
                                        <Button Grid.Column="2" Padding="10,5"
                                                Command="{Binding Progress.CopyChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.ImplementedOverTime}"
                                                Content="Copy" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Copy a report-ready PNG to the clipboard" />
                                    </Grid>
                                    <lvc:CartesianChart Grid.Row="1"
                                                        LegendPosition="Top"
                                                        Series="{Binding Progress.ImplementedSeries}"
                                                        TooltipPosition="Top"
                                                        XAxes="{Binding Progress.ImplementedXAxes}"
                                                        YAxes="{Binding Progress.CountYAxes}" />
                                </Grid>
                            </Border>
                            <Border Height="290" Margin="0,0,6,0" Padding="12" Background="{StaticResource Brush.Surface.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Ready vs blocked over time" />
                                        <Button Grid.Column="1" Margin="8,0,5,0" Padding="10,5"
                                                Command="{Binding Progress.SaveChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.ReadyAndBlockedOverTime}"
                                                Content="Save PNG" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Save a report-ready PNG" />
                                        <Button Grid.Column="2" Padding="10,5"
                                                Command="{Binding Progress.CopyChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.ReadyAndBlockedOverTime}"
                                                Content="Copy" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Copy a report-ready PNG to the clipboard" />
                                    </Grid>
                                    <lvc:CartesianChart Grid.Row="1"
                                                        LegendPosition="Top"
                                                        Series="{Binding Progress.ReadinessSeries}"
                                                        TooltipPosition="Top"
                                                        XAxes="{Binding Progress.ReadinessXAxes}"
                                                        YAxes="{Binding Progress.CountYAxes}" />
                                </Grid>
                            </Border>
                            <Border Height="290" Margin="6,0,0,0" Padding="12" Background="{StaticResource Brush.Surface.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Weekly net implemented change" />
                                        <Button Grid.Column="1" Margin="8,0,5,0" Padding="10,5"
                                                Command="{Binding Progress.SaveChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.WeeklyNetImplementedChange}"
                                                Content="Save PNG" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Save a report-ready PNG" />
                                        <Button Grid.Column="2" Padding="10,5"
                                                Command="{Binding Progress.CopyChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.WeeklyNetImplementedChange}"
                                                Content="Copy" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Copy a report-ready PNG to the clipboard" />
                                    </Grid>
                                    <lvc:CartesianChart Grid.Row="1"
                                                        LegendPosition="Top"
                                                        Series="{Binding Progress.WeeklySeries}"
                                                        TooltipPosition="Top"
                                                        XAxes="{Binding Progress.WeeklyXAxes}"
                                                        YAxes="{Binding Progress.SignedYAxes}" />
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Help &amp; SQL" Tag="{x:Static viewModels:MainWindowTab.SqlHelp}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding Help.BackToImportCommand}"
                                Content="Back to Schema Synchronization"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="PostgreSQL schema export" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="Run this query in PostgreSQL, export its result as a semicolon-delimited CSV, then import that CSV separately." />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="{StaticResource Brush.Surface.Selected}"
                            BorderBrush="{StaticResource Brush.Border.Medium}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding Help.CsvContractVersion, StringFormat=PostgreSQL · CSV contract v{0}}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="The query targets the public schema by default. Change target_schema in the settings section near the top when needed. Keep the six column headers unchanged."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="Export as UTF-8 CSV with a semicolon (;) delimiter and include the header row." />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding Help.CopyQueryCommand}"
                                    Content="Copy SQL"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="{Binding Help.CopyMessage}"
                                       Visibility="{Binding Help.HasCopyMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </DockPanel>
                        <TextBox Grid.Row="1"
                                 Padding="12"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 HorizontalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 Text="{Binding Help.Query, Mode=OneWay}"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Connections" Tag="{x:Static viewModels:MainWindowTab.Connections}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="720"
                                Margin="12"
                                HorizontalAlignment="Left">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   Text="Storage connections" />
                        <TextBlock Margin="0,4,0,18"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="Save non-secret SharePoint setup for a future approved connection. This version does not connect to SharePoint; SQLite stays active."
                                   TextWrapping="Wrap" />

                        <Border Padding="16"
                                Background="{StaticResource Brush.Surface.Selected}"
                                BorderBrush="{StaticResource Brush.Border.Medium}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="Current storage: SQLite" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="A saved SharePoint setup is configuration only. It does not validate access, authenticate, synchronize, or switch storage providers."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,20,0,5"
                                   FontWeight="SemiBold"
                                   Text="Connection name" />
                        <TextBox Padding="9,7"
                                 MaxLength="100"
                                 Text="{Binding Connections.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="A friendly label, such as Production tracking site." />

                        <TextBlock Margin="0,16,0,5"
                                   FontWeight="SemiBold"
                                   Text="SharePoint site URL" />
                        <TextBox Padding="9,7"
                                 Text="{Binding Connections.SiteUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="Use the HTTPS site URL only. Do not enter credentials, tokens, query parameters, or a list URL."
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,16,0,0"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   Text="{Binding Connections.Message}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Connections.HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Margin="0,12,0,0"
                                Padding="10"
                                Background="{StaticResource Brush.Surface.Alert}"
                                BorderBrush="{StaticResource Brush.Accent}"
                                BorderThickness="1"
                                Visibility="{Binding Connections.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}"
                                       Text="{Binding Connections.ErrorMessage}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                            <Button Command="{Binding Connections.SaveCommand}"
                                    Content="Save setup"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding Connections.RequestRemoveCommand}"
                                    Content="Remove saved setup"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>

                        <Border Margin="0,16,0,0"
                                Padding="14"
                                Background="{StaticResource Brush.Surface.Subtle}"
                                BorderBrush="{StaticResource Brush.Accent}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding Connections.IsRemoveConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="Remove this saved SharePoint setup?" />
                                <TextBlock Margin="0,4,0,12"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="This removes only the local non-secret configuration. Your SQLite data is not changed."
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding Connections.CancelRemoveCommand}"
                                            Content="Cancel"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Margin="8,0,0,0"
                                            Command="{Binding Connections.ConfirmRemoveCommand}"
                                            Content="Remove setup"
                                            Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,20,0,0"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   FontSize="11"
                                   Text="{Binding Connections.SettingsPath, StringFormat=Settings file: {0}}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>

        <Grid Panel.ZIndex="100"
              Background="{StaticResource Brush.Overlay}"
              Visibility="{Binding Editor.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MinWidth="700"
                    MaxWidth="900"
                    MaxHeight="660"
                    Margin="30"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Border.Medium}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   Text="{Binding Editor.ContextTitle}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="{Binding Editor.ContextDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnReviewPreviewMouseWheel"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel MinWidth="650" MaxWidth="820" HorizontalAlignment="Left">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="{Binding Editor.SelectedEntityName}" />
                            <TextBlock Margin="0,3,0,16"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Text="{Binding Editor.EntityDetails}" />
                            <StackPanel Visibility="{Binding Editor.HasSelectedEntity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock FontWeight="SemiBold" Text="Development status" />
                                        <ComboBox Margin="0,5,0,0"
                                                  DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding Editor.CanEditProgress}"
                                                  ItemsSource="{Binding Editor.StatusOptions}"
                                                  SelectedValue="{Binding Editor.SelectedStatus}"
                                                  SelectedValuePath="Value" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="Notes" />
                                        <TextBox MinHeight="64"
                                                 Margin="0,5,0,0"
                                                 Padding="8"
                                                 AcceptsReturn="True"
                                                 IsEnabled="{Binding Editor.CanEditProgress}"
                                                 Text="{Binding Editor.EditedNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock FontWeight="SemiBold" Text="Responsible developer" />
                                    <TextBox Margin="0,5,0,0"
                                             Padding="8,6"
                                             IsEnabled="{Binding Editor.CanEditProgress}"
                                             Text="{Binding Editor.EditedResponsibleDeveloper, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock FontWeight="SemiBold" Text="Group" />
                                    <TextBox Margin="0,5,0,0"
                                             Padding="8,6"
                                             IsEnabled="{Binding Editor.CanEditProgress}"
                                             Text="{Binding Editor.EditedGroupName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,7,0,0"
                                               Foreground="{StaticResource Brush.Text.Primary}"
                                               Text="{Binding Editor.GroupSearchMessage}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Editor.HasGroupSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ItemsControl Margin="0,6,0,0"
                                                  ItemsSource="{Binding Editor.GroupSuggestions}"
                                                  Visibility="{Binding Editor.HasGroupSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,5"
                                                        Padding="8"
                                                        Background="{StaticResource Brush.Surface.Card}"
                                                        BorderBrush="{StaticResource Brush.Border.Default}"
                                                        BorderThickness="1">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right"
                                                                Padding="12,5"
                                                                Command="{Binding DataContext.Editor.UseGroupSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Use"
                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock FontWeight="SemiBold" Text="Requested priority" />
                                        <ComboBox Margin="0,5,0,0"
                                                  DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding Editor.CanEditPriority}"
                                                  ItemsSource="{Binding Editor.PriorityOptions}"
                                                  SelectedValue="{Binding Editor.SelectedRequestedPriority}"
                                                  SelectedValuePath="Value" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="Effective priority" />
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Editor.EffectivePriority}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   Text="Inherited from this entity or an active dependent target."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,0,0,14"
                                        Padding="10"
                                        Background="{StaticResource Brush.Surface.Subtle}"
                                        BorderBrush="{StaticResource Brush.Border.Medium}"
                                        BorderThickness="1"
                                        Visibility="{Binding Editor.HasPendingPriorityChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Priority impact preview" />
                                        <TextBlock Margin="0,2,0,8"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   Text="This shows the target and resolved prerequisites affected when you save."
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Editor.PriorityPreviewRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="100" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Role}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding RequestedPriority, StringFormat=Requested: {0}}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding EffectivePriority, StringFormat=Effective: {0}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Margin="0,7,0,0"
                                                Padding="8"
                                                Background="{StaticResource Brush.Surface.Card}"
                                                BorderBrush="{StaticResource Brush.Accent}"
                                                BorderThickness="1"
                                                Visibility="{Binding Editor.HasPriorityUnresolvedDependencies, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="Unresolved dependencies cannot receive priority:" />
                                                <ItemsControl Margin="0,3,0,0"
                                                              ItemsSource="{Binding Editor.PriorityUnresolvedDependencyNames}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding Editor.ShowDependencyEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontWeight="SemiBold" Text="Add a manual dependency" />
                                <TextBlock Margin="0,3,0,7"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Text="Search active entities, or deliberately retain an unknown name as unresolved."
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox MinWidth="420"
                                             Padding="9,7"
                                             Text="{Binding Editor.DependencyQuery, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding Editor.AddUnresolvedCommand}"
                                            Content="Add as unresolved"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>

                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="{Binding Editor.SearchMessage}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Editor.HasSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <ItemsControl Margin="0,6,0,0"
                                              ItemsSource="{Binding Editor.Suggestions}"
                                              Visibility="{Binding Editor.HasSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,5" Padding="8" Background="{StaticResource Brush.Surface.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.Editor.AddExistingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Add"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding SourceName}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>

                                <TextBlock Margin="0,18,0,7" FontWeight="SemiBold" Text="Dependencies and overrides" />
                                <ItemsControl ItemsSource="{Binding Editor.Dependencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="9" Background="{StaticResource Brush.Surface.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding DataContext.Editor.ShowDependencyEditor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button Margin="6,0,0,0"
                                                                Command="{Binding DataContext.Editor.SuppressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Suppress imported"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Visibility="{Binding CanSuppress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <Button Margin="6,0,0,0"
                                                                Command="{Binding DataContext.Editor.RemoveManualCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Remove manual addition"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Visibility="{Binding CanRemoveManual, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <Button Margin="6,0,0,0"
                                                                Command="{Binding DataContext.Editor.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Restore imported"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Visibility="{Binding CanRestore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource Brush.Text.Secondary}" Text="{Binding Origin}" />
                                                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource Brush.Text.Secondary}" Text="{Binding Resolution}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Margin="0,12,0,0"
                                        MaxHeight="110"
                                        Padding="10"
                                        Background="{StaticResource Brush.Surface.Subtle}"
                                        BorderBrush="{StaticResource Brush.Accent}"
                                        BorderThickness="1"
                                        Visibility="{Binding Editor.HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Editor.Warnings}" />
                                    </ScrollViewer>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        MaxHeight="110"
                                        Padding="10"
                                        Background="{StaticResource Brush.Surface.Alert}"
                                        BorderBrush="{StaticResource Brush.Accent}"
                                        BorderThickness="1"
                                        Visibility="{Binding Editor.HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Editor.Errors}" />
                                    </ScrollViewer>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Left"
                                Command="{Binding Editor.RequestArchiveCommand}"
                                Content="Archive entity"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding Editor.CanArchive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button DockPanel.Dock="Left"
                                Margin="8,0,0,0"
                                Command="{Binding Editor.RestoreEntityCommand}"
                                Content="Restore entity"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding Editor.CanRestoreEntity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding Editor.CancelCommand}"
                                    Content="Cancel"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Command="{Binding Editor.SaveCommand}"
                                    Content="{Binding Editor.SaveLabel}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="{Binding Editor.ShowSave, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.RowSpan="3"
                          Panel.ZIndex="10"
                          Background="{StaticResource Brush.Overlay}"
                          FocusManager.IsFocusScope="True"
                          FocusManager.FocusedElement="{Binding ElementName=CancelArchiveButton}"
                          Visibility="{Binding Editor.IsArchiveConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="560"
                                MaxWidth="560"
                                Padding="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource Brush.Surface.Card}"
                                BorderBrush="{StaticResource Brush.Accent}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="Archive entity?" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="{Binding Editor.ArchiveConfirmationMessage}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Text="{Binding Editor.ArchiveErrorMessage}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Editor.HasArchiveError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel Margin="0,20,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <Button x:Name="CancelArchiveButton"
                                            Margin="0,0,8,0"
                                            Command="{Binding Editor.CancelArchiveCommand}"
                                            Content="Cancel — keep entity"
                                            IsDefault="True"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Command="{Binding Editor.ConfirmArchiveCommand}"
                                            Content="Archive entity"
                                            Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
