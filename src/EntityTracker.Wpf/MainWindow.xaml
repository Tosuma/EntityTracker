<Window x:Class="EntityTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:EntityTracker.Domain;assembly=EntityTracker.Domain"
        xmlns:viewModels="clr-namespace:EntityTracker.Wpf.ViewModels"
        xmlns:views="clr-namespace:EntityTracker.Wpf.Views"
        xmlns:services="clr-namespace:EntityTracker.Wpf.Services"
        xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls"
        xmlns:app="clr-namespace:EntityTracker.Wpf"
        Title="EntityTracker"
        Icon="Assets/v2/EntityTracker.ico"
        Width="1240"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource Brush.Surface.Page}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <services:SidebarNotificationHeightConverter x:Key="SidebarNotificationHeightConverter" />
        <!-- One destination. Selected shows a fill and a leading pill; a destination that can't be opened yet
             stays quiet, with its tooltip saying what to select first. -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDark}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface"
                                Background="Transparent"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelectionPill"
                                        Width="3"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Text.OnDark}"
                                        CornerRadius="1.5"
                                        Visibility="Collapsed" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Brand.Green90}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Brand.Green80}" />
                                <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemSurface" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDarkMuted}" />
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The sidebar's lists: no frame or scroll of their own (the sidebar scrolls), one entry per row. -->
        <Style x:Key="SidebarListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type viewModels:ShellNavigationEntry}">
                        <!-- A dot after the label points something out, such as an available update (its
                             tooltip says what). -->
                        <DockPanel LastChildFill="False">
                            <controls:IconLabel IconKey="{Binding IconKey}" Text="{Binding Label}" />
                            <Ellipse x:Name="Badge" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Notification.Success}" Visibility="Collapsed" />
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarItemStyle}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Catalog.IsOpen}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="SidebarRoot" Grid.Column="0"
                  Background="{DynamicResource Brush.Surface.Primary}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPageDialogOpen}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="SidebarNavigation" Grid.Row="0" Margin="18,20,18,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel>
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.OnDark}"
                                   Text="EntityTracker" />
                        <!-- The credit stays quiet: smaller and dimmer than the sidebar's other text. -->
                        <TextBlock x:Name="SidebarCreatorLine"
                                   Margin="0,2,0,22"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                                   Text="{x:Static app:AppCredits.ByLine}"
                                   TextWrapping="Wrap" />

                        <!-- Grouped by section: the top items have no heading, then TRACKER. -->
                        <ListBox x:Name="SidebarList"
                                 AutomationProperties.Name="Main navigation"
                                 ItemsSource="{Binding SidebarGroups}"
                                 SelectedItem="{Binding SelectedSidebarEntry, Mode=TwoWay}"
                                 Style="{StaticResource SidebarListStyle}">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="GroupHeading"
                                                       Margin="8,18,0,4"
                                                       Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                                                       FontWeight="SemiBold"
                                                       AutomationProperties.HeadingLevel="Level2"
                                                       Text="{Binding Name, Converter={x:Static services:UpperCaseConverter.Instance}}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="">
                                                    <Setter TargetName="GroupHeading" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                    <StackPanel x:Name="SidebarUtilities" Grid.Row="1" Margin="18,8,18,12">
                        <TextBlock Margin="8,0,0,4"
                                   Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                                   FontWeight="SemiBold"
                                   Text="UTILITIES" />
                        <ListBox x:Name="UtilityList"
                                 AutomationProperties.Name="Utilities"
                                 ItemsSource="{Binding UtilityItems}"
                                 SelectedItem="{Binding SelectedUtilityEntry, Mode=TwoWay}"
                                 Style="{StaticResource SidebarListStyle}" />
                    </StackPanel>

                <!-- No padding of its own: all spacing lives in each card's container, so the space
                     collapses smoothly with the last card and the utilities glide down. -->
                <Border Grid.Row="2"
                        MaxHeight="{Binding ElementName=SidebarRoot, Path=ActualHeight, Converter={StaticResource SidebarNotificationHeightConverter}}"
                        Background="{DynamicResource Brush.Brand.Green90}"
                        Visibility="{Binding Notifications.HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer x:Name="NotificationScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <ItemsControl ItemsSource="{Binding Notifications.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:NotificationItem}">
                                    <!-- The container collapses its height (spacing included) so the cards below
                                         glide into place; the card inside fades and slides. -->
                                    <Border x:Name="NotificationContainer" Padding="10,6,10,6"
                                            Loaded="OnNotificationLoaded">
                                        <Border.LayoutTransform>
                                            <ScaleTransform ScaleY="1" />
                                        </Border.LayoutTransform>
                                    <!-- Lets the card glide to a new height, e.g. when a sync finishes. -->
                                    <controls:SmoothHeightDecorator x:Name="NotificationResizer">
                                    <Border x:Name="NotificationCard" Padding="10"
                                            CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Brand.Green60}"
                                            Background="{DynamicResource Brush.Brand.Green100}"
                                            AutomationProperties.LiveSetting="Polite">
                                        <Border.RenderTransform>
                                            <TranslateTransform />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Icon Size="18" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                           IconKey="{Binding IconKey}"
                                                           IsSpinning="{Binding IsProgress}"
                                                           AutomationProperties.Name="{Binding Kind}">
                                                <controls:Icon.Style>
                                                    <Style TargetType="controls:Icon">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Notification.Information}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Notification.Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Failure">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Notification.Failure}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="ActionNeeded">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Notification.Action}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:Icon.Style>
                                            </controls:Icon>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Text.OnDark}"
                                                           Text="{Binding Title}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                                                           Text="{Binding Message}" TextWrapping="Wrap" />
                                                <ProgressBar Margin="0,8,0,0" Height="6"
                                                             Background="{DynamicResource Brush.Brand.Green80}"
                                                             Foreground="{DynamicResource Brush.Notification.Information}"
                                                             IsIndeterminate="True"
                                                             Visibility="{Binding IsProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <!-- The notice's own text size, wrapping if needed, so a longer label such
                                                     as "Close without syncing" fits the narrow notification column. -->
                                                <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                                        Padding="8,3" FontSize="12"
                                                        Command="{Binding ActionCommand}"
                                                        IsEnabled="{Binding IsActionEnabled}"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Style="{StaticResource SecondaryButtonStyle}">
                                                    <TextBlock Text="{Binding ActionLabel}" TextWrapping="Wrap" />
                                                </Button>
                                            </StackPanel>
                                            <Button Grid.Column="2" Width="20" Height="20" Padding="0"
                                                    VerticalAlignment="Top"
                                                    Foreground="{DynamicResource Brush.Text.OnDark}"
                                                    Background="Transparent" BorderBrush="Transparent"
                                                    ToolTip="Dismiss notification"
                                                    AutomationProperties.Name="Dismiss notification"
                                                    Command="{Binding DismissCommand}"
                                                    Visibility="{Binding CanDismiss, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <controls:Icon IconKey="Icon.Dismiss" Size="12" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    </controls:SmoothHeightDecorator>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsClosing}" Value="True">
                                            <Setter TargetName="NotificationContainer" Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <!-- While a dialog on the page is open, the sidebar is dimmed like the page and can't be used. -->
                <Border x:Name="SidebarDialogScrim" Grid.RowSpan="3" Panel.ZIndex="24"
                        Background="{DynamicResource Brush.Overlay}"
                        Visibility="{Binding IsPageDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border x:Name="UpdateSidebarBlock" Grid.RowSpan="2" Panel.ZIndex="25"
                        Background="{DynamicResource Brush.Surface.Primary}"
                        Visibility="Collapsed" />
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="MainHeader" Padding="20,12"
                        Background="{DynamicResource Brush.Surface.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPageDialogOpen}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- Compact layout (MainWindow.ArrangeHeader): the context above, the selectors sharing a row. -->
                    <Grid x:Name="HeaderLayout">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="HeaderContext" VerticalAlignment="Center">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="CURRENT CONTEXT" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Text="{Binding ContextSummary}" />
                                <!-- The selected Project's sync state; click to sync, or to open the
                                     Project when it needs attention. -->
                                <Button x:Name="HeaderSyncButton"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding SyncSelectedProjectCommand}"
                                        ToolTip="{Binding SelectedProjectSyncTooltip}"
                                        AutomationProperties.Name="{Binding SelectedProjectSyncTooltip}"
                                        Visibility="{Binding SelectedProjectSyncIndicator.IsShown, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <controls:SyncStatusIcon Size="20"
                                                             Indicator="{Binding SelectedProjectSyncIndicator}"
                                                             IsHitTestVisible="False" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="ProjectSelectorPanel" Grid.Column="1">
                            <Label x:Name="ProjectSelectorLabel" Content="Project" />
                            <ComboBox x:Name="ProjectSelector"
                                      AutomationProperties.LabeledBy="{Binding ElementName=ProjectSelectorLabel}"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding Projects}"
                                      SelectedItem="{Binding SelectedProject, Mode=OneWay}"
                                      SelectionChanged="OnProjectSelectionChanged" />
                        </StackPanel>
                        <StackPanel x:Name="TrackerSelectorPanel" Grid.Column="3">
                            <Label x:Name="TrackerSelectorLabel" Content="Tracker" />
                            <ComboBox x:Name="TrackerSelector"
                                      AutomationProperties.LabeledBy="{Binding ElementName=TrackerSelectorLabel}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding HasProject}"
                                      ItemsSource="{Binding Trackers}"
                                      SelectedItem="{Binding SelectedTracker, Mode=OneWay}"
                                      SelectionChanged="OnTrackerSelectionChanged" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="HeaderDialogScrim" Grid.RowSpan="2" Panel.ZIndex="24"
                        Background="{DynamicResource Brush.Overlay}"
                        Visibility="{Binding IsPageDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border x:Name="DefaultPrompt" Grid.Row="1"
                        Margin="18,12,18,0"
                        Padding="12"
                        Background="{DynamicResource Brush.Surface.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding ShowDefaultNamePrompt, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                Click="OnDismissDefaultNamePrompt"
                                Content="Not now"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button DockPanel.Dock="Right"
                                Click="OnRenameDefaultName"
                                Content="{Binding DefaultNamePromptActionLabel}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding DefaultNamePromptMessage}"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <Grid x:Name="WorkspaceArea" Grid.Row="2" Margin="18">
                    <views:PortfolioView Visibility="{Binding IsPortfolio, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:ProjectDashboardView Visibility="{Binding IsProjectDashboard, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:ProjectDevelopersView Visibility="{Binding IsDevelopers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:ProjectReportView Visibility="{Binding IsProjectReport, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:TrackerWorkspaceView x:Name="WorkspaceView"
                                                DataContext="{Binding CurrentWorkspace}"
                                                Visibility="{Binding DataContext.IsTrackerWorkspace, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:HelpView Visibility="{Binding IsHelp, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <!-- A page dialog dims its page; this dims the margin around the page, which would otherwise
                     show as an undimmed frame between the dimmed header, sidebar and page. -->
                <Border x:Name="WorkspaceMarginDialogScrim" Grid.Row="2" Panel.ZIndex="24"
                        BorderBrush="{DynamicResource Brush.Overlay}"
                        BorderThickness="{Binding Margin, ElementName=WorkspaceArea}"
                        Visibility="{Binding IsPageDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border x:Name="BusyFooter" Grid.Row="3"
                        Padding="12,8"
                        Background="{DynamicResource Brush.Surface.Subtle}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Width="100" Height="5" IsIndeterminate="True" />
                        <TextBlock Margin="12,0,0,0" Text="{Binding BusyMessage}" />
                    </StackPanel>
                </Border>
                <Border x:Name="UpdateBlock" Grid.RowSpan="4" Panel.ZIndex="25"
                        Background="{DynamicResource Brush.Surface.Page}"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="420">
                        <TextBlock FontSize="26" FontWeight="SemiBold"
                                   Text="EntityTracker update required" />
                        <TextBlock x:Name="UpdateBlockMessage" Margin="0,14,0,20"
                                   TextWrapping="Wrap" />
                        <!-- What the required update brings. -->
                        <StackPanel x:Name="UpdateBlockWhatsNew" Margin="0,0,0,20" DataContext="{Binding WhatsNew}"
                                    Visibility="{Binding HasEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontWeight="SemiBold" FontSize="16" Text="{Binding Heading}" />
                            <ScrollViewer Margin="0,8,0,0" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                          AutomationProperties.Name="{Binding Heading}">
                                <ItemsControl Margin="0,0,14,0" ItemsSource="{Binding Entries}"
                                              ItemTemplate="{StaticResource ReleaseNoteTemplate}" />
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UpdateActionButton" Padding="18,8"
                                    Content="Close and update"
                                    Click="OnUpdateClick"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <!-- If the update can't start, the log says why. -->
                            <Button Margin="8,0,0,0" Padding="18,8"
                                    Content="Open log folder"
                                    Command="{Binding Diagnostics.OpenLogFolderCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <views:CatalogModalView Panel.ZIndex="20"
                                DataContext="{Binding Catalog}"
                                Visibility="{Binding DataContext.Catalog.IsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Window>
