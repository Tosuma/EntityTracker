<Window x:Class="EntityTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:reporting="clr-namespace:EntityTracker.Reporting;assembly=EntityTracker.Reporting"
        xmlns:viewModels="clr-namespace:EntityTracker.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="EntityTracker"
        Width="1120"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        Background="#F4F6F8"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Background" Value="#176B87" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#26343D" />
            <Setter Property="BorderBrush" Value="#C7D0D6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Background" Value="#B42318" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE3E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <Style x:Key="SummaryFilterButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE3E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#75A9BA" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#176B87" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Card" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EAED" />
            <Setter Property="BorderBrush" Value="#D7DEE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <EventSetter Event="PreviewMouseWheel" Handler="OnDataGridPreviewMouseWheel" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Editor.CancelCommand}" />
    </Window.InputBindings>

    <Grid>
    <DockPanel>
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <Setter Property="IsEnabled" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Editor.IsOpen}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>
        <Border DockPanel.Dock="Top"
                Padding="26,18"
                Background="#163A4A">
            <StackPanel>
                <TextBlock Foreground="White"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Text="EntityTracker" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#C9DCE4"
                           Text="Dependency-safe implementation overview" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="18,10"
                Background="#E2EFF4"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="110"
                             Height="5"
                             Margin="0,0,12,0"
                             IsIndeterminate="True" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="#31505D"
                           Text="{Binding BusyMessage}" />
            </StackPanel>
        </Border>

        <TabControl Margin="18"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Overview">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       Foreground="#64737C"
                                       Text="View" />
                            <ComboBox MinWidth="155"
                                      Margin="0,0,8,0"
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding OverviewFilters}"
                                      SelectedValue="{Binding SelectedOverviewFilter}"
                                      SelectedValuePath="Value" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding OpenOverviewSearchCommand}"
                                    Click="OnOpenOverviewSearchClick"
                                    Content="Search"
                                    ToolTip="Search entities (Ctrl+F)"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Command="{Binding RefreshCommand}"
                                    Content="Refresh"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#26343D"
                                       Text="Persisted entities" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64737C"
                                       Text="Ranked entities are ordered so dependencies appear before the entities that use them." />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">

                        <Button AutomationProperties.Name="Show all active entities"
                                Command="{Binding SelectOverviewFilterCommand}"
                                CommandParameter="{x:Static viewModels:OverviewManagerFilter.AllActive}"
                                ToolTip="Show all active entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOverviewFilter}"
                                                     Value="{x:Static viewModels:OverviewManagerFilter.AllActive}">
                                            <Setter Property="Background" Value="#EAF4F7" />
                                            <Setter Property="BorderBrush" Value="#176B87" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="#6B7880" Text="Total" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding TotalEntityCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Show not started entities"
                                Command="{Binding SelectOverviewFilterCommand}"
                                CommandParameter="{x:Static viewModels:OverviewManagerFilter.NotStarted}"
                                ToolTip="Show not started entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOverviewFilter}"
                                                     Value="{x:Static viewModels:OverviewManagerFilter.NotStarted}">
                                            <Setter Property="Background" Value="#EAF4F7" />
                                            <Setter Property="BorderBrush" Value="#176B87" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="#6B7880" Text="Not started" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding NotStartedCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Show in progress entities"
                                Command="{Binding SelectOverviewFilterCommand}"
                                CommandParameter="{x:Static viewModels:OverviewManagerFilter.InProgress}"
                                ToolTip="Show in progress entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOverviewFilter}"
                                                     Value="{x:Static viewModels:OverviewManagerFilter.InProgress}">
                                            <Setter Property="Background" Value="#EAF4F7" />
                                            <Setter Property="BorderBrush" Value="#176B87" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="#6B7880" Text="In progress" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding InProgressCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Show rework needed entities"
                                Command="{Binding SelectOverviewFilterCommand}"
                                CommandParameter="{x:Static viewModels:OverviewManagerFilter.ReworkNeeded}"
                                ToolTip="Show rework needed entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOverviewFilter}"
                                                     Value="{x:Static viewModels:OverviewManagerFilter.ReworkNeeded}">
                                            <Setter Property="Background" Value="#EAF4F7" />
                                            <Setter Property="BorderBrush" Value="#176B87" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="#6B7880" Text="Rework needed" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#B45309"
                                           Text="{Binding ReworkNeededCount}" />
                            </StackPanel>
                        </Button>

                        <Button AutomationProperties.Name="Show development completed entities"
                                Command="{Binding SelectOverviewFilterCommand}"
                                CommandParameter="{x:Static viewModels:OverviewManagerFilter.DevelopmentCompleted}"
                                ToolTip="Show development completed entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOverviewFilter}"
                                                     Value="{x:Static viewModels:OverviewManagerFilter.DevelopmentCompleted}">
                                            <Setter Property="Background" Value="#EAF4F7" />
                                            <Setter Property="BorderBrush" Value="#176B87" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="#6B7880" Text="Dev. completed" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding DevelopmentCompletedCount}" />
                            </StackPanel>
                        </Button>

                        <Button AutomationProperties.Name="Show reconciled entities"
                                Command="{Binding SelectOverviewFilterCommand}"
                                CommandParameter="{x:Static viewModels:OverviewManagerFilter.Reconciled}"
                                ToolTip="Show reconciled entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOverviewFilter}"
                                                     Value="{x:Static viewModels:OverviewManagerFilter.Reconciled}">
                                            <Setter Property="Background" Value="#EAF4F7" />
                                            <Setter Property="BorderBrush" Value="#176B87" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="#6B7880" Text="Reconciled" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ReconciledCount}" />
                            </StackPanel>
                        </Button>

                        <Border Margin="0,0,0,8"
                                Style="{StaticResource SummaryCardStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="#6B7880"
                                           Text="{Binding ImplementedPercentage, StringFormat={}{0:F0}% implemented}" />
                                <Grid Height="10" Margin="0,9,0,0">
                                    <ProgressBar Foreground="#2563EB"
                                                 Maximum="100"
                                                 Value="{Binding ImplementedPercentage, Mode=OneWay}" />
                                    <ProgressBar Background="Transparent"
                                                 Foreground="#D97706"
                                                 Maximum="100"
                                                 Value="{Binding ReconciledAndReworkPercentage, Mode=OneWay}" />
                                    <ProgressBar Background="Transparent"
                                                 Foreground="#2E8B57"
                                                 Maximum="100"
                                                 Value="{Binding ReconciledPercentage, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="11"
                                           Foreground="#52616A"
                                           Text="Blue: dev. completed · Amber: rework · Green: reconciled" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <Border Grid.Row="2"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="White"
                            BorderBrush="#B7CAD3"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding IsOverviewSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="OverviewSearchTextBox"
                                     MinWidth="280"
                                     Padding="9,7"
                                     ToolTip="Search active entities"
                                     Text="{Binding OverviewSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearOverviewSearchCommand}"
                                    Content="Clear"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Command="{Binding CloseOverviewSearchCommand}"
                                    Content="Close search"
                                    Style="{StaticResource SecondaryButtonStyle}" />

                            <CheckBox Grid.Row="1"
                                      Margin="0,9,0,0"
                                      VerticalAlignment="Center"
                                      Content="Search dependency names"
                                      IsEnabled="{Binding CanSearchOverviewDependencies}"
                                      IsChecked="{Binding SearchOverviewDependencies}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Margin="12,9,0,0"
                                       HorizontalAlignment="Right"
                                       Foreground="#64737C"
                                       Text="{Binding OverviewSearchResultSummary}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,0,0,12"
                            MaxHeight="120"
                            Padding="12"
                            Background="#FDEAEA"
                            BorderBrush="#E6A6A6"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding HasOverviewError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock Foreground="#8A2D2D"
                                       Text="{Binding OverviewErrorMessage}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="4">
                        <DataGrid ItemsSource="{Binding OverviewItems}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="70" Binding="{Binding Rank}" Header="Rank" />
                                <DataGridTemplateColumn Width="2.2*" Header="Entity">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding SourceName}" />
                                                <Button Width="24"
                                                        Height="24"
                                                        Margin="6,0,0,0"
                                                        Padding="2"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding GraphIssueTitle}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding GraphIssueTitle}"
                                                        Visibility="{Binding HasGraphIssue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Click="OnContextMenuButtonClick">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Foreground" Value="#B45309" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDirectlyUnresolved}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C62828" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Viewbox Width="18"
                                                             Height="18"
                                                             IsHitTestVisible="False">
                                                        <Canvas Width="24" Height="24">
                                                            <Ellipse Width="20"
                                                                     Height="20"
                                                                     Canvas.Left="2"
                                                                     Canvas.Top="2"
                                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                     StrokeThickness="2" />
                                                            <Path Data="M12,6 L12,14"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeThickness="2" />
                                                            <Ellipse Width="2.5"
                                                                     Height="2.5"
                                                                     Canvas.Left="10.75"
                                                                     Canvas.Top="17"
                                                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Focusable="False" IsHitTestVisible="False">
                                                                <MenuItem.Template>
                                                                    <ControlTemplate TargetType="MenuItem">
                                                                        <ContentPresenter ContentSource="Header" />
                                                                    </ControlTemplate>
                                                                </MenuItem.Template>
                                                                <MenuItem.Header>
                                                                    <StackPanel Width="320" Margin="12">
                                                                        <TextBlock FontSize="15"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#263238"
                                                                                   Text="{Binding GraphIssueTitle}" />
                                                                        <TextBlock Margin="0,8,0,0"
                                                                                   Foreground="#455A64"
                                                                                   Text="{Binding GraphIssueDescription}"
                                                                                   TextWrapping="Wrap" />
                                                                        <TextBlock Margin="0,10,0,0"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#263238"
                                                                                   Text="{Binding GraphIssueNames}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </MenuItem.Header>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="125" Binding="{Binding Provenance}" Header="Source" />
                                <DataGridTextColumn Width="130" Binding="{Binding Status}" Header="Status" />
                                <DataGridTextColumn Width="130" Binding="{Binding WorkStatus}" Header="Work status" />
                                <DataGridTextColumn Width="105" Binding="{Binding DependencyCount}" Header="Dependencies" />
                                <DataGridTextColumn Width="2.2*" Binding="{Binding MissingDependencies}" Header="Missing Dependencies" />
                                <DataGridTextColumn Width="2*" Binding="{Binding Notes}" Header="Notes" />
                                <DataGridTemplateColumn Width="52" Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="30"
                                                    Height="28"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Content="⋮"
                                                    Cursor="Hand"
                                                    FontSize="19"
                                                    ToolTip="Entity actions"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="OnContextMenuButtonClick">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{Binding PlacementTarget.DataContext.ActionLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Command="{Binding PlacementTarget.Tag.EditOverviewEntityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#F8FAFB"
                                BorderBrush="#D7DEE2"
                                BorderThickness="1"
                                Visibility="{Binding ShowOverviewEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#4E5E67"
                                           Text="{Binding OverviewEmptyTitle}" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="#74828A"
                                           Text="{Binding OverviewEmptyDescription}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFB"
                                BorderBrush="#D7DEE2"
                                BorderThickness="1"
                                Visibility="{Binding ShowOverviewSearchEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#4E5E67"
                                           Text="No matching entities" />
                                <TextBlock Margin="0,7,0,12"
                                           Foreground="#74828A"
                                           Text="Try another name, change the dependency toggle, or clear the search."
                                           TextWrapping="Wrap" />
                                <Button Command="{Binding ClearOverviewSearchCommand}"
                                        Content="Clear search"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Schema Synchronization">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ImportCsvCommand}"
                                Content="Choose CSV and Review"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#26343D"
                                       Text="Schema synchronization" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64737C"
                                       Text="{Binding Review.SelectedFileName}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="White"
                            BorderBrush="#D7DEE2"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Import type" />
                            <RadioButton Margin="0,8,0,0"
                                         GroupName="ImportMode"
                                         IsEnabled="{Binding Review.CanSelectImportMode}"
                                         IsChecked="{Binding Review.IsCompleteImport}"
                                         Content="Complete database snapshot (default)" />
                            <TextBlock Margin="22,2,0,0"
                                       Foreground="#64737C"
                                       Text="The CSV contains the entire schema. Existing entities missing from the file will be archived." />
                            <RadioButton Margin="0,9,0,0"
                                         GroupName="ImportMode"
                                         IsEnabled="{Binding Review.CanSelectImportMode}"
                                         IsChecked="{Binding Review.IsPartialImport}"
                                         Content="Partial database snapshot" />
                            <TextBlock Margin="22,2,0,0"
                                       Foreground="#64737C"
                                       Text="The CSV contains only part of the schema. Existing entities missing from the file will be left unchanged." />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="#7A5A00"
                                       FontWeight="SemiBold"
                                       Text="Import type is locked for while reviewing. Cancel the review to choose a different type."
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Review.HasReview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnReviewPreviewMouseWheel"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Margin="0,0,0,8"
                                        MaxHeight="120"
                                        Padding="10"
                                        Background="#FFF8DC"
                                        BorderBrush="#E5D28B"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding Review.HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Review.Warnings}" />
                                    </ScrollViewer>
                                </Border>

                                <Border Margin="0,0,0,8"
                                        MaxHeight="120"
                                        Padding="10"
                                        Background="#FDEAEA"
                                        BorderBrush="#E6A6A6"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding Review.HasDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Review.Diagnostics}" />
                                    </ScrollViewer>
                                </Border>

                                <StackPanel Visibility="{Binding Review.HasReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Margin="0,0,0,10"
                                               FontWeight="SemiBold"
                                               Text="{Binding Review.ImportModeLabel, StringFormat=Import mode: {0}}" />

                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasNewEntities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#176B87" Text="New entities" />
                                        <ItemsControl ItemsSource="{Binding Review.NewEntities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0" Padding="10" Background="White" BorderBrush="#D7DEE2" BorderThickness="1">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right"
                                                                        Width="30"
                                                                        Height="28"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Content="⋮"
                                                                        Cursor="Hand"
                                                                        FontSize="19"
                                                                        ToolTip="Entity actions"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Click="OnContextMenuButtonClick">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Edit dependencies"
                                                                                      Command="{Binding PlacementTarget.Tag.EditReviewEntityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SourceName, StringFormat=+ {0}}" />
                                                            </DockPanel>
                                                            <TextBlock Margin="16,3,0,0" Foreground="#52616A" Text="{Binding Details}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasChangedEntities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#7A5A00" Text="Changed entities" />
                                        <ItemsControl ItemsSource="{Binding Review.ChangedEntities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0" Padding="10" Background="White" BorderBrush="#D7DEE2" BorderThickness="1">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right"
                                                                        Width="30"
                                                                        Height="28"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Content="⋮"
                                                                        Cursor="Hand"
                                                                        FontSize="19"
                                                                        ToolTip="Entity actions"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Click="OnContextMenuButtonClick">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Edit dependencies"
                                                                                      Command="{Binding PlacementTarget.Tag.EditReviewEntityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SourceName, StringFormat=~ {0}}" />
                                                            </DockPanel>
                                                            <TextBlock Margin="16,3,0,0" Foreground="#52616A" Text="{Binding Details}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasMissingEntities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#9A3030" Text="Missing / possibly removed" />
                                        <ItemsControl ItemsSource="{Binding Review.MissingEntities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0" Padding="10" Background="#FFF2F2" BorderBrush="#E6A6A6" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding SourceName, StringFormat=− {0}}" />
                                                            <TextBlock Margin="16,3,0,0" Foreground="#7C4545" Text="{Binding Details}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasManualOnlyEntities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#176B87"
                                                   Text="Manual entities not yet in CSV — kept active" />
                                        <ItemsControl ItemsSource="{Binding Review.ManualOnlyEntities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0"
                                                            Padding="10"
                                                            Background="#EAF5FA"
                                                            BorderBrush="#A9CDD9"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Text="{Binding SourceName, StringFormat=• {0}}" />
                                                            <TextBlock Margin="16,3,0,0"
                                                                       Foreground="#315B6B"
                                                                       Text="{Binding Details}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasUnresolvedEntities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#9A5B1B" Text="Unresolved dependencies" />
                                        <ItemsControl ItemsSource="{Binding Review.UnresolvedEntities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0" Padding="10" Background="#FFF8DC" BorderBrush="#E5D28B" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding SourceName, StringFormat=! {0}}" />
                                                            <TextBlock Margin="16,3,0,0" Foreground="#6E5A18" Text="{Binding Details}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding Review.HasProgressImpacts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#B45309"
                                                   Text="Completed entities with dependency changes" />
                                        <TextBlock Margin="0,3,0,4"
                                                   Foreground="#64737C"
                                                   Text="Choose whether each entity keeps its current status or needs rework before applying."
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Review.ProgressImpacts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,5,0,0"
                                                            Padding="10"
                                                            Background="#FFF8DC"
                                                            BorderBrush="#E5D28B"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           Foreground="#6E5A18"
                                                                           Text="{Binding CurrentStatus, StringFormat=Current: {0}}" />
                                                                <TextBlock Margin="0,3,0,0"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#8A4B08"
                                                                           Text="{Binding DecisionText}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1"
                                                                        Margin="12,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Orientation="Horizontal">
                                                                <Button Margin="0,0,8,0"
                                                                        Command="{Binding DataContext.KeepSynchronizationStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="Keep current status"
                                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                                <Button Command="{Binding DataContext.MarkSynchronizationReworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="Mark Rework needed"
                                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Padding="10" Background="#EDF6EF" BorderBrush="#BFD8C4" BorderThickness="1">
                                        <TextBlock Foreground="#365D3D"
                                                   Text="{Binding Review.UnchangedEntityCount, StringFormat=✓ {0} imported entities unchanged}" />
                                    </Border>
                                </StackPanel>

                                <Border Padding="20"
                                        Background="#F8FAFB"
                                        BorderBrush="#D7DEE2"
                                        BorderThickness="1"
                                        Visibility="{Binding Review.ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="#65747C"
                                               Text="Choose an import type, then select a CSV to create a review. Nothing is saved until Apply Changes." />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding Review.HasReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Margin="0,0,8,0"
                                Command="{Binding CancelSynchronizationCommand}"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Command="{Binding ApplySynchronizationCommand}"
                                Content="Apply Changes"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Add Entity">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#26343D"
                                   Text="Create a tracked entity" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#64737C"
                                   Text="Add a new entity and its initial mandatory dependencies. Unknown names are kept as unresolved warnings."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnReviewPreviewMouseWheel"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock FontWeight="SemiBold" Text="Entity name" />
                            <TextBox Margin="0,6,0,18"
                                     MinWidth="420"
                                     Padding="9,7"
                                     Text="{Binding ManualCreation.EntityName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock FontWeight="SemiBold" Text="Add dependencies" />
                            <TextBlock Margin="0,3,0,7"
                                       Foreground="#64737C"
                                       Text="Search active entities, or deliberately keep an unknown name as unresolved."
                                       TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox MinWidth="420"
                                         Padding="9,7"
                                         Text="{Binding ManualCreation.DependencyQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding ManualCreation.AddUnresolvedCommand}"
                                        Content="Add as unresolved"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <TextBlock Margin="0,7,0,0"
                                       Foreground="#7A5A00"
                                       Text="{Binding ManualCreation.SearchMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ManualCreation.HasSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <ItemsControl Margin="0,6,0,0"
                                          ItemsSource="{Binding ManualCreation.Suggestions}"
                                          Visibility="{Binding ManualCreation.HasSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,5"
                                                Padding="8"
                                                Background="White"
                                                BorderBrush="#D7DEE2"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Padding="12,5"
                                                        Command="{Binding DataContext.ManualCreation.AddExistingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Add"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding SourceName}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,18,0,7"
                                       FontWeight="SemiBold"
                                       Text="Selected dependencies" />
                            <ItemsControl ItemsSource="{Binding ManualCreation.SelectedDependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="9"
                                                Background="White"
                                                BorderBrush="#D7DEE2"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Padding="12,5"
                                                        Command="{Binding DataContext.ManualCreation.RemoveDependencyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Remove"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Foreground="#64737C"
                                                               Text="{Binding ResolutionLabel}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,12,0,0"
                                    MaxHeight="110"
                                    Padding="10"
                                    Background="#FFF8DC"
                                    BorderBrush="#E5D28B"
                                    BorderThickness="1"
                                    Visibility="{Binding ManualCreation.HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ManualCreation.Warnings}" />
                                </ScrollViewer>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="10"
                                    Background="#FFF4E5"
                                    BorderBrush="#D99A4E"
                                    BorderThickness="1"
                                    Visibility="{Binding ManualCreation.HasArchivedEntityMatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Margin="12,0,0,0"
                                            Command="{Binding ManualCreation.RestoreArchivedCommand}"
                                            Content="Restore existing entity"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="#69420E"
                                               Text="{Binding ManualCreation.ArchivedEntityMessage}"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    MaxHeight="110"
                                    Padding="10"
                                    Background="#FDEAEA"
                                    BorderBrush="#E6A6A6"
                                    BorderThickness="1"
                                    Visibility="{Binding ManualCreation.HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ManualCreation.Errors}" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Margin="0,12,0,0"
                                       Foreground="#31505D"
                                       Text="{Binding ManualCreation.OperationMessage}"
                                       Visibility="{Binding ManualCreation.HasOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Command="{Binding ManualCreation.CancelCommand}"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Command="{Binding ManualCreation.CreateCommand}"
                                Content="Create Entity"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Progress">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnReviewPreviewMouseWheel"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           Foreground="#64737C"
                                           Text="History" />
                                <ComboBox MinWidth="145"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding Progress.RangeOptions}"
                                          SelectedValue="{Binding Progress.SelectedRange}"
                                          SelectedValuePath="Value" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#26343D"
                                           Text="Progress history" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="#64737C"
                                           Text="Current work status and persisted implementation/readiness trends." />
                            </StackPanel>
                        </DockPanel>

                        <Border Margin="0,0,0,12"
                                Padding="12"
                                Background="White"
                                BorderBrush="#D7DEE2"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding Progress.IsCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Text="From" />
                                    <DatePicker Width="145" SelectedDate="{Binding Progress.CustomFrom}" />
                                    <TextBlock Margin="14,0,7,0" VerticalAlignment="Center" Text="To" />
                                    <DatePicker Width="145" SelectedDate="{Binding Progress.CustomTo}" />
                                    <Button Margin="12,0,0,0"
                                            Command="{Binding Progress.ApplyRangeCommand}"
                                            Content="Apply range"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="#9A3030"
                                           Text="{Binding Progress.RangeValidationMessage}"
                                           Visibility="{Binding Progress.HasRangeValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,12"
                                MaxHeight="100"
                                Padding="10"
                                Background="#FDEAEA"
                                BorderBrush="#E6A6A6"
                                BorderThickness="1"
                                Visibility="{Binding Progress.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Foreground="#8A2D2D"
                                           Text="{Binding Progress.ErrorMessage}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <Border Margin="0,0,0,12"
                                MaxHeight="100"
                                Padding="10"
                                Background="#EAF6EE"
                                BorderBrush="#A9D5B8"
                                BorderThickness="1"
                                Visibility="{Binding Progress.HasExportMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Foreground="#24613A"
                                           Text="{Binding Progress.ExportMessage}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <Border Margin="0,0,0,12"
                                Padding="14,12"
                                Background="White"
                                BorderBrush="#D7DEE2"
                                BorderThickness="1"
                                CornerRadius="5"
                                Visibility="{Binding Progress.HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Right"
                                               VerticalAlignment="Center"
                                               Foreground="#64737C"
                                               Text="{Binding Progress.ManagerDateSummary}" />
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="Manager summary" />
                                </DockPanel>
                                <UniformGrid Columns="5">
                                    <StackPanel>
                                        <TextBlock Foreground="#64737C" Text="Active" />
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Progress.ManagerSummary.ActiveEntityCount}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Foreground="#64737C" Text="Implemented" />
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Progress.ManagerSummary.ImplementedEntityCount}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Foreground="#64737C" Text="Reconciled" />
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Progress.ManagerSummary.ReconciledEntityCount}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Foreground="#64737C" Text="Ready" />
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Progress.ManagerSummary.ReadyEntityCount}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Foreground="#64737C" Text="Blocked" />
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#B42318" Text="{Binding Progress.ManagerSummary.BlockedEntityCount}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,8"
                                   HorizontalAlignment="Center"
                                   Foreground="#64737C"
                                   Text="No persisted progress history is available in this range."
                                   Visibility="{Binding Progress.ShowNoHistoricalData, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <UniformGrid Columns="2">
                            <Border Height="290" Margin="0,0,6,12" Padding="12" Background="White" BorderBrush="#D7DEE2" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Entities by current work status" />
                                        <Button Grid.Column="1" Margin="8,0,5,0" Padding="10,5"
                                                Command="{Binding Progress.SaveChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.CurrentStatus}"
                                                Content="Save PNG" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Save a report-ready PNG" />
                                        <Button Grid.Column="2" Padding="10,5"
                                                Command="{Binding Progress.CopyChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.CurrentStatus}"
                                                Content="Copy" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Copy a report-ready PNG to the clipboard" />
                                    </Grid>
                                    <lvc:PieChart Grid.Row="1"
                                                  LegendPosition="Right"
                                                  Series="{Binding Progress.CurrentStatusSeries}" />
                                </Grid>
                            </Border>
                            <Border Height="290" Margin="6,0,0,12" Padding="12" Background="White" BorderBrush="#D7DEE2" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Implemented entities over time" />
                                        <Button Grid.Column="1" Margin="8,0,5,0" Padding="10,5"
                                                Command="{Binding Progress.SaveChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.ImplementedOverTime}"
                                                Content="Save PNG" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Save a report-ready PNG" />
                                        <Button Grid.Column="2" Padding="10,5"
                                                Command="{Binding Progress.CopyChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.ImplementedOverTime}"
                                                Content="Copy" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Copy a report-ready PNG to the clipboard" />
                                    </Grid>
                                    <lvc:CartesianChart Grid.Row="1"
                                                        LegendPosition="Top"
                                                        Series="{Binding Progress.ImplementedSeries}"
                                                        TooltipPosition="Top"
                                                        XAxes="{Binding Progress.ImplementedXAxes}"
                                                        YAxes="{Binding Progress.CountYAxes}" />
                                </Grid>
                            </Border>
                            <Border Height="290" Margin="0,0,6,0" Padding="12" Background="White" BorderBrush="#D7DEE2" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Ready vs blocked over time" />
                                        <Button Grid.Column="1" Margin="8,0,5,0" Padding="10,5"
                                                Command="{Binding Progress.SaveChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.ReadyAndBlockedOverTime}"
                                                Content="Save PNG" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Save a report-ready PNG" />
                                        <Button Grid.Column="2" Padding="10,5"
                                                Command="{Binding Progress.CopyChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.ReadyAndBlockedOverTime}"
                                                Content="Copy" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Copy a report-ready PNG to the clipboard" />
                                    </Grid>
                                    <lvc:CartesianChart Grid.Row="1"
                                                        LegendPosition="Top"
                                                        Series="{Binding Progress.ReadinessSeries}"
                                                        TooltipPosition="Top"
                                                        XAxes="{Binding Progress.ReadinessXAxes}"
                                                        YAxes="{Binding Progress.CountYAxes}" />
                                </Grid>
                            </Border>
                            <Border Height="290" Margin="6,0,0,0" Padding="12" Background="White" BorderBrush="#D7DEE2" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Weekly net implemented change" />
                                        <Button Grid.Column="1" Margin="8,0,5,0" Padding="10,5"
                                                Command="{Binding Progress.SaveChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.WeeklyNetImplementedChange}"
                                                Content="Save PNG" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Save a report-ready PNG" />
                                        <Button Grid.Column="2" Padding="10,5"
                                                Command="{Binding Progress.CopyChartCommand}"
                                                CommandParameter="{x:Static reporting:ProgressChartKind.WeeklyNetImplementedChange}"
                                                Content="Copy" Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Copy a report-ready PNG to the clipboard" />
                                    </Grid>
                                    <lvc:CartesianChart Grid.Row="1"
                                                        LegendPosition="Top"
                                                        Series="{Binding Progress.WeeklySeries}"
                                                        TooltipPosition="Top"
                                                        XAxes="{Binding Progress.WeeklyXAxes}"
                                                        YAxes="{Binding Progress.SignedYAxes}" />
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>

        <Grid Panel.ZIndex="100"
              Background="#99000000"
              Visibility="{Binding Editor.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MinWidth="700"
                    MaxWidth="900"
                    MaxHeight="660"
                    Margin="30"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#C7D0D6"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#26343D"
                                   Text="{Binding Editor.ContextTitle}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#64737C"
                                   Text="{Binding Editor.ContextDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnReviewPreviewMouseWheel"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="{Binding Editor.SelectedEntityName}" />
                            <TextBlock Margin="0,3,0,16"
                                       Foreground="#64737C"
                                       Text="{Binding Editor.EntityDetails}" />
                            <StackPanel Visibility="{Binding Editor.HasSelectedEntity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock FontWeight="SemiBold" Text="Development status" />
                                        <ComboBox Margin="0,5,0,0"
                                                  DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding Editor.CanEditProgress}"
                                                  ItemsSource="{Binding Editor.StatusOptions}"
                                                  SelectedValue="{Binding Editor.SelectedStatus}"
                                                  SelectedValuePath="Value" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="Notes" />
                                        <TextBox MinHeight="64"
                                                 Margin="0,5,0,0"
                                                 Padding="8"
                                                 AcceptsReturn="True"
                                                 IsEnabled="{Binding Editor.CanEditProgress}"
                                                 Text="{Binding Editor.EditedNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Visibility="{Binding Editor.ShowDependencyEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontWeight="SemiBold" Text="Add a manual dependency" />
                                <TextBlock Margin="0,3,0,7"
                                           Foreground="#64737C"
                                           Text="Search active entities, or deliberately retain an unknown name as unresolved."
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox MinWidth="420"
                                             Padding="9,7"
                                             Text="{Binding Editor.DependencyQuery, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding Editor.AddUnresolvedCommand}"
                                            Content="Add as unresolved"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>

                                <TextBlock Margin="0,7,0,0"
                                           Foreground="#7A5A00"
                                           Text="{Binding Editor.SearchMessage}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Editor.HasSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <ItemsControl Margin="0,6,0,0"
                                              ItemsSource="{Binding Editor.Suggestions}"
                                              Visibility="{Binding Editor.HasSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,5" Padding="8" Background="White" BorderBrush="#D7DEE2" BorderThickness="1">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.Editor.AddExistingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Add"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding SourceName}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>

                                <TextBlock Margin="0,18,0,7" FontWeight="SemiBold" Text="Dependencies and overrides" />
                                <ItemsControl ItemsSource="{Binding Editor.Dependencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="9" Background="White" BorderBrush="#D7DEE2" BorderThickness="1">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding DataContext.Editor.ShowDependencyEditor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button Margin="6,0,0,0"
                                                                Command="{Binding DataContext.Editor.SuppressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Suppress imported"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Visibility="{Binding CanSuppress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <Button Margin="6,0,0,0"
                                                                Command="{Binding DataContext.Editor.RemoveManualCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Remove manual addition"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Visibility="{Binding CanRemoveManual, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <Button Margin="6,0,0,0"
                                                                Command="{Binding DataContext.Editor.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Restore imported"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Visibility="{Binding CanRestore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                        <TextBlock Margin="0,2,0,0" Foreground="#52616A" Text="{Binding Origin}" />
                                                        <TextBlock Margin="0,2,0,0" Foreground="#64737C" Text="{Binding Resolution}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Margin="0,12,0,0"
                                        MaxHeight="110"
                                        Padding="10"
                                        Background="#FFF8DC"
                                        BorderBrush="#E5D28B"
                                        BorderThickness="1"
                                        Visibility="{Binding Editor.HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Editor.Warnings}" />
                                    </ScrollViewer>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        MaxHeight="110"
                                        Padding="10"
                                        Background="#FDEAEA"
                                        BorderBrush="#E6A6A6"
                                        BorderThickness="1"
                                        Visibility="{Binding Editor.HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Editor.Errors}" />
                                    </ScrollViewer>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Left"
                                Command="{Binding Editor.RequestArchiveCommand}"
                                Content="Archive entity"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding Editor.CanArchive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button DockPanel.Dock="Left"
                                Margin="8,0,0,0"
                                Command="{Binding Editor.RestoreEntityCommand}"
                                Content="Restore entity"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding Editor.CanRestoreEntity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding Editor.CancelCommand}"
                                    Content="Cancel"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Command="{Binding Editor.SaveCommand}"
                                    Content="{Binding Editor.SaveLabel}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="{Binding Editor.ShowSave, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.RowSpan="3"
                          Panel.ZIndex="10"
                          Background="#99000000"
                          FocusManager.IsFocusScope="True"
                          FocusManager.FocusedElement="{Binding ElementName=CancelArchiveButton}"
                          Visibility="{Binding Editor.IsArchiveConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="560"
                                MaxWidth="560"
                                Padding="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                BorderBrush="#D5A19D"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#8F1D16"
                                           Text="Archive entity?" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="#37464F"
                                           Text="{Binding Editor.ArchiveConfirmationMessage}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="#8A2D2D"
                                           Text="{Binding Editor.ArchiveErrorMessage}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Editor.HasArchiveError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel Margin="0,20,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <Button x:Name="CancelArchiveButton"
                                            Margin="0,0,8,0"
                                            Command="{Binding Editor.CancelArchiveCommand}"
                                            Content="Cancel — keep entity"
                                            IsDefault="True"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Command="{Binding Editor.ConfirmArchiveCommand}"
                                            Content="Archive entity"
                                            Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
