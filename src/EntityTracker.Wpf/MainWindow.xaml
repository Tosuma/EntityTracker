<Window x:Class="EntityTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EntityTracker"
        Width="1120"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Background" Value="#176B87" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#26343D" />
            <Setter Property="BorderBrush" Value="#C7D0D6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE3E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EAED" />
            <Setter Property="BorderBrush" Value="#D7DEE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <EventSetter Event="PreviewMouseWheel" Handler="OnDataGridPreviewMouseWheel" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="26,18"
                Background="#163A4A">
            <StackPanel>
                <TextBlock Foreground="White"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Text="EntityTracker" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#C9DCE4"
                           Text="Dependency-safe implementation overview" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="18,10"
                Background="#E2EFF4"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="110"
                             Height="5"
                             Margin="0,0,12,0"
                             IsIndeterminate="True" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="#31505D"
                           Text="{Binding BusyMessage}" />
            </StackPanel>
        </Border>

        <TabControl Margin="18"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Overview">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding RefreshCommand}"
                                    Content="Refresh"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Command="{Binding ImportCsvCommand}"
                                    Content="Import CSV"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#26343D"
                                       Text="Persisted entities" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64737C"
                                       Text="Ranked entities are ordered so dependencies appear before the entities that use them." />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel>
                                <TextBlock Foreground="#6B7880" Text="Total" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding TotalEntityCount}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel>
                                <TextBlock Foreground="#6B7880" Text="Not started" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding NotStartedCount}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel>
                                <TextBlock Foreground="#6B7880" Text="In progress" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding InProgressCount}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel>
                                <TextBlock Foreground="#6B7880" Text="Completed" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding CompletedCount}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                                Margin="0"
                                Style="{StaticResource SummaryCardStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="#6B7880"
                                           Text="{Binding CompletionPercentage, StringFormat={}{0:F0}% complete}" />
                                <ProgressBar Height="10"
                                             Margin="0,9,0,0"
                                             Maximum="100"
                                             Value="{Binding CompletionPercentage, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,0,0,12"
                            MaxHeight="120"
                            Padding="12"
                            Background="#FDEAEA"
                            BorderBrush="#E6A6A6"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding HasOverviewError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock Foreground="#8A2D2D"
                                       Text="{Binding OverviewErrorMessage}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="3">
                        <DataGrid ItemsSource="{Binding OverviewItems}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="70" Binding="{Binding Rank}" Header="Rank" />
                                <DataGridTextColumn Width="2*" Binding="{Binding SourceName}" Header="Entity" />
                                <DataGridTextColumn Width="130" Binding="{Binding Status}" Header="Status" />
                                <DataGridTextColumn Width="120" Binding="{Binding DependencyState}" Header="Dependency State" />
                                <DataGridTextColumn Width="105" Binding="{Binding DependencyCount}" Header="Dependencies" />
                                <DataGridTextColumn Width="2*" Binding="{Binding MissingDependencies}" Header="Missing Dependencies" />
                                <DataGridTextColumn Width="2*" Binding="{Binding Notes}" Header="Notes" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#F8FAFB"
                                BorderBrush="#D7DEE2"
                                BorderThickness="1"
                                Visibility="{Binding ShowOverviewEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#4E5E67"
                                           Text="No persisted entities" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="#74828A"
                                           Text="Use Import CSV to validate and preview a schema file without saving changes." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Import Preview">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ImportCsvCommand}"
                                Content="Import CSV"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#26343D"
                                       Text="CSV import preview" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#64737C"
                                       Text="{Binding SelectedFileName}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,0,0,14"
                            Padding="12"
                            Background="#FFF8DC"
                            BorderBrush="#E5D28B"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock Foreground="#6E5A18"
                                   FontWeight="SemiBold"
                                   Text="Preview only — no changes are saved to the database." />
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding PreviewEntityCount, StringFormat={}{0} entities}" />
                            <TextBlock Margin="18,0,0,0"
                                       FontWeight="SemiBold"
                                       Text="{Binding PreviewDependencyCount, StringFormat={}{0} dependencies}" />
                        </StackPanel>

                        <Border Margin="0,0,0,8"
                                MaxHeight="120"
                                Padding="12"
                                Background="#FFF8DC"
                                BorderBrush="#E5D28B"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding HasPreviewWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PreviewWarnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2"
                                                       Foreground="#6E5A18"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Border MaxHeight="120"
                                Padding="12"
                                Background="#FDEAEA"
                                BorderBrush="#E6A6A6"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding HasPreviewDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PreviewDiagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2"
                                                       Foreground="#8A2D2D"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <DataGrid ItemsSource="{Binding PreviewItems}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="70" Binding="{Binding Rank}" Header="Rank" />
                                <DataGridTextColumn Width="2*" Binding="{Binding SourceName}" Header="Entity" />
                                <DataGridTextColumn Width="105" Binding="{Binding MandatoryDependencyCount}" Header="Mandatory" />
                                <DataGridTextColumn Width="105" Binding="{Binding OptionalDependencyCount}" Header="Optional" />
                                <DataGridTextColumn Width="80" Binding="{Binding DependencyCount}" Header="Total" />
                                <DataGridTextColumn Width="120" Binding="{Binding DependencyState}" Header="Dependency State" />
                                <DataGridTextColumn Width="2*" Binding="{Binding MissingDependencies}" Header="Missing Dependencies" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#F8FAFB"
                                BorderBrush="#D7DEE2"
                                BorderThickness="1"
                                Visibility="{Binding ShowPreviewEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="#65747C"
                                       Text="{Binding PreviewEmptyMessage}" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
