<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Brand palette -->
    <Color x:Key="Color.Brand.DarkGreen">#141E1E</Color>
    <Color x:Key="Color.Brand.Green100">#123836</Color>
    <Color x:Key="Color.Brand.Green90">#2A4C4A</Color>
    <Color x:Key="Color.Brand.Green80">#41605E</Color>
    <Color x:Key="Color.Brand.Green60">#718886</Color>
    <Color x:Key="Color.Brand.Green40">#A0AFAF</Color>
    <Color x:Key="Color.Brand.Green30">#B8C3C3</Color>
    <Color x:Key="Color.Brand.Green20">#D0D7D7</Color>
    <Color x:Key="Color.Brand.Green10">#E7EBEB</Color>
    <Color x:Key="Color.Brand.White">#FFFFFF</Color>
    <Color x:Key="Color.Brand.Coral">#FF6359</Color>

    <!-- Base brushes -->
    <SolidColorBrush x:Key="Brush.Brand.DarkGreen" Color="{StaticResource Color.Brand.DarkGreen}" />
    <SolidColorBrush x:Key="Brush.Brand.Green100" Color="{StaticResource Color.Brand.Green100}" />
    <SolidColorBrush x:Key="Brush.Brand.Green90" Color="{StaticResource Color.Brand.Green90}" />
    <SolidColorBrush x:Key="Brush.Brand.Green80" Color="{StaticResource Color.Brand.Green80}" />
    <SolidColorBrush x:Key="Brush.Brand.Green60" Color="{StaticResource Color.Brand.Green60}" />
    <SolidColorBrush x:Key="Brush.Brand.Green40" Color="{StaticResource Color.Brand.Green40}" />
    <SolidColorBrush x:Key="Brush.Brand.Green30" Color="{StaticResource Color.Brand.Green30}" />
    <SolidColorBrush x:Key="Brush.Brand.Green20" Color="{StaticResource Color.Brand.Green20}" />
    <SolidColorBrush x:Key="Brush.Brand.Green10" Color="{StaticResource Color.Brand.Green10}" />
    <SolidColorBrush x:Key="Brush.Brand.White" Color="{StaticResource Color.Brand.White}" />
    <SolidColorBrush x:Key="Brush.Brand.Coral" Color="{StaticResource Color.Brand.Coral}" />

    <!-- Semantic brushes -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Brand.DarkGreen}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary"
                     Color="{StaticResource Color.Brand.DarkGreen}"
                     Opacity="0.72" />
    <SolidColorBrush x:Key="Brush.Text.OnDark" Color="{StaticResource Color.Brand.White}" />
    <SolidColorBrush x:Key="Brush.Text.OnDarkMuted" Color="{StaticResource Color.Brand.Green10}" />

    <SolidColorBrush x:Key="Brush.Surface.Page" Color="{StaticResource Color.Brand.Green10}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Color.Brand.White}" />
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{StaticResource Color.Brand.Green10}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Brand.Green20}" />
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Brand.Green20}" />
    <SolidColorBrush x:Key="Brush.Surface.Primary" Color="{StaticResource Color.Brand.Green100}" />
    <SolidColorBrush x:Key="Brush.Surface.Alert" Color="{StaticResource Color.Brand.White}" />

    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Brand.Green20}" />
    <SolidColorBrush x:Key="Brush.Border.Medium" Color="{StaticResource Color.Brand.Green30}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Brand.Green60}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Brand.Green100}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Brand.Coral}" />
    <SolidColorBrush x:Key="Brush.Overlay"
                     Color="{StaticResource Color.Brand.DarkGreen}"
                     Opacity="0.60" />

    <SolidColorBrush x:Key="Brush.Status.NotStarted" Color="{StaticResource Color.Brand.Green40}" />
    <SolidColorBrush x:Key="Brush.Status.InProgress" Color="{StaticResource Color.Brand.Green80}" />
    <SolidColorBrush x:Key="Brush.Status.ReworkNeeded" Color="{StaticResource Color.Brand.Coral}" />
    <SolidColorBrush x:Key="Brush.Status.DevelopmentCompleted" Color="{StaticResource Color.Brand.Green60}" />
    <SolidColorBrush x:Key="Brush.Status.Reconciled" Color="{StaticResource Color.Brand.Green100}" />
    <SolidColorBrush x:Key="Brush.Status.Ready" Color="{StaticResource Color.Brand.Green80}" />
    <SolidColorBrush x:Key="Brush.Status.Blocked" Color="{StaticResource Color.Brand.Coral}" />

    <!-- Shared controls -->
    <Style x:Key="EntityTrackerButtonBaseStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Medium}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource EntityTrackerButtonBaseStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource EntityTrackerButtonBaseStyle}">
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Background" Value="{StaticResource Brush.Brand.Green100}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnDark}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Green100}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Brand.Green90}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Green90}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Brand.Green80}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Green80}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource EntityTrackerButtonBaseStyle}">
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Medium}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Surface.Subtle}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource EntityTrackerButtonBaseStyle}">
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.76" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Medium}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Brand.Green100}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Brand.Green60}" />
        <Setter Property="SelectionTextBrush" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="6,4" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.50" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Medium}" />
        <Setter Property="Padding" Value="6,4" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.50" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Medium}" />
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="TabBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="3,3,0,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Brush.Surface.Card}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EntityTrackerDataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Subtle}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="EntityTrackerDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="4,2" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EntityTrackerDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Surface.Subtle}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Surface.Selected}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EntityTrackerDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Medium}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="RowBackground" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.Surface.Subtle}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="RowStyle" Value="{StaticResource EntityTrackerDataGridRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource EntityTrackerDataGridCellStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource EntityTrackerDataGridColumnHeaderStyle}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="RowHeight" Value="38" />
        <Setter Property="ColumnHeaderHeight" Value="40" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    </Style>

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{StaticResource Brush.Brand.Green20}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Green80}" />
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnDark}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Green80}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
</ResourceDictionary>
