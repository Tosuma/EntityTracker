<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Product colors remain stable in every appearance. -->
    <Color x:Key="Color.Brand.DarkGreen">#141E1E</Color>
    <Color x:Key="Color.Brand.Green100">#123836</Color>
    <Color x:Key="Color.Brand.Green90">#2A4C4A</Color>
    <Color x:Key="Color.Brand.Green80">#41605E</Color>
    <Color x:Key="Color.Brand.Green60">#718886</Color>
    <Color x:Key="Color.Brand.Green40">#A0AFAF</Color>
    <Color x:Key="Color.Brand.Green30">#B8C3C3</Color>
    <Color x:Key="Color.Brand.Green20">#D0D7D7</Color>
    <Color x:Key="Color.Brand.Green10">#E7EBEB</Color>
    <Color x:Key="Color.Brand.White">#FFFFFF</Color>
    <Color x:Key="Color.Brand.Coral">#FF6359</Color>
    <Color x:Key="Color.Brand.CoralHover">#FF786F</Color>
    <Color x:Key="Color.Review.Warning.Header">#D9922E</Color>
    <Color x:Key="Color.Review.Warning.Surface">#40D9922E</Color>
    <Color x:Key="Color.Review.Warning.Border">#D9922E</Color>

    <!-- Status colours: one fill and one text colour per status. Change a value here to recolour that
         status everywhere in the app (badges, cards, progress bar, dependency graph). Keep each text
         colour at 4.5:1 contrast with its fill. Reports have their own copy in
         EntityTracker.Reporting/StatusColors.cs and report.js. -->
    <!-- Development statuses -->
    <Color x:Key="Color.Status.NotStarted">#A0AFAF</Color> <!-- Green 40% -->
    <Color x:Key="Color.Status.NotStarted.Text">#141E1E</Color> <!-- Dark Green -->
    <Color x:Key="Color.Status.InProgress">#41605E</Color> <!-- Green 80% -->
    <Color x:Key="Color.Status.InProgress.Text">#FFFFFF</Color> <!-- White -->
    <Color x:Key="Color.Status.ReworkNeeded">#FF6359</Color> <!-- Coral -->
    <Color x:Key="Color.Status.ReworkNeeded.Text">#141E1E</Color> <!-- Dark Green -->
    <Color x:Key="Color.Status.Reworking">#41605E</Color> <!-- Green 80% -->
    <Color x:Key="Color.Status.Reworking.Text">#FFFFFF</Color> <!-- White -->
    <Color x:Key="Color.Status.Blocked">#FF6359</Color> <!-- Coral -->
    <Color x:Key="Color.Status.Blocked.Text">#141E1E</Color> <!-- Dark Green -->
    <Color x:Key="Color.Status.DevelopmentCompleted">#718886</Color> <!-- Green 60% -->
    <Color x:Key="Color.Status.DevelopmentCompleted.Text">#141E1E</Color> <!-- Dark Green -->
    <Color x:Key="Color.Status.Reconciled">#123836</Color> <!-- Green 100% -->
    <Color x:Key="Color.Status.Reconciled.Text">#FFFFFF</Color> <!-- White -->
    <!-- Work statuses -->
    <Color x:Key="Color.WorkStatus.Ready">#41605E</Color> <!-- Green 80% -->
    <Color x:Key="Color.WorkStatus.Ready.Text">#FFFFFF</Color> <!-- White -->
    <Color x:Key="Color.WorkStatus.WaitingOnDependencies">#FF6359</Color> <!-- Coral -->
    <Color x:Key="Color.WorkStatus.WaitingOnDependencies.Text">#141E1E</Color> <!-- Dark Green -->
    <Color x:Key="Color.WorkStatus.Blocked">#FF6359</Color> <!-- Coral -->
    <Color x:Key="Color.WorkStatus.Blocked.Text">#141E1E</Color> <!-- Dark Green -->
    <Color x:Key="Color.WorkStatus.InProgress">#41605E</Color> <!-- Green 80% -->
    <Color x:Key="Color.WorkStatus.InProgress.Text">#FFFFFF</Color> <!-- White -->
    <Color x:Key="Color.WorkStatus.Completed">#718886</Color> <!-- Green 60% -->
    <Color x:Key="Color.WorkStatus.Completed.Text">#141E1E</Color> <!-- Dark Green -->
    <Color x:Key="Color.WorkStatus.Reconciled">#123836</Color> <!-- Green 100% -->
    <Color x:Key="Color.WorkStatus.Reconciled.Text">#FFFFFF</Color> <!-- White -->

    <SolidColorBrush x:Key="Brush.Brand.DarkGreen" Color="{StaticResource Color.Brand.DarkGreen}" />
    <SolidColorBrush x:Key="Brush.Brand.Green100" Color="{StaticResource Color.Brand.Green100}" />
    <SolidColorBrush x:Key="Brush.Brand.Green90" Color="{StaticResource Color.Brand.Green90}" />
    <SolidColorBrush x:Key="Brush.Brand.Green80" Color="{StaticResource Color.Brand.Green80}" />
    <SolidColorBrush x:Key="Brush.Brand.Green60" Color="{StaticResource Color.Brand.Green60}" />
    <SolidColorBrush x:Key="Brush.Brand.Green40" Color="{StaticResource Color.Brand.Green40}" />
    <SolidColorBrush x:Key="Brush.Brand.Green30" Color="{StaticResource Color.Brand.Green30}" />
    <SolidColorBrush x:Key="Brush.Brand.Green20" Color="{StaticResource Color.Brand.Green20}" />
    <SolidColorBrush x:Key="Brush.Brand.Green10" Color="{StaticResource Color.Brand.Green10}" />
    <SolidColorBrush x:Key="Brush.Brand.White" Color="{StaticResource Color.Brand.White}" />
    <SolidColorBrush x:Key="Brush.Brand.Coral" Color="{StaticResource Color.Brand.Coral}" />
    <SolidColorBrush x:Key="Brush.Brand.CoralHover" Color="{StaticResource Color.Brand.CoralHover}" />

    <!-- These brushes are recreated after a live ThemeMode change so their Fluent colors refresh. -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{DynamicResource TextFillColorDisabled}" />
    <SolidColorBrush x:Key="Brush.Text.OnDark" Color="{StaticResource Color.Brand.White}" />
    <SolidColorBrush x:Key="Brush.Text.OnDarkMuted" Color="{StaticResource Color.Brand.Green10}" />
    <SolidColorBrush x:Key="Brush.Notification.Information" Color="#A6DCEB" />
    <SolidColorBrush x:Key="Brush.Notification.Success" Color="#96E4AD" />
    <SolidColorBrush x:Key="Brush.Notification.Failure" Color="#FF9C94" />
    <SolidColorBrush x:Key="Brush.Notification.Action" Color="#FFD188" />
    <SolidColorBrush x:Key="Brush.Surface.Page" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{DynamicResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{DynamicResource SolidBackgroundFillColorQuarternary}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{DynamicResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="Brush.Surface.Selected"
                     Color="{StaticResource Color.Brand.Green60}"
                     Opacity="0.30" />
    <SolidColorBrush x:Key="Brush.Surface.Primary" Color="{StaticResource Color.Brand.Green100}" />
    <SolidColorBrush x:Key="Brush.Surface.Alert" Color="{DynamicResource CardBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="Brush.Control.Input" Color="{DynamicResource ControlSolidFillColorDefault}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{DynamicResource DividerStrokeColorDefault}" />
    <SolidColorBrush x:Key="Brush.Border.Medium" Color="{DynamicResource SurfaceStrokeColorDefault}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{DynamicResource ControlStrongStrokeColorDefault}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{DynamicResource FocusStrokeColorOuter}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Brand.Coral}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Brand.DarkGreen}" Opacity="0.60" />
    <SolidColorBrush x:Key="Brush.Overlay.Strong" Color="{StaticResource Color.Brand.DarkGreen}" Opacity="0.84" />

    <SolidColorBrush x:Key="Brush.Review.Missing.Header" Color="{StaticResource Color.Brand.Coral}" />
    <SolidColorBrush x:Key="Brush.Review.Missing.Surface" Color="{StaticResource Color.Brand.Coral}" Opacity="0.10" />
    <SolidColorBrush x:Key="Brush.Review.Missing.Border" Color="{StaticResource Color.Brand.Coral}" />
    <SolidColorBrush x:Key="Brush.Review.Warning.Header" Color="{StaticResource Color.Review.Warning.Header}" />
    <SolidColorBrush x:Key="Brush.Review.Warning.Surface" Color="{StaticResource Color.Review.Warning.Surface}" />
    <SolidColorBrush x:Key="Brush.Review.Warning.Border" Color="{StaticResource Color.Review.Warning.Border}" />
    <SolidColorBrush x:Key="Brush.Review.Warning.Text" Color="{DynamicResource TextFillColorPrimary}" />

    <SolidColorBrush x:Key="Brush.Status.NotStarted" Color="{StaticResource Color.Status.NotStarted}" />
    <SolidColorBrush x:Key="Brush.Status.NotStarted.Text" Color="{StaticResource Color.Status.NotStarted.Text}" />
    <SolidColorBrush x:Key="Brush.Status.InProgress" Color="{StaticResource Color.Status.InProgress}" />
    <SolidColorBrush x:Key="Brush.Status.InProgress.Text" Color="{StaticResource Color.Status.InProgress.Text}" />
    <SolidColorBrush x:Key="Brush.Status.ReworkNeeded" Color="{StaticResource Color.Status.ReworkNeeded}" />
    <SolidColorBrush x:Key="Brush.Status.ReworkNeeded.Text" Color="{StaticResource Color.Status.ReworkNeeded.Text}" />
    <SolidColorBrush x:Key="Brush.Status.Reworking" Color="{StaticResource Color.Status.Reworking}" />
    <SolidColorBrush x:Key="Brush.Status.Reworking.Text" Color="{StaticResource Color.Status.Reworking.Text}" />
    <SolidColorBrush x:Key="Brush.Status.Blocked" Color="{StaticResource Color.Status.Blocked}" />
    <SolidColorBrush x:Key="Brush.Status.Blocked.Text" Color="{StaticResource Color.Status.Blocked.Text}" />
    <SolidColorBrush x:Key="Brush.Status.DevelopmentCompleted" Color="{StaticResource Color.Status.DevelopmentCompleted}" />
    <SolidColorBrush x:Key="Brush.Status.DevelopmentCompleted.Text" Color="{StaticResource Color.Status.DevelopmentCompleted.Text}" />
    <SolidColorBrush x:Key="Brush.Status.Reconciled" Color="{StaticResource Color.Status.Reconciled}" />
    <SolidColorBrush x:Key="Brush.Status.Reconciled.Text" Color="{StaticResource Color.Status.Reconciled.Text}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.Ready" Color="{StaticResource Color.WorkStatus.Ready}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.Ready.Text" Color="{StaticResource Color.WorkStatus.Ready.Text}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.WaitingOnDependencies" Color="{StaticResource Color.WorkStatus.WaitingOnDependencies}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.WaitingOnDependencies.Text" Color="{StaticResource Color.WorkStatus.WaitingOnDependencies.Text}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.Blocked" Color="{StaticResource Color.WorkStatus.Blocked}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.Blocked.Text" Color="{StaticResource Color.WorkStatus.Blocked.Text}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.InProgress" Color="{StaticResource Color.WorkStatus.InProgress}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.InProgress.Text" Color="{StaticResource Color.WorkStatus.InProgress.Text}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.Completed" Color="{StaticResource Color.WorkStatus.Completed}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.Completed.Text" Color="{StaticResource Color.WorkStatus.Completed.Text}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.Reconciled" Color="{StaticResource Color.WorkStatus.Reconciled}" />
    <SolidColorBrush x:Key="Brush.WorkStatus.Reconciled.Text" Color="{StaticResource Color.WorkStatus.Reconciled.Text}" />
    <!-- Selected entities in the dependency graph: an amber no status uses, readable on both themes. -->
    <SolidColorBrush x:Key="Brush.Graph.Selection" Color="#C8821E" />

    <!-- Reports retain their established palette and a light plotting canvas. -->
    <SolidColorBrush x:Key="Brush.Report.Canvas" Color="{StaticResource Color.Brand.White}" />
</ResourceDictionary>
