<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Product colors remain stable in every appearance. -->
    <Color x:Key="Color.Brand.DarkGreen">#141E1E</Color>
    <Color x:Key="Color.Brand.Green100">#123836</Color>
    <Color x:Key="Color.Brand.Green90">#2A4C4A</Color>
    <Color x:Key="Color.Brand.Green80">#41605E</Color>
    <Color x:Key="Color.Brand.Green60">#718886</Color>
    <Color x:Key="Color.Brand.Green40">#A0AFAF</Color>
    <Color x:Key="Color.Brand.Green30">#B8C3C3</Color>
    <Color x:Key="Color.Brand.Green20">#D0D7D7</Color>
    <Color x:Key="Color.Brand.Green10">#E7EBEB</Color>
    <Color x:Key="Color.Brand.White">#FFFFFF</Color>
    <Color x:Key="Color.Brand.Coral">#FF6359</Color>
    <Color x:Key="Color.Review.Warning.Header">#D9922E</Color>
    <Color x:Key="Color.Review.Warning.Surface">#40D9922E</Color>
    <Color x:Key="Color.Review.Warning.Border">#D9922E</Color>

    <SolidColorBrush x:Key="Brush.Brand.DarkGreen" Color="{StaticResource Color.Brand.DarkGreen}" />
    <SolidColorBrush x:Key="Brush.Brand.Green100" Color="{StaticResource Color.Brand.Green100}" />
    <SolidColorBrush x:Key="Brush.Brand.Green90" Color="{StaticResource Color.Brand.Green90}" />
    <SolidColorBrush x:Key="Brush.Brand.Green80" Color="{StaticResource Color.Brand.Green80}" />
    <SolidColorBrush x:Key="Brush.Brand.Green60" Color="{StaticResource Color.Brand.Green60}" />
    <SolidColorBrush x:Key="Brush.Brand.Green40" Color="{StaticResource Color.Brand.Green40}" />
    <SolidColorBrush x:Key="Brush.Brand.Green30" Color="{StaticResource Color.Brand.Green30}" />
    <SolidColorBrush x:Key="Brush.Brand.Green20" Color="{StaticResource Color.Brand.Green20}" />
    <SolidColorBrush x:Key="Brush.Brand.Green10" Color="{StaticResource Color.Brand.Green10}" />
    <SolidColorBrush x:Key="Brush.Brand.White" Color="{StaticResource Color.Brand.White}" />
    <SolidColorBrush x:Key="Brush.Brand.Coral" Color="{StaticResource Color.Brand.Coral}" />

    <!-- These brushes are recreated after a live ThemeMode change so their Fluent colors refresh. -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{DynamicResource TextFillColorDisabled}" />
    <SolidColorBrush x:Key="Brush.Text.OnDark" Color="{StaticResource Color.Brand.White}" />
    <SolidColorBrush x:Key="Brush.Text.OnDarkMuted" Color="{StaticResource Color.Brand.Green10}" />
    <SolidColorBrush x:Key="Brush.Surface.Page" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{DynamicResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{DynamicResource SolidBackgroundFillColorQuarternary}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{DynamicResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="Brush.Surface.Selected"
                     Color="{StaticResource Color.Brand.Green60}"
                     Opacity="0.30" />
    <SolidColorBrush x:Key="Brush.Surface.Primary" Color="{StaticResource Color.Brand.Green100}" />
    <SolidColorBrush x:Key="Brush.Surface.Alert" Color="{DynamicResource CardBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="Brush.Control.Input" Color="{DynamicResource ControlSolidFillColorDefault}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{DynamicResource DividerStrokeColorDefault}" />
    <SolidColorBrush x:Key="Brush.Border.Medium" Color="{DynamicResource SurfaceStrokeColorDefault}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{DynamicResource ControlStrongStrokeColorDefault}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{DynamicResource FocusStrokeColorOuter}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Brand.Coral}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Brand.DarkGreen}" Opacity="0.60" />

    <SolidColorBrush x:Key="Brush.Review.Missing.Header" Color="{StaticResource Color.Brand.Coral}" />
    <SolidColorBrush x:Key="Brush.Review.Missing.Surface" Color="{StaticResource Color.Brand.Coral}" Opacity="0.10" />
    <SolidColorBrush x:Key="Brush.Review.Missing.Border" Color="{StaticResource Color.Brand.Coral}" />
    <SolidColorBrush x:Key="Brush.Review.Warning.Header" Color="{StaticResource Color.Review.Warning.Header}" />
    <SolidColorBrush x:Key="Brush.Review.Warning.Surface" Color="{StaticResource Color.Review.Warning.Surface}" />
    <SolidColorBrush x:Key="Brush.Review.Warning.Border" Color="{StaticResource Color.Review.Warning.Border}" />
    <SolidColorBrush x:Key="Brush.Review.Warning.Text" Color="{DynamicResource TextFillColorPrimary}" />

    <SolidColorBrush x:Key="Brush.Status.NotStarted" Color="{StaticResource Color.Brand.Green40}" />
    <SolidColorBrush x:Key="Brush.Status.InProgress" Color="{StaticResource Color.Brand.Green80}" />
    <SolidColorBrush x:Key="Brush.Status.ReworkNeeded" Color="{StaticResource Color.Brand.Coral}" />
    <SolidColorBrush x:Key="Brush.Status.DevelopmentCompleted" Color="{StaticResource Color.Brand.Green60}" />
    <SolidColorBrush x:Key="Brush.Status.Reconciled" Color="{StaticResource Color.Brand.Green100}" />
    <SolidColorBrush x:Key="Brush.Status.Ready" Color="{StaticResource Color.Brand.Green80}" />
    <SolidColorBrush x:Key="Brush.Status.Blocked" Color="{StaticResource Color.Brand.Coral}" />

    <!-- Reports retain their established palette and a light plotting canvas. -->
    <SolidColorBrush x:Key="Brush.Report.Canvas" Color="{StaticResource Color.Brand.White}" />
</ResourceDictionary>
