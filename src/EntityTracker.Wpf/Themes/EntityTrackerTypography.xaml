<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:Double x:Key="Spacing.4">4</system:Double>
    <system:Double x:Key="Spacing.8">8</system:Double>
    <system:Double x:Key="Spacing.12">12</system:Double>
    <system:Double x:Key="Spacing.16">16</system:Double>
    <system:Double x:Key="Spacing.24">24</system:Double>
    <CornerRadius x:Key="CornerRadius.Card">6</CornerRadius>
    <system:Double x:Key="Height.Control">32</system:Double>
    <system:Double x:Key="Height.Row">36</system:Double>
    <system:Double x:Key="Height.Header">40</system:Double>

    <Style x:Key="PageHeadingTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style x:Key="SectionHeadingTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style x:Key="SectionHeadingLabelStyle" TargetType="{x:Type Label}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <!-- The title of a dialog (ModalDialog). -->
    <Style x:Key="DialogTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <!-- The name on a repeated card, such as a Project or a Tracker. -->
    <Style x:Key="CardTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <!-- The name at the top of a details pane. -->
    <Style x:Key="DetailsTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <!-- The number in a summary card. -->
    <Style x:Key="MetricValueTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A number inside a card that has other content. -->
    <Style x:Key="CompactMetricValueTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="PageDescriptionTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
