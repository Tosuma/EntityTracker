<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- These styles tune density and semantics while retaining .NET's Fluent templates. -->
    <Style TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="{DynamicResource Height.Control}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="{DynamicResource Height.Control}" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource Brush.Brand.Green100}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDark}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Green100}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Brand.Green90}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Green90}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Brand.Green80}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="{DynamicResource Height.Control}" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
    </Style>

    <Style x:Key="DangerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="{DynamicResource Height.Control}" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Brand.DarkGreen}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource Height.Control}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Focus}" />
        <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource Height.Control}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="MinHeight" Value="{DynamicResource Height.Control}" />
    </Style>
    <Style TargetType="{x:Type TabControl}"
           BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Page}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
    </Style>
    <Style TargetType="{x:Type TabItem}"
           BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style x:Key="EntityTrackerDataGridColumnHeaderStyle"
           TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="EntityTrackerDataGridCellStyle"
           TargetType="{x:Type DataGridCell}"
           BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style x:Key="EntityTrackerDataGridRowStyle"
           TargetType="{x:Type DataGridRow}"
           BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="EntityTrackerDataGridStyle"
           TargetType="{x:Type DataGrid}"
           BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="RowBackground" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Surface.Subtle}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="RowStyle" Value="{StaticResource EntityTrackerDataGridRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource EntityTrackerDataGridCellStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource EntityTrackerDataGridColumnHeaderStyle}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="RowHeight" Value="{DynamicResource Height.Row}" />
        <Setter Property="ColumnHeaderHeight" Value="{DynamicResource Height.Header}" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    </Style>
    <Style TargetType="{x:Type ProgressBar}"
           BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Brand.Green80}" />
    </Style>
    <Style TargetType="{x:Type ToolTip}"
           BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="Padding" Value="8,6" />
    </Style>
</ResourceDictionary>
