
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EntityTracker.Application\EntityTracker.Application.csproj" />
    <ProjectReference Include="..\EntityTracker.Infrastructure\EntityTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\EntityTracker.Reporting\EntityTracker.Reporting.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- LiveCharts ships a net8.0-windows assembly, while three transitive WPF/OpenGL
         assemblies are also packaged as .NET Framework assets. The selected stable
         package is compatible with this Windows-only target despite NuGet's NU1701. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

</Project>
