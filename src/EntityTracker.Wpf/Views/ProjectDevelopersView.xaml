<UserControl x:Class="EntityTracker.Wpf.Views.ProjectDevelopersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls"
             xmlns:views="clr-namespace:EntityTracker.Wpf.Views">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Title="{Binding ProjectContextName}"
                                 Description="Manage the developers available within this Project.">
                <WrapPanel Style="{StaticResource PageToolbarStyle}">
                    <Button Margin="0,0,8,0" Content="Retired developers"
                        Command="{Binding Developers.OpenRetiredCommand}"
                        AutomationProperties.HelpText="Show retired developers, to edit or restore them" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="NewDeveloperButton" Content="_New developer"
                            Command="{Binding Developers.OpenNewCommand}"
                            AutomationProperties.HelpText="Add a developer to this Project"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </WrapPanel>
                <controls:PageHeader.Tabs>
                    <views:ProjectTabs Margin="0,8,0,0" Current="Developers" />
                </controls:PageHeader.Tabs>
            </controls:PageHeader>
            <Grid Grid.Row="1">
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" Padding="16"
                            Style="{StaticResource EntityTrackerCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- The list's search sits in its header, as on the Tracker pages. -->
                            <DockPanel>
                                <TextBox x:Name="DeveloperSearchBox" DockPanel.Dock="Right" Width="260"
                                         VerticalAlignment="Center"
                                         controls:Placeholder.Text="Search by initials or name"
                                         AutomationProperties.Name="Search developers by initials or display name"
                                         Text="{Binding Developers.SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <controls:Icon DockPanel.Dock="Right" Margin="0,0,6,0" VerticalAlignment="Center" Size="16"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" IconKey="Icon.Search" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionHeadingTextStyle}"
                                           Text="Available developers" />
                            </DockPanel>
                            <DataGrid Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource EntityTrackerDataGridStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      ItemsSource="{Binding Developers.Available}"
                                      AutomationProperties.Name="Available developers">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Initials" Width="90" Binding="{Binding Initials}" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                                    <DataGridTextColumn Header="Display name" Width="*" Binding="{Binding DisplayName}" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                                    <DataGridTemplateColumn Width="48">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button x:Name="DeveloperActionsButton" Width="30" Height="28" Padding="0"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Developer actions"
                                                        AutomationProperties.Name="{Binding Initials, StringFormat=Actions for developer {0}}"
                                                        Click="OnDeveloperActionsClick">
                                                    <controls:Icon IconKey="Icon.MoreVertical" Size="18" />
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="_Edit" Click="OnEditDeveloper"
                                                                      AutomationProperties.Name="{Binding Initials, StringFormat=Edit developer {0}}" />
                                                            <MenuItem Header="_Retire" Click="OnRetireDeveloper"
                                                                      AutomationProperties.Name="{Binding Initials, StringFormat=Retire developer {0}}"
                                                                      Style="{StaticResource DangerMenuItemStyle}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <controls:ModalDialog x:Name="DeveloperDialog" Size="Small"
                              IsOpen="{Binding Developers.IsFormOpen}"
                              Title="{Binding Developers.EditorTitle}"
                              Description="Initials are unique among available developers in this Project."
                              CancelCommand="{Binding Developers.CancelCommand}"
                              InitialFocus="{Binding ElementName=DeveloperInitialsBox}">
            <controls:ModalDialog.Footer>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveDeveloperButton" Margin="0,0,8,0" IsDefault="True"
                            Command="{Binding Developers.SaveCommand}"
                            Content="{Binding Developers.SaveLabel}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="CreateAnotherDeveloperButton" Margin="0,0,8,0"
                            Command="{Binding Developers.CreateAnotherCommand}" Content="Create and _add another"
                            AutomationProperties.HelpText="Create this developer and keep the dialog open for the next one"
                            Visibility="{Binding Developers.IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Cancel" Command="{Binding Developers.CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </controls:ModalDialog.Footer>
            <StackPanel>
                <Label Padding="0" Target="{Binding ElementName=DeveloperInitialsBox}" Content="_Initials" />
                <TextBox x:Name="DeveloperInitialsBox" Margin="0,4,0,0"
                         controls:Placeholder.Text="Initials, e.g. AB"
                         AutomationProperties.Name="Developer initials"
                         Text="{Binding Developers.Initials, UpdateSourceTrigger=PropertyChanged}" />
                <Label Margin="0,12,0,0" Padding="0" Target="{Binding ElementName=DeveloperDisplayNameBox}"
                       Content="_Display name (optional)" />
                <TextBox x:Name="DeveloperDisplayNameBox" Margin="0,4,0,0"
                         controls:Placeholder.Text="Full name (optional)"
                         AutomationProperties.Name="Developer display name"
                         Text="{Binding Developers.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                <Border x:Name="DeveloperError" Margin="0,12,0,0" Style="{StaticResource ErrorMessageStyle}"
                        Visibility="{Binding Developers.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock AutomationProperties.LiveSetting="Assertive" Text="{Binding Developers.ErrorMessage}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </controls:ModalDialog>
        <controls:ModalDialog x:Name="RetirementDialog" Size="Small"
                              IsOpen="{Binding Developers.IsRetirementOpen}"
                              Title="{Binding Developers.PendingRetirementInitials, StringFormat=Retire {0}?}"
                              CancelCommand="{Binding Developers.CancelRetirementCommand}"
                              InitialFocus="{Binding ElementName=CancelRetirementButton}">
            <controls:ModalDialog.Footer>
                <StackPanel Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Content="_Retire developer" Command="{Binding Developers.ConfirmRetirementCommand}"
                            Style="{StaticResource DangerButtonStyle}" />
                    <Button x:Name="CancelRetirementButton" Content="Cancel"
                            Command="{Binding Developers.CancelRetirementCommand}" IsDefault="True"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </controls:ModalDialog.Footer>
            <TextBlock TextWrapping="Wrap" Text="{Binding Developers.PendingRetirementMessage}" />
        </controls:ModalDialog>
        <controls:ModalDialog x:Name="RetiredDialog" Size="Medium" Title="Retired developers"
                              IsOpen="{Binding Developers.IsRetiredDialogOpen}"
                              CancelCommand="{Binding Developers.CloseRetiredCommand}"
                              InitialFocus="{Binding ElementName=CloseRetiredButton}">
            <controls:ModalDialog.Footer>
                <Button x:Name="CloseRetiredButton" Content="Close" Command="{Binding Developers.CloseRetiredCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </controls:ModalDialog.Footer>
            <StackPanel>
                            <TextBlock Text="Retired developers remain in this Project and may be restored."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0" Text="No retired developers match the current search."
                                       Visibility="{Binding Developers.ShowNoRetired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Developers.Retired}"
                                          AutomationProperties.Name="Retired developers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Restore"
                                                    AutomationProperties.Name="{Binding Initials, StringFormat=Restore developer {0}}"
                                                    Command="{Binding DataContext.Developers.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="Edit"
                                                    AutomationProperties.Name="{Binding Initials, StringFormat=Edit retired developer {0}}"
                                                    Command="{Binding DataContext.Developers.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Initials}" />
                                                <TextBlock Margin="8,0,0,0" Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
        </controls:ModalDialog>
    </Grid>
</UserControl>
