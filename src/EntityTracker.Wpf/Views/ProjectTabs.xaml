<UserControl x:Class="EntityTracker.Wpf.Views.ProjectTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:EntityTracker.Wpf.ViewModels"
             Focusable="False" IsTabStop="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <!-- The tabs only choose the page; each page is shown by the shell as before, so its guards still apply. -->
    <TabControl x:Name="Tabs" Style="{DynamicResource TextTabControlStyle}"
                AutomationProperties.Name="Project pages"
                ItemContainerStyle="{DynamicResource TextTabItemStyle}"
                SelectionChanged="OnSelectionChanged">
        <TabItem Header="Dashboard" Tag="{x:Static viewModels:ShellDestination.ProjectDashboard}" />
        <TabItem Header="Report" Tag="{x:Static viewModels:ShellDestination.ProjectReport}" />
        <TabItem Header="Developers" Tag="{x:Static viewModels:ShellDestination.Developers}" />
        <TabItem x:Name="SchemasTab" Header="Schemas" Tag="{x:Static viewModels:ShellDestination.Schemas}"
                 Visibility="{Binding CanManageSchemas, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </TabControl>
</UserControl>
