<UserControl x:Class="EntityTracker.Wpf.Views.CatalogModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls">
    <Grid Background="{DynamicResource Brush.Overlay.Strong}"
          IsVisibleChanged="OnIsVisibleChanged"
          FocusManager.IsFocusScope="True"
          KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border Width="680"
                MaxHeight="680"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Surface.Page}"
                Style="{StaticResource EntityTrackerCardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DialogTitle}" />

                <ScrollViewer x:Name="DialogScroll" Grid.Row="1" Margin="0,18" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <StackPanel Visibility="{Binding IsNameDialog, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Label x:Name="CatalogNameLabel" Content="Name" />
                                <TextBox x:Name="CatalogNameTextBox" AutomationProperties.LabeledBy="{Binding ElementName=CatalogNameLabel}"
                                         controls:Placeholder.Text="Name"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsTrackerCreation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Label x:Name="TrackerNameLabel" Content="Tracker name" />
                            <TextBox x:Name="TrackerNameTextBox" AutomationProperties.LabeledBy="{Binding ElementName=TrackerNameLabel}"
                                     controls:Placeholder.Text="Name of the new Tracker"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" Text="Starting point" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Margin="0,0,18,0" Content="Blank" GroupName="CreationMode" IsChecked="{Binding IsBlankMode, Mode=OneWay}" Checked="OnBlankChecked" />
                                <RadioButton x:Name="FromSchemaOption" Margin="0,0,18,0" Content="From schema" GroupName="CreationMode"
                                             IsChecked="{Binding IsSchemaMode, Mode=OneWay}" Checked="OnSchemaChecked"
                                             IsEnabled="{Binding HasSchemaOptions}" ToolTip="Create a schema from the Project dashboard first." ToolTipService.ShowOnDisabled="True"
                                             Visibility="{Binding CanCreateFromSchema, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsSchemaMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Label x:Name="SchemaSourceLabel" Content="Schema" />
                                <ComboBox x:Name="SchemaSourceBox" AutomationProperties.LabeledBy="{Binding ElementName=SchemaSourceLabel}"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding SchemaOptions}"
                                          SelectedItem="{Binding SelectedSchema}" />
                                <Border Margin="0,12,0,0" Padding="12" Style="{StaticResource EntityTrackerCardStyle}">
                                    <TextBlock Text="{Binding SchemaPreview}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0" Text="{Binding OperationMessage}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsRecycleBin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Visibility="{Binding ShowsRecycledProjects, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource SectionHeadingTextStyle}" Text="Recycled projects" />
                            <TextBlock Margin="0,8,0,12" Style="{StaticResource PageDescriptionTextStyle}" Text="No recycled projects."
                                       Visibility="{Binding ShowNoRecycledProjects, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl Margin="0,8,0,18" ItemsSource="{Binding RecycledProjects}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnPurgeProject" Content="Permanently delete" Style="{StaticResource DangerButtonStyle}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Permanently delete project {0}}" />
                                        <Button DockPanel.Dock="Right" Click="OnRestoreProject" Content="Restore"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Restore project {0}}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SectionHeadingTextStyle}" Text="Recycled trackers" />
                            <TextBlock Margin="0,8,0,12" Style="{StaticResource PageDescriptionTextStyle}" Text="No recycled trackers in this context."
                                       Visibility="{Binding ShowNoRecycledTrackers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding RecycledTrackers}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnPurgeTracker" Content="Permanently delete" Style="{StaticResource DangerButtonStyle}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Permanently delete tracker {0}}" />
                                        <Button DockPanel.Dock="Right" Click="OnRestoreTracker" Content="Restore"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Restore tracker {0}}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="RecycledSchemasSection" Margin="0,18,0,0"
                                        Visibility="{Binding ShowsRecycledSchemas, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource SectionHeadingTextStyle}" Text="Recycled schemas" />
                            <TextBlock Margin="0,8,0,12" Style="{StaticResource PageDescriptionTextStyle}" Text="No recycled schemas in this project."
                                       Visibility="{Binding ShowNoRecycledSchemas, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding RecycledSchemas}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnPurgeSchema" Content="Permanently delete" Style="{StaticResource DangerButtonStyle}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Permanently delete schema {0}}" />
                                        <Button DockPanel.Dock="Right" Click="OnRestoreSchema" Content="Restore"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Restore schema {0}}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsRecycleConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding PendingItemName, StringFormat=Recycle {0}?}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0" Text="This is reversible. The item will disappear from active selectors and metrics immediately." TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="ConvertConfirmationSection"
                                        Visibility="{Binding IsConvertConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,0,10" Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap"
                                       Text="Nothing changes until you select Convert." />
                            <ItemsControl x:Name="ConversionLines" ItemsSource="{Binding ConversionLines}"
                                          AutomationProperties.Name="What converting does">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,8" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="DetachConfirmationSection"
                                        Visibility="{Binding IsDetachConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding DetachText}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsPurgeConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold"
                                       Text="This action cannot be undone." />
                            <TextBlock Margin="0,10,0,0" Text="{Binding PurgeImpactSummary}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,14,0,4" Text="{Binding PendingItemName, StringFormat=Type the exact name {0} to continue:}" TextWrapping="Wrap" />
                            <TextBox x:Name="PurgeConfirmationTextBox" AutomationProperties.Name="Exact name confirmation"
                                     controls:Placeholder.Text="Type the name to confirm"
                                     Text="{Binding TypedConfirmation, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,12,0,0" MaxHeight="100" Style="{StaticResource ErrorMessageStyle}"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock AutomationProperties.LiveSetting="Assertive" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                    <!-- Commit first, then Cancel; the recycle bin only lists items, so it is closed instead. -->
                    <Button Margin="0,0,8,0" Command="{Binding SubmitNameCommand}" Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding IsNameDialog, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="CreateTrackerButton" Margin="0,0,8,0" Command="{Binding PrepareTrackerCommand}" Content="Create tracker"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding IsTrackerCreation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="ConfirmConvertButton" Margin="0,0,8,0" Command="{Binding ConfirmConvertCommand}" Content="Convert"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding IsConvertConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,8,0" Command="{Binding ConfirmRecycleCommand}" Content="Recycle" Style="{StaticResource DangerButtonStyle}"
                            Visibility="{Binding IsRecycleConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="ConfirmDetachButton" Margin="0,0,8,0" Command="{Binding ConfirmDetachCommand}" Content="Detach"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="{Binding IsDetachConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,8,0" Command="{Binding ConfirmPurgeCommand}" Content="Permanently delete" Style="{StaticResource DangerButtonStyle}"
                            Visibility="{Binding IsPurgeConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="CancelButton" Command="{Binding CancelCommand}" IsCancel="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Content" Value="Cancel" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecycleBin}" Value="True">
                                        <Setter Property="Content" Value="Close" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
