<UserControl x:Class="EntityTracker.Wpf.Views.GitIdentityDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Asked during Portfolio › Import project. The control's DataContext is InAppDialogs; the dialog's is
         the question itself. Esc does what Cancel does: the first asks for confirmation. -->
    <controls:ModalDialog x:Name="Dialog" UsesStrongScrim="True" Title="Set your Git name and email"
                          Description="Git records a name and email with every commit. EntityTracker needs them to import this Project."
                          IsOpen="{Binding DataContext.IsGitIdentityOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" DataContext="{Binding GitIdentity}"
                          Opened="OnOpened" CancelRequested="OnCancel">
        <controls:ModalDialog.Footer>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="_Save and import" IsDefault="True" MinWidth="130"
                        Style="{StaticResource PrimaryButtonStyle}" Click="OnSave" />
                <!-- Both labels share one cell, so the button is as wide as the longer one and never
                     resizes when the label changes. -->
                <Button x:Name="CancelButton" Margin="8,0,0,0" Click="OnCancel">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="AutomationProperties.Name" Value="Cancel" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConfirmingCancel}" Value="True">
                                    <Setter Property="AutomationProperties.Name" Value="Confirm cancel" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <TextBlock x:Name="CancelLabel" Text="Cancel" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConfirmingCancel}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="ConfirmCancelLabel" Text="Confirm cancel" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConfirmingCancel}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
            </StackPanel>
        </controls:ModalDialog.Footer>
        <StackPanel>
            <Label Padding="0" Content="_Name" Target="{Binding ElementName=NameBox}" />
            <TextBox x:Name="NameBox" Margin="0,4,0,0" AutomationProperties.Name="Git name"
                     controls:Placeholder.Text="Your name, as it appears on commits"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <Label Margin="0,12,0,0" Padding="0" Content="_Email" Target="{Binding ElementName=EmailBox}" />
            <TextBox x:Name="EmailBox" Margin="0,4,0,0" AutomationProperties.Name="Git email"
                     controls:Placeholder.Text="you@example.com"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox x:Name="ScopeCheckBox" Margin="0,16,0,0"
                      Content="Save to _global Git configuration" IsChecked="{Binding SaveToGlobalConfiguration}" />

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Critical}"
                       Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock x:Name="CancelWarning" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Review.Warning.Text}"
                       Text="Without a name and email, the Project won't be imported."
                       AutomationProperties.LiveSetting="Assertive"
                       Visibility="{Binding IsConfirmingCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </controls:ModalDialog>
</UserControl>
