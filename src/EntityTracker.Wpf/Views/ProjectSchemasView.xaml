<UserControl x:Class="EntityTracker.Wpf.Views.ProjectSchemasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:EntityTracker.Wpf.ViewModels"
             xmlns:views="clr-namespace:EntityTracker.Wpf.Views"
             xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource EntityTrackerDataGridStyle}" />
    </UserControl.Resources>
    <!-- The page's DataContext is the shell, for the tabs and the breadcrumb back to the dashboard; the rest
         binds the Schemas page. -->
    <Grid x:Name="SchemasRoot" DataContext="{Binding SchemasPage}">

        <!-- The list: one card per schema. -->
        <Grid x:Name="SchemaListPage" Visibility="{Binding IsListing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader Title="{Binding ProjectName}"
                                 Description="A schema lists which entities exist in this project and how they depend on each other. It holds no progress: trackers keep their own statuses, notes and developers.">
                <WrapPanel Style="{StaticResource PageToolbarStyle}">
                    <Button x:Name="CreateSchemaButton" Command="{Binding CreateSchemaCommand}" Content="Create schema"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </WrapPanel>
                <controls:PageHeader.Tabs>
                    <views:ProjectTabs Margin="0,8,0,0" Current="Schemas" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </controls:PageHeader.Tabs>
            </controls:PageHeader>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="SchemasEmptyState" MaxWidth="560" HorizontalAlignment="Left" Padding="18"
                            Style="{StaticResource EntityTrackerCardStyle}"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeadingTextStyle}" Text="No schemas yet" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="Create a schema to describe the entities your trackers share." />
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="SchemaCards" ItemsSource="{Binding Schemas}" AutomationProperties.Name="Schemas">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:SchemaCard}">
                                <Border Width="390" MinHeight="170" Margin="0,0,14,14" Padding="18"
                                        Style="{StaticResource EntityTrackerCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Row="1" Margin="0,12">
                                            <TextBlock Text="{Binding EntityCountText}" />
                                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       Text="{Binding UpdatedText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button Margin="0,0,8,0" Content="Open"
                                                    Command="{Binding DataContext.OpenSchemaCommand, ElementName=SchemasRoot}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Open schema {0}}"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                            <Button Click="OnSchemaActionsClick" ToolTip="Schema actions"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Actions for schema {0}}"
                                                    Style="{StaticResource SecondaryIconButtonStyle}">
                                                <controls:Icon IconKey="Icon.MoreHorizontal" Size="18" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Placement="Bottom">
                                                        <MenuItem Header="_Rename" Click="OnRenameSchema"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat=Rename schema {0}}" />
                                                        <MenuItem Header="Re_cycle" Click="OnRecycleSchema"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat=Recycle schema {0}}"
                                                                  Style="{StaticResource DangerMenuItemStyle}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The open schema, on its Entities or Dependency graph tab, with the selected entity's details
             beside it and the entity dialog over it. -->
        <Grid x:Name="SchemaEditorPage" DataContext="{Binding Editor}"
              Visibility="{Binding DataContext.IsEditing, ElementName=SchemasRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:PageHeader>
                <WrapPanel Style="{StaticResource PageToolbarStyle}">
                    <!-- The page's search, as on a Tracker's Overview: focused by Ctrl+F, with how many entities it
                         shows. The Dependency graph tab finds an entity the way a Tracker's graph does. -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding SearchResultText}" AutomationProperties.LiveSetting="Polite" />
                        <controls:Icon Margin="0,0,6,0" VerticalAlignment="Center" Size="16"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" IconKey="Icon.Search" />
                        <TextBox x:Name="SchemaSearchBox" Width="240" Margin="0,0,8,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="Search schema entities"
                                 AutomationProperties.HelpText="Search by entity name or group"
                                 controls:Placeholder.Text="Search entities (Ctrl+F)"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <controls:SuggestionComboBox x:Name="SchemaGraphSearchBox" DataContext="{Binding Graph}"
                                                 controls:Placeholder.Text="Find an entity (Ctrl+F)"
                                                 Width="240" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 AutomationProperties.Name="Find entity in schema graph"
                                                 AutomationProperties.HelpText="Type part of a name; use the arrow keys and Enter to choose."
                                                 IsEditable="True"
                                                 IsTextSearchEnabled="False"
                                                 Style="{StaticResource SuggestionComboBoxStyle}"
                                                 DisplayMemberPath="Label"
                                                 TextSearch.TextPath="Label"
                                                 ItemsSource="{Binding Suggestions}"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsDropDownOpen="{Binding IsSuggestionsOpen}"
                                                 ChooseCommand="{Binding ChooseSuggestionCommand}"
                                                 SubmitCommand="{Binding FindCommand}"
                                                 RefreshCommand="{Binding RefreshSuggestionsCommand}"
                                                 Visibility="{Binding DataContext.IsGraphView, ElementName=SchemaEditorPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="FitSchemaGraphButton" Margin="0,0,8,0" Command="{Binding Graph.FitToViewCommand}"
                            Content="Fit to view" Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="{Binding IsGraphView, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="NewSchemaEntityButton" Command="{Binding NewEntityCommand}" Content="New entity"
                            ToolTip="Add an entity to this schema"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </WrapPanel>
                <controls:PageHeader.Heading>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource PageHeadingTextStyle}">
                        <Hyperlink Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{x:Static viewModels:ShellDestination.ProjectDashboard}"
                                   AutomationProperties.HelpText="Go back to the project dashboard"
                                   ToolTip="Back to the project dashboard"
                                   Style="{StaticResource BreadcrumbLinkStyle}"><Run Text="{Binding DataContext.ProjectName, ElementName=SchemasRoot, Mode=OneWay}" /></Hyperlink>
                        <Run Foreground="{DynamicResource Brush.Text.Secondary}" Text=" › " />
                        <Hyperlink Command="{Binding DataContext.BackToListCommand, ElementName=SchemasRoot}"
                                   AutomationProperties.HelpText="Go back to the list of schemas"
                                   ToolTip="Back to the schemas"
                                   Style="{StaticResource BreadcrumbLinkStyle}"><Run Text="Schemas" /></Hyperlink>
                        <Run Foreground="{DynamicResource Brush.Text.Secondary}" Text=" › " />
                        <Run Text="{Binding SchemaName, Mode=OneWay}" />
                    </TextBlock>
                </controls:PageHeader.Heading>
            </controls:PageHeader>

            <!-- The schema's changes since its last push, and the push itself. -->
            <Border x:Name="SchemaPushBar" Grid.Row="1" Margin="0,0,0,12" Padding="14,10"
                    DataContext="{Binding Push}" Style="{StaticResource EntityTrackerCardStyle}"
                    Visibility="{Binding DataContext.HasPush, ElementName=SchemaEditorPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Button x:Name="PushSchemaButton" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"
                            Command="{Binding OpenReviewCommand}" Content="Push to trackers"
                            ToolTip="Review and apply the schema's changes to the trackers made from it" />
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Visibility="{Binding ShowSummaryOnly, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Expander x:Name="SchemaPendingChanges" Header="{Binding Summary}"
                                  AutomationProperties.Name="Changes not yet pushed"
                                  Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding PendingChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- The tabs only switch the view below them, so the details pane can start under them. -->
            <TabControl x:Name="SchemaViewTabs" Grid.Row="2" Margin="0,0,0,12"
                        Style="{StaticResource TextTabControlStyle}"
                        AutomationProperties.Name="Schema view"
                        ItemContainerStyle="{StaticResource TextTabItemStyle}"
                        SelectedIndex="{Binding SelectedViewIndex, Mode=TwoWay}">
                <TabItem x:Name="SchemaEntitiesTab" Header="Entities" />
                <TabItem x:Name="SchemaGraphTab" Header="Dependency graph" />
            </TabControl>

            <!-- Entities tab. -->
            <Grid Grid.Row="3" Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid x:Name="SchemaEntityGrid"
                          AutomationProperties.Name="Schema entities"
                          ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="2*" MinWidth="160" Binding="{Binding Name}" Header="Entity" />
                        <DataGridTextColumn Width="*" MinWidth="100" Binding="{Binding GroupDisplay}" Header="Group" />
                        <DataGridTextColumn Width="110" Binding="{Binding DependencyCount}" Header="Dependencies"
                                            ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="This schema has no entities yet. Use New entity to add the first one."
                           Visibility="{Binding ShowNoEntities, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel x:Name="SchemaNoMatches" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowNoMatches, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionHeadingTextStyle}" Text="No matching entities" />
                    <TextBlock Margin="0,4,0,12" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="No entity's name or group contains the search." />
                    <Button HorizontalAlignment="Center" Command="{Binding ClearSearchCommand}" Content="Clear search"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- Dependency graph tab. -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                    CornerRadius="6" ClipToBounds="True" DataContext="{Binding Graph}"
                    Visibility="{Binding DataContext.IsGraphView, ElementName=SchemaEditorPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <controls:DependencyGraphCanvas x:Name="SchemaGraphCanvas"
                                                    ShowStatus="False"
                                                    IsVisibleChanged="OnSchemaGraphVisibleChanged"
                                                    AutomationProperties.Name="Schema dependency graph"
                                                    AutomationProperties.HelpText="Click an entity to highlight its dependencies. Double-click or press Enter to show its details."
                                                    Graph="{Binding}"
                                                    Background="{DynamicResource Brush.Surface.Card}"
                                                    LabelBrush="{DynamicResource Brush.Text.Primary}"
                                                    EdgeBrush="{DynamicResource Brush.Border.Strong}"
                                                    HighlightBrush="{DynamicResource Brush.Text.Primary}"
                                                    SelectionBrush="{DynamicResource Brush.Graph.Selection}"
                                                    PlaceholderBrush="{DynamicResource Brush.Text.Secondary}"
                                                    CardBackground="{DynamicResource Brush.Surface.Page}" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="This schema has no entities yet. Use New entity to add the first one."
                               Visibility="{Binding DataContext.ShowNoEntities, ElementName=SchemaEditorPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <!-- The selected entity's details, read-only, over the right of either tab, as in a Tracker. -->
            <Border x:Name="SchemaEntityDetailsPane" Grid.Row="3" Width="400" Padding="20"
                    Panel.ZIndex="50" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    AutomationProperties.LiveSetting="Polite"
                    Background="{DynamicResource Brush.Surface.Page}"
                    BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="6"
                    DataContext="{Binding Details}" KeyDown="OnDetailsKeyDown"
                    Visibility="{Binding DataContext.IsDetailsOpen, ElementName=SchemaEditorPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource DetailsTitleTextStyle}"
                                   Text="{Binding Name}" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="EditSchemaEntityButton" Margin="8,0,8,0" Content="Edit"
                                    AutomationProperties.Name="{Binding Name, StringFormat=Edit entity {0}}"
                                    Command="{Binding DataContext.EditCommand, ElementName=SchemaEditorPage}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button x:Name="CloseSchemaEntityDetailsButton" Width="34" Height="34" Padding="0"
                                    AutomationProperties.Name="Close entity details"
                                    Command="{Binding DataContext.CloseDetailsCommand, ElementName=SchemaEditorPage}"
                                    Style="{StaticResource SecondaryButtonStyle}" ToolTip="Close details (Esc)">
                                <controls:Icon IconKey="Icon.Dismiss" Size="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Group" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding GroupDisplay}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Depends on" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource PageDescriptionTextStyle}" Text="No dependencies."
                                       Visibility="{Binding ShowNoDependsOn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl x:Name="SchemaEntityDependsOn" Margin="0,4,0,0" ItemsSource="{Binding DependsOn}"
                                          AutomationProperties.Name="Depends on">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Margin="0,2" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Used by" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource PageDescriptionTextStyle}" Text="No entity depends on it."
                                       Visibility="{Binding ShowNoUsedBy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl x:Name="SchemaEntityUsedBy" Margin="0,4,0,0" ItemsSource="{Binding UsedBy}"
                                          AutomationProperties.Name="Used by">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Margin="0,2" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- The push review: a dialog over the open schema, as large as the page allows. -->
            <controls:ModalDialog x:Name="SchemaPushReview" Grid.RowSpan="4" Panel.ZIndex="90" Size="Large"
                                  ScrollsBody="False" Title="Push to trackers" DataContext="{Binding Push}"
                                  IsOpen="{Binding IsReviewOpen, FallbackValue=False}"
                                  CancelCommand="{Binding CancelReviewCommand}">
                <controls:ModalDialog.Footer>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ApplyPushButton" Margin="0,0,8,0" Command="{Binding ApplyCommand}" Content="Push"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Command="{Binding CancelReviewCommand}" Content="Cancel" />
                    </StackPanel>
                </controls:ModalDialog.Footer>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock x:Name="SchemaPushIntro" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="These are the schema's changes since its last push that each tracker doesn't have yet. Choose Use schema to bring a change into the tracker, or Keep tracker to decline it. A change you leave undecided isn't pushed now and is offered again next time, so each tracker can be handled when it suits." />
                        <TextBlock x:Name="SchemaPushUntouched" Margin="0,6,0,0" Style="{StaticResource PageDescriptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="A push never changes statuses, notes, developers, priorities, due dates or Filter active." />
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding HasReviewChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Margin="0,0,8,0" Command="{Binding UseSchemaForAllCommand}" Content="Use schema for all" />
                            <Button Command="{Binding KeepTrackersForAllCommand}" Content="Keep trackers for all" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ReviewSummary}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <Border Margin="0,12,0,0" DockPanel.Dock="Bottom" Style="{StaticResource ErrorMessageStyle}"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock AutomationProperties.LiveSetting="Assertive" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </Border>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SchemaPushTrackers" ItemsSource="{Binding ReviewTrackers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" Style="{StaticResource EntityTrackerCardStyle}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button Margin="0,0,8,0" Command="{Binding UseSchemaForAllCommand}" Content="Use schema for all"
                                                            AutomationProperties.Name="{Binding TrackerName, StringFormat=Use the schema for all changes to {0}}" />
                                                    <Button Margin="0,0,8,0" Command="{Binding KeepTrackerForAllCommand}" Content="Keep tracker for all"
                                                            AutomationProperties.Name="{Binding TrackerName, StringFormat=Keep {0} for all changes}" />
                                                    <Button Command="{Binding DecideLaterCommand}" Content="Decide later"
                                                            ToolTip="Clear this tracker's choices, so it is left for a later push"
                                                            AutomationProperties.Name="{Binding TrackerName, StringFormat=Decide later for {0}}" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource SectionHeadingTextStyle}" Text="{Binding TrackerName}" />
                                                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                               Text="{Binding DecidedText}"
                                                               Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                               Text="Already up to date."
                                                               Visibility="{Binding IsUpToDate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Changes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,10,0,0">
                                                            <TextBlock TextWrapping="Wrap">
                                                                <Run Text="{Binding Description, Mode=OneWay}" />
                                                                <Run Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding ConflictNote, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                                <!-- Labels hold names that may contain "_", so they are plain text, not access keys. -->
                                                                <RadioButton Margin="0,0,18,0" GroupName="{Binding ChoiceGroup}"
                                                                             AutomationProperties.Name="{Binding UseSchemaLabel}"
                                                                             IsChecked="{Binding UseSchema, Mode=TwoWay}">
                                                                    <TextBlock Text="{Binding UseSchemaLabel}" />
                                                                </RadioButton>
                                                                <RadioButton GroupName="{Binding ChoiceGroup}"
                                                                             AutomationProperties.Name="{Binding KeepTrackerLabel}"
                                                                             IsChecked="{Binding KeepTracker, Mode=TwoWay}">
                                                                    <TextBlock Text="{Binding KeepTrackerLabel}" />
                                                                </RadioButton>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </controls:ModalDialog>
            <!-- The entity dialog, for New entity and Edit, as a Tracker's New entity dialog. -->
            <controls:ModalDialog x:Name="SchemaEntityDialog" Grid.RowSpan="4" Panel.ZIndex="100"
                                  ScrollsBody="False" DataContext="{Binding Form}"
                                  IsOpen="{Binding IsOpen}" Title="{Binding Title}"
                                  CancelCommand="{Binding CancelCommand}"
                                  InitialFocus="{Binding ElementName=SchemaEntityNameBox}">
                <controls:ModalDialog.DestructiveAction>
                    <Button Command="{Binding RequestRemoveCommand}" Content="Remove…"
                                        AutomationProperties.Name="Remove entity from the schema"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="{Binding IsExistingEntity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </controls:ModalDialog.DestructiveAction>
                <controls:ModalDialog.Footer>
                    <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SaveSchemaEntityButton" Margin="0,0,8,0" Command="{Binding SaveCommand}"
                                            Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button x:Name="CreateAnotherSchemaEntityButton" Margin="0,0,8,0"
                                            Command="{Binding CreateAnotherCommand}" Content="Create and add another"
                                            AutomationProperties.HelpText="Create this entity and keep the dialog open for the next one"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="{Binding IsNewEntity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Command="{Binding CancelCommand}" Content="Cancel"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </controls:ModalDialog.Footer>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Border Margin="0,0,0,12" Style="{StaticResource ErrorMessageStyle}"
                                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock AutomationProperties.LiveSetting="Assertive" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                            </Border>
                            <Border x:Name="SchemaRemoveConfirmation" Margin="0,0,0,12" Padding="12"
                                    Style="{StaticResource EntityTrackerCardStyle}"
                                    Visibility="{Binding IsRemoveConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding RemoveConfirmationText}" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Button Margin="0,0,8,0" Command="{Binding ConfirmRemoveCommand}" Content="Remove entity"
                                                Style="{StaticResource DangerButtonStyle}" />
                                        <Button Command="{Binding CancelRemoveCommand}" Content="Keep it"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                    </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Text="{Binding OperationMessage}"
                                           AutomationProperties.LiveSetting="Polite"
                                           Visibility="{Binding HasOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Label x:Name="SchemaEntityNameLabel" Padding="0,0,0,4" Content="_Name"
                                       Target="{Binding ElementName=SchemaEntityNameBox}" />
                                <TextBox x:Name="SchemaEntityNameBox"
                                         controls:Placeholder.Text="Name of the entity"
                                         AutomationProperties.LabeledBy="{Binding ElementName=SchemaEntityNameLabel}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <Label x:Name="SchemaEntityGroupLabel" Margin="0,12,0,0" Padding="0,0,0,4" Content="_Group"
                                       Target="{Binding ElementName=SchemaEntityGroupBox}" />
                                <TextBox x:Name="SchemaEntityGroupBox"
                                         controls:Placeholder.Text="Optional group, such as Sales"
                                         AutomationProperties.LabeledBy="{Binding ElementName=SchemaEntityGroupLabel}"
                                         Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="Depends on" />
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource PageDescriptionTextStyle}"
                                           Text="No dependencies."
                                           Visibility="{Binding ShowNoDependencies, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ItemsControl x:Name="SchemaEntityDependencies" ItemsSource="{Binding Dependencies}"
                                              AutomationProperties.Name="Dependencies">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" ToolTip="Remove this dependency"
                                                        AutomationProperties.Name="{Binding StringFormat=Remove dependency on {0}}"
                                                        Command="{Binding DataContext.RemoveDependencyCommand, ElementName=SchemaEntityDialog}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryIconButtonStyle}">
                                                    <controls:Icon IconKey="Icon.Dismiss" Size="14" />
                                                </Button>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding AddDependencyCommand}"
                                            IsDefault="{Binding IsKeyboardFocusWithin, ElementName=SchemaDependencyBox}">
                                        <TextBlock Text="{Binding AddDependencyLabel}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                    </Button>
                                    <ComboBox x:Name="SchemaDependencyBox" IsEditable="True" IsTextSearchEnabled="True"
                                              controls:Placeholder.Text="Entity name, new or existing"
                                              AutomationProperties.Name="Add a dependency"
                                              ItemsSource="{Binding DependencyChoices}"
                                              Text="{Binding NewDependencyText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource PageDescriptionTextStyle}"
                                           Text="{Binding NewDependencyNamesText}"
                                           Visibility="{Binding HasNewDependencyNames, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </ScrollViewer>
                </DockPanel>
            </controls:ModalDialog>
        </Grid>
    </Grid>
</UserControl>
