<UserControl x:Class="EntityTracker.Wpf.Views.HelpSqlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding Help.CopyQueryCommand}" Content="Copy query" Style="{StaticResource PrimaryButtonStyle}" />
            <StackPanel>
                <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="Help &amp; SQL" />
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Text="PostgreSQL extraction query and CSV contract." />
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" Margin="0,12" Text="{Binding Help.CopyMessage}" />
        <TextBox Grid.Row="2" FontFamily="Consolas" IsReadOnly="True" Text="{Binding Help.Query, Mode=OneWay}" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>
