<UserControl x:Class="EntityTracker.Wpf.Views.HelpSqlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Command="{Binding Help.BackToImportCommand}"
                        Content="Back to Schema synchronization"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Command="{Binding Help.CopyQueryCommand}"
                        Content="Copy query"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="Help &amp; SQL" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="PostgreSQL extraction query and CSV contract guidance." />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1"
                Margin="0,12"
                Padding="12"
                Background="{DynamicResource Brush.Surface.Selected}"
                BorderBrush="{DynamicResource Brush.Border.Medium}"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding Help.CsvContractVersion, StringFormat=PostgreSQL · CSV contract v{0}}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="The query targets the public schema by default. Change target_schema near the top when needed and keep all six column headers unchanged."
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="Export as UTF-8 CSV with a semicolon (;) delimiter and include the header row."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2"
                   Margin="0,0,0,8"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding Help.CopyMessage}" />
        <TextBox x:Name="QueryTextBox"
                 Grid.Row="3"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas"
                 IsReadOnly="True"
                 PreviewMouseWheel="OnQueryPreviewMouseWheel"
                 ScrollViewer.CanContentScroll="False"
                 Text="{Binding Help.Query, Mode=OneWay}"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>
