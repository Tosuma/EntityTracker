<UserControl x:Class="EntityTracker.Wpf.Views.ProjectMergeReviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls">
    <!-- Asked by a sync that found conflicting changes; the sync waits for the choices. Esc cancels the sync,
         as Cancel sync does. The control's DataContext is InAppDialogs; the dialog's is the review. -->
    <controls:ModalDialog x:Name="Dialog" UsesStrongScrim="True" Size="Large" ScrollsBody="False"
                          Title="Review Project merge conflicts"
                          Description="Choose which version to keep for every conflict. Nothing is applied until all choices are reviewed."
                          IsOpen="{Binding DataContext.IsMergeReviewOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DataContext="{Binding MergeReview}"
                          InitialFocus="{Binding ElementName=ChooseLocalButton}"
                          CancelRequested="OnCancel">
        <controls:ModalDialog.Footer>
            <StackPanel Orientation="Horizontal">
                <Button Margin="0,0,8,0" Content="Apply choices" IsDefault="True" MinWidth="105"
                        IsEnabled="{Binding AllResolved}" Click="OnApply"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.HelpText="Apply all reviewed merge choices" />
                <Button x:Name="CancelButton" Content="Cancel sync" MinWidth="105" Click="OnCancel"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </controls:ModalDialog.Footer>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14" Orientation="Horizontal">
                <Button x:Name="ChooseLocalButton" Content="Choose local for all" Click="OnChooseLocal"
                        AutomationProperties.Name="Choose local for all conflicts" />
                <Button Margin="8,0,0,0" Content="Choose remote for all" Click="OnChooseRemote"
                        AutomationProperties.Name="Choose remote for all conflicts" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="12" BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    Background="{DynamicResource Brush.Surface.Card}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"
                                               AutomationProperties.HeadingLevel="Level3" />
                                    <TextBlock Margin="0,2,0,8" Text="{Binding Kind}" />
                                    <TextBlock FontWeight="SemiBold" Text="Base" />
                                    <TextBox Text="{Binding BaseValue, Mode=OneWay}" IsReadOnly="True"
                                             TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="False"
                                             AutomationProperties.Name="{Binding BaseAutomationName}" />
                                    <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="Local" />
                                    <TextBox Text="{Binding LocalValue, Mode=OneWay}" IsReadOnly="True"
                                             TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="False"
                                             AutomationProperties.Name="{Binding LocalAutomationName}" />
                                    <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="Remote" />
                                    <TextBox Text="{Binding RemoteValue, Mode=OneWay}" IsReadOnly="True"
                                             TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="False"
                                             AutomationProperties.Name="{Binding RemoteAutomationName}" />
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <RadioButton Content="Keep local" GroupName="{Binding Path}"
                                                     IsChecked="{Binding IsLocal, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding KeepLocalAutomationName}" />
                                        <RadioButton Margin="16,0,0,0" Content="Keep remote"
                                                     GroupName="{Binding Path}" IsChecked="{Binding IsRemote, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding KeepRemoteAutomationName}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </controls:ModalDialog>
</UserControl>
