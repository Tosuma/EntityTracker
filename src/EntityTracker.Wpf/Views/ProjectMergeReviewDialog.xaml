<UserControl x:Class="EntityTracker.Wpf.Views.ProjectMergeReviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Asked by a sync that found conflicting changes; the sync waits for the choices. Esc cancels the sync,
         as Cancel sync does. The control's DataContext is InAppDialogs; the dialog's is the review. -->
    <controls:ModalDialog x:Name="Dialog" UsesStrongScrim="True" Size="Large" ScrollsBody="False"
                          Title="Review Project merge conflicts"
                          Description="This computer and the repository both changed the same things. Choose which version to keep for each; nothing is applied until every one is chosen."
                          IsOpen="{Binding DataContext.IsMergeReviewOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DataContext="{Binding MergeReview}"
                          InitialFocus="{Binding ElementName=ChooseLocalButton}"
                          CancelRequested="OnCancel">
        <controls:ModalDialog.Footer>
            <StackPanel Orientation="Horizontal">
                <Button Margin="0,0,8,0" Content="Apply choices" IsDefault="True" MinWidth="105"
                        IsEnabled="{Binding AllResolved}" Click="OnApply"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.HelpText="Apply all reviewed merge choices" />
                <Button x:Name="CancelButton" Content="Cancel sync" MinWidth="105" Click="OnCancel"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </controls:ModalDialog.Footer>
        <DockPanel>
            <!-- The layout push review shares: what is decided, the "for all" actions, then one card per
                 conflict with the difference as a sentence and the values in the choices. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ChooseLocalButton" Margin="0,0,8,0" Content="Keep this computer's for all"
                            Click="OnChooseLocal" AutomationProperties.Name="Keep this computer's version of every conflict" />
                    <Button Content="Keep the repository's for all" Click="OnChooseRemote"
                            AutomationProperties.Name="Keep the repository's version of every conflict" />
                </StackPanel>
                <TextBlock x:Name="MergeReviewSummary" Style="{StaticResource ReviewSummaryTextStyle}" Text="{Binding Summary}" />
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ReviewItemCardStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"
                                               AutomationProperties.HeadingLevel="Level3" />
                                    <TextBlock Style="{StaticResource ReviewSentenceTextStyle}" Text="{Binding Description}" />
                                    <!-- What it was before, only when there was something to change. -->
                                    <StackPanel Margin="0,6,0,0"
                                                Visibility="{Binding HasBase, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Before:" />
                                        <TextBox Margin="0,4,0,0" Text="{Binding BaseValue, Mode=OneWay}" IsReadOnly="True"
                                                 TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.CanContentScroll="False"
                                                 AutomationProperties.Name="{Binding BaseAutomationName}" />
                                    </StackPanel>
                                    <RadioButton Style="{StaticResource ReviewChoiceStyle}" Margin="0,10,0,0"
                                                 Content="Keep this computer's" GroupName="{Binding Path}"
                                                 IsChecked="{Binding IsLocal, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding KeepLocalAutomationName}" />
                                    <TextBox Margin="28,4,0,0" Text="{Binding LocalValue, Mode=OneWay}" IsReadOnly="True"
                                                 TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.CanContentScroll="False"
                                                 AutomationProperties.Name="{Binding LocalAutomationName}" />
                                    <RadioButton Style="{StaticResource ReviewChoiceStyle}" Margin="0,10,0,0"
                                                 Content="Keep the repository's" GroupName="{Binding Path}"
                                                 IsChecked="{Binding IsRemote, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding KeepRemoteAutomationName}" />
                                    <TextBox Margin="28,4,0,0" Text="{Binding RemoteValue, Mode=OneWay}" IsReadOnly="True"
                                                 TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.CanContentScroll="False"
                                                 AutomationProperties.Name="{Binding RemoteAutomationName}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </controls:ModalDialog>
</UserControl>
