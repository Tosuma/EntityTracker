<UserControl x:Class="EntityTracker.Wpf.Views.AggregateProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <StackPanel controls:ChartThemeFollower.Target="{Binding}">
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Margin="0,0,7,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="History" />
                <ComboBox MinWidth="145"
                          AutomationProperties.Name="Aggregate progress history range"
                          DisplayMemberPath="DisplayName"
                          ItemsSource="{Binding RangeOptions}"
                          SelectedValue="{Binding SelectedRange}"
                          SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Aggregate progress" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="Entity-weighted status and persisted implementation history." />
            </StackPanel>
        </DockPanel>

        <Border Margin="0,0,0,12"
                Padding="12"
                Style="{StaticResource EntityTrackerCardStyle}"
                Visibility="{Binding IsCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Text="From" />
                    <DatePicker Width="145"
                                AutomationProperties.Name="Aggregate history from date"
                                SelectedDate="{Binding CustomFrom}" />
                    <TextBlock Margin="14,0,7,0" VerticalAlignment="Center" Text="To" />
                    <DatePicker Width="145"
                                AutomationProperties.Name="Aggregate history to date"
                                SelectedDate="{Binding CustomTo}" />
                    <Button Margin="12,0,0,0"
                            Command="{Binding ApplyRangeCommand}"
                            Content="Apply range"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <TextBlock Margin="0,7,0,0"
                           Foreground="{DynamicResource Brush.Critical}"
                           Text="{Binding RangeValidationMessage}"
                           Visibility="{Binding HasRangeValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <Border Margin="0,0,0,12"
                Padding="14"
                Style="{StaticResource EntityTrackerCardStyle}"
                Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Each count shows its status colour as a bar along its left edge. Active is no status, so it
                 has none. Waiting on dependencies and Blocked are different counts: one waits on another
                 entity, the other was set to Blocked by hand. -->
            <UniformGrid Columns="6" controls:Layout.CompactColumns="3">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="5" Margin="0,0,10,0" RadiusX="2.5" RadiusY="2.5" Fill="Transparent" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Active" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Report.ManagerSummary.ActiveEntityCount}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="5" Margin="0,0,10,0" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Brush.Status.DevelopmentCompleted}" />
                    <!-- Implemented explains itself: its parts as a bar, and their counts on hover. -->
                    <StackPanel Grid.Column="1" Background="Transparent">
                        <StackPanel.ToolTip>
                            <controls:ImplementedBreakdown Completed="{Binding Report.ManagerSummary.DevelopmentCompletedEntityCount}"
                                                           Reconciled="{Binding Report.ManagerSummary.ReconciledEntityCount}"
                                                           ReworkNeeded="{Binding Report.ManagerSummary.ReworkNeededEntityCount}"
                                                           Reworking="{Binding Report.ManagerSummary.ReworkingEntityCount}" />
                        </StackPanel.ToolTip>
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Implemented" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Report.ManagerSummary.ImplementedEntityCount}" />
                        <controls:ImplementedComposition Width="120" Margin="0,4,0,0" HorizontalAlignment="Left" Completed="{Binding Report.ManagerSummary.DevelopmentCompletedEntityCount}"
                                                         Reconciled="{Binding Report.ManagerSummary.ReconciledEntityCount}"
                                                         ReworkNeeded="{Binding Report.ManagerSummary.ReworkNeededEntityCount}"
                                                         Reworking="{Binding Report.ManagerSummary.ReworkingEntityCount}"
                                                         Total="{Binding Report.ManagerSummary.ActiveEntityCount}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="5" Margin="0,0,10,0" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Brush.Status.Reconciled}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Reconciled" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Report.ManagerSummary.ReconciledEntityCount}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="5" Margin="0,0,10,0" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Brush.WorkStatus.Ready}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Ready" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Report.ManagerSummary.ReadyEntityCount}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="5" Margin="0,0,10,0" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Brush.WorkStatus.WaitingOnDependencies}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Waiting on dependencies"
                                       TextTrimming="CharacterEllipsis" ToolTip="Waiting on dependencies" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Report.ManagerSummary.WaitingOnDependenciesEntityCount}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="5" Margin="0,0,10,0" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Brush.Status.Blocked}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Blocked" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Report.ManagerSummary.ManuallyBlockedEntityCount}" />
                    </StackPanel>
                </Grid>
            </UniformGrid>
        </Border>

        <TextBlock Margin="0,8,0,12"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="No persisted progress history is available in this range."
                   Visibility="{Binding ShowNoHistoricalData, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid controls:Layout.StackWhenCompact="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Height="280" Padding="12" Style="{StaticResource EntityTrackerCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold"
                               Text="Entities by development status" />
                    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Card}">
                        <lvc:PieChart Background="Transparent" LegendTextPaint="{Binding Presentation.LegendTextPaint}" TooltipTextPaint="{Binding Presentation.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Presentation.TooltipBackgroundPaint}" AutomationProperties.Name="Aggregate entities by development status chart"
                                      LegendPosition="Right"
                                      Series="{Binding CurrentStatusSeries}" />
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Height="280" Padding="12" Style="{StaticResource EntityTrackerCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold"
                               Text="Implemented entities over time" />
                    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Card}">
                        <lvc:CartesianChart Background="Transparent" LegendTextPaint="{Binding Presentation.LegendTextPaint}" TooltipTextPaint="{Binding Presentation.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Presentation.TooltipBackgroundPaint}" AutomationProperties.Name="Aggregate implemented entities over time chart"
                                            LegendPosition="Top"
                                            Series="{Binding ImplementedSeries}"
                                            TooltipPosition="Top"
                                            XAxes="{Binding ImplementedXAxes}"
                                            YAxes="{Binding CountYAxes}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
