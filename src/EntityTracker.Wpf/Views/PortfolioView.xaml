<UserControl x:Class="EntityTracker.Wpf.Views.PortfolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EntityTracker.Wpf.Views">
    <Grid ClipToBounds="True">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  ScrollChanged="OnPortfolioScrollChanged">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Click="OnImportProject" Content="Import Project"
                            AutomationProperties.Name="Import Project from existing Git checkout"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="0,0,8,0" Click="OnOpenRecycleBins" Content="Recycle bins"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Click="OnCreateProject" Content="Create project"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="Portfolio" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource PageDescriptionTextStyle}"
                               Text="Entity-weighted progress across active projects and trackers." />
                </StackPanel>
            </DockPanel>

            <Border Margin="0,0,0,12" MaxHeight="120" Style="{StaticResource ErrorMessageStyle}"
                    Visibility="{Binding PortfolioReporting.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock AutomationProperties.LiveSetting="Assertive" Text="{Binding PortfolioReporting.ErrorMessage}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
            <Border Margin="0,0,0,12" Style="{StaticResource InfoMessageStyle}"
                    Visibility="{Binding PortfolioReporting.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="Loading Portfolio…" />
            </Border>

            <ItemsControl ItemsSource="{Binding PendingProjectDeletions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="14" Style="{StaticResource EntityTrackerCardStyle}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Publish deletion"
                                        Click="OnPublishDeletion"
                                        AutomationProperties.Name="Publish pending Project deletion"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Project deletion pending publication" />
                                    <TextBlock Text="{Binding ProjectId}" />
                                    <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,0,0,10" FontSize="20" FontWeight="SemiBold" Text="Projects" />
            <Border Margin="0,0,0,16" Padding="20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EntityTrackerCardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PortfolioReporting.HasProjects}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="No active projects" />
                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Create a project to organize related implementation trackers."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding PortfolioReporting.Dashboard.Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="390" MinHeight="280" Margin="0,0,14,14" Padding="18"
                                Style="{StaticResource EntityTrackerCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="1" Margin="0,14">
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,10">
                                            <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Trackers" />
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ActiveTrackerCount}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Active entities" />
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Progress.ActiveEntityCount}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,10">
                                            <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Implemented" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Progress.ImplementedProgressText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Reconciled" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Progress.ReconciledProgressText}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding Progress.ReadyCount, StringFormat={}{0} ready to start}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Progress.BlockedCount, StringFormat={}{0} waiting on dependencies}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Progress.ManuallyBlockedCount, StringFormat={}{0} blocked}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Progress.ReworkNeededCount, StringFormat={}{0} rework needed}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Progress.ReworkingCount, StringFormat={}{0} reworking}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Progress.UnresolvedReferenceCount, StringFormat={}{0} unresolved references}" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding Progress.LastActivityText}" />
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Margin="0,0,8,0" Click="OnOpenProject" Content="Open dashboard"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Open project {0}}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <ToggleButton Grid.Column="1" Content="☰" Padding="12,5"
                                                  MinHeight="{DynamicResource Height.Control}"
                                                  ToolTip="Project actions"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Actions for project {0}}"
                                                  AutomationProperties.HelpText="Show project actions"
                                                  Checked="OnProjectActionsChecked"
                                                  Unchecked="OnProjectActionsUnchecked" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <views:AggregateProgressView Margin="0,8,0,22"
                                         DataContext="{Binding PortfolioReporting.Progress}" />
        </StackPanel>
    </ScrollViewer>
    <Canvas x:Name="ProjectActionLayer" Panel.ZIndex="1" ClipToBounds="True"
            SizeChanged="OnProjectActionLayerSizeChanged">
        <Border x:Name="ProjectActionsMenu" MinWidth="190" Padding="8"
                Background="{DynamicResource Brush.Surface.Page}"
                BorderBrush="{DynamicResource Brush.Border.Medium}"
                BorderThickness="1" CornerRadius="0,0,6,6"
                Visibility="Collapsed"
                PreviewKeyDown="OnProjectActionsPreviewKeyDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.16" ShadowDepth="2" />
            </Border.Effect>
            <StackPanel>
                <Button x:Name="RenameProjectAction" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="OnRenameProject" Content="Rename"
                        AutomationProperties.Name="{Binding Name, StringFormat=Rename project {0}}" />
                <Button x:Name="RecycleProjectAction" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnRecycleProject" Content="Recycle"
                        AutomationProperties.Name="{Binding Name, StringFormat=Recycle project {0}}"
                        Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
        </Border>
    </Canvas>
    </Grid>
</UserControl>
