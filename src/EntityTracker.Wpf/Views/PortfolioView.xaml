<UserControl x:Class="EntityTracker.Wpf.Views.PortfolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:EntityTracker.Domain;assembly=EntityTracker.Domain">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Click="OnOpenRecycleBins"
                            Content="Recycle bins"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Click="OnCreateProject"
                            Content="Create project"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="Portfolio" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Active projects and their entity-weighted implementation progress." />
                </StackPanel>
            </DockPanel>

            <Border Margin="0,0,0,16"
                    Padding="20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EntityTrackerCardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPortfolioProjects}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="No active projects" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Create a project to organize related implementation trackers."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Portfolio.Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="380"
                                MinHeight="180"
                                Margin="0,0,14,14"
                                Padding="18"
                                Background="{DynamicResource Brush.Surface.Card}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="1" Margin="0,14">
                                    <TextBlock Text="{Binding ActiveTrackerCount, StringFormat={}{0} active tracker(s)}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ActiveEntityCount, StringFormat={}{0} active entities}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ImplementedEntityCount, StringFormat={}{0} implemented}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding Progress.ImplementedProgressText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Click="OnOpenProject"
                                            Content="Open dashboard"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Margin="0,0,8,0" Click="OnRenameProject" Content="Rename" />
                                    <Button Click="OnRecycleProject" Content="Recycle" Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
