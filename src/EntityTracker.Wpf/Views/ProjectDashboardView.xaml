<UserControl x:Class="EntityTracker.Wpf.Views.ProjectDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Click="OnRenameProject" Content="Rename project" />
                    <Button Margin="0,0,8,0" Click="OnOpenRecycleBin" Content="Tracker recycle bin" />
                    <Button Click="OnCreateTracker" Content="Create tracker" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="{Binding ProjectDashboard.Project.Name}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Trackers, progress, and work needing attention." />
                </StackPanel>
            </DockPanel>

            <Border Margin="0,0,0,16" Padding="14" Style="{StaticResource EntityTrackerCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,24,0" Text="{Binding ProjectDashboard.Progress.ActiveEntityCount, StringFormat={}{0} active entities}" />
                    <TextBlock Margin="0,0,24,0" Text="{Binding ProjectDashboard.Progress.ImplementedEntityCount, StringFormat={}{0} implemented}" />
                    <TextBlock Margin="0,0,24,0" Text="{Binding ProjectDashboard.Progress.BlockedCount, StringFormat={}{0} blocked}" />
                    <TextBlock Text="{Binding ProjectDashboard.Progress.ReworkNeededCount, StringFormat={}{0} rework}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,16" Padding="20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EntityTrackerCardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProjectTrackers}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="No active trackers" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Create a blank tracker, review a complete CSV, or copy an existing tracker."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding ProjectDashboard.Trackers}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="390" MinHeight="210" Margin="0,0,14,14" Padding="18" Style="{StaticResource EntityTrackerCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="1" Margin="0,12">
                                    <TextBlock Text="{Binding Progress.ActiveEntityCount, StringFormat={}{0} active entities}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ImplementedEntityCount, StringFormat={}{0} implemented}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding Progress.ImplementedProgressText}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.BlockedCount, StringFormat={}{0} blocked}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ReworkNeededCount, StringFormat={}{0} rework needed}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.DependencyIssueCount, StringFormat={}{0} dependency issues}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Click="OnOpenTracker" Content="Open" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Margin="0,0,8,0" Click="OnRenameTracker" Content="Rename" />
                                    <Button Click="OnRecycleTracker" Content="Recycle" Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
