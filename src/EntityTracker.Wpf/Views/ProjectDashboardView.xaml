<UserControl x:Class="EntityTracker.Wpf.Views.ProjectDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:EntityTracker.Domain;assembly=EntityTracker.Domain"
             xmlns:projects="clr-namespace:EntityTracker.Application.Projects;assembly=EntityTracker.Application"
             xmlns:workflow="clr-namespace:EntityTracker.Application.Workflow;assembly=EntityTracker.Application"
             xmlns:views="clr-namespace:EntityTracker.Wpf.Views">
    <UserControl.Resources>
        <Style x:Key="ComparisonFilterButtonStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                <Setter TargetName="Card" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ComparisonDevelopmentStatusBadgeTemplate">
            <Border x:Name="Badge"
                    Padding="8,3"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Brush.Status.NotStarted}"
                    CornerRadius="10">
                <TextBlock x:Name="BadgeText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Brand.DarkGreen}"
                           Text="Not started" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="1" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Not present" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.InProgress}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.InProgress}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Text.OnDark}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="In progress" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.ReworkNeeded}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.ReworkNeeded}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Rework needed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.DevelopmentCompleted}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.DevelopmentCompleted}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Dev. completed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.Reconciled}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.Reconciled}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Text.OnDark}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Reconciled" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ComparisonWorkStatusBadgeTemplate">
            <Border x:Name="Badge" Margin="0,4,0,0" Padding="8,3"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Brush.Surface.Subtle}"
                    BorderBrush="{DynamicResource Brush.Border.Medium}"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBlock x:Name="BadgeText" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static workflow:EntityWorkflowState.Ready}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.Ready}" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="0" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Text.OnDark}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Ready" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static workflow:EntityWorkflowState.Blocked}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.Blocked}" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="0" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Brand.DarkGreen}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Blocked" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static workflow:EntityWorkflowState.InProgress}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.InProgress}" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="0" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Text.OnDark}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="In progress" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static workflow:EntityWorkflowState.ReworkNeeded}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.ReworkNeeded}" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="0" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Brand.DarkGreen}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Rework needed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static workflow:EntityWorkflowState.DevelopmentCompleted}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.DevelopmentCompleted}" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="0" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Brand.DarkGreen}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Dev. completed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static workflow:EntityWorkflowState.Reconciled}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.Reconciled}" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="0" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Text.OnDark}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Reconciled" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ComparisonCellTemplate">
            <Button MinWidth="155"
                    MinHeight="72"
                    Padding="10,7"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Top"
                    AutomationProperties.Name="{Binding AutomationName}"
                    Click="OnOpenComparisonCell"
                    IsEnabled="{Binding IsPresent}"
                    Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel>
                    <ContentControl Content="{Binding Model.DevelopmentStatus}"
                                    ContentTemplate="{StaticResource ComparisonDevelopmentStatusBadgeTemplate}" />
                    <ContentControl Content="{Binding Model.WorkStatus}"
                                    ContentTemplate="{StaticResource ComparisonWorkStatusBadgeTemplate}"
                                    Visibility="{Binding IsPresent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Status.ReworkNeeded}"
                               Text="{Binding IssueText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding IssueText}"
                               Visibility="{Binding HasIssues, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Click="OnRenameProject" Content="Rename project"
                            IsEnabled="{Binding CanUseActiveRepository}" />
                    <Button Margin="0,0,8,0" Click="OnOpenRecycleBin" Content="Tracker recycle bin"
                            IsEnabled="{Binding CanUseActiveRepository}" />
                    <Button Click="OnCreateTracker" Content="Create tracker"
                            IsEnabled="{Binding CanUseActiveRepository}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageHeadingTextStyle}"
                               Text="{Binding SelectedProject.Name}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource PageDescriptionTextStyle}"
                               Text="Aggregate progress, comparable trackers, and entity-level differences." />
                </StackPanel>
            </DockPanel>

            <Border Margin="0,0,0,12" Padding="16" Style="{StaticResource EntityTrackerCardStyle}">
                <StackPanel>
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   FontWeight="SemiBold" Text="{Binding RepositoryStatusText}" />
                        <TextBlock Margin="0,5,16,0"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding RepositoryStatusDetails}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasRepositoryStatusDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,5,16,0"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="A local repository is optional. Changes are committed locally; only an explicit Sync contacts a configured upstream."
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,16,0"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding SyncDisabledReason}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasSyncDisabledReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                AutomationProperties.HelpText="Fetch, fast-forward, or push the configured upstream for this Project."
                                AutomationProperties.Name="Synchronize project repository"
                                Click="OnSyncRepository"
                                Content="Sync"
                                IsEnabled="{Binding CanSyncRepository}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding ShowSyncRepository, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Click="OnLinkRepository" Content="Link repository"
                                AutomationProperties.HelpText="Link this Project to an existing empty Git repository."
                                Visibility="{Binding CanLinkRepository, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Click="OnLocateRepository" Content="Locate repository"
                                AutomationProperties.HelpText="Locate the registered repository after its folder moved."
                                Visibility="{Binding CanLocateRepository, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Click="OnRebuildRepositoryCache" Content="Rebuild cache"
                                AutomationProperties.HelpText="Replace this Project's SQLite cache from repository HEAD."
                                Visibility="{Binding CanRebuildRepositoryCache, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding CanUseActiveRepository, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Margin="0,0,0,12" MaxHeight="120" Style="{StaticResource ErrorMessageStyle}"
                    Visibility="{Binding ProjectReporting.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock AutomationProperties.LiveSetting="Assertive" Text="{Binding ProjectReporting.ErrorMessage}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
            <Border Margin="0,0,0,12" Style="{StaticResource InfoMessageStyle}"
                    Visibility="{Binding ProjectReporting.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="Loading Project dashboard…" />
            </Border>

            <TextBlock Margin="0,0,0,10" FontSize="20" FontWeight="SemiBold" Text="Trackers" />
            <Border Margin="0,0,0,16" Padding="20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EntityTrackerCardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProjectReporting.HasTrackers}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="No active trackers" />
                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Create a blank tracker, review a complete CSV, or copy an existing tracker."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding ProjectReporting.Dashboard.Trackers}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="390" MinHeight="285" Margin="0,0,14,14" Padding="18"
                                Style="{StaticResource EntityTrackerCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="1" Margin="0,12">
                                    <TextBlock Text="{Binding Progress.ActiveEntityCount, StringFormat={}{0} active entities}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ImplementedProgressText}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ReconciledProgressText}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ReadyCount, StringFormat={}{0} ready}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.BlockedCount, StringFormat={}{0} blocked}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ReworkNeededCount, StringFormat={}{0} rework needed}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.UnresolvedReferenceCount, StringFormat={}{0} unresolved references}" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding Progress.LastActivityText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Click="OnOpenTracker" Content="Open"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Open tracker {0}}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Margin="0,0,8,0" Click="OnRenameTracker" Content="Rename"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Rename tracker {0}}" />
                                    <Button Click="OnRecycleTracker" Content="Recycle"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Recycle tracker {0}}"
                                            Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <views:AggregateProgressView Margin="0,8,0,22"
                                         DataContext="{Binding ProjectReporting.Progress}" />

            <Border Margin="0,8,0,0" Padding="16" Style="{StaticResource EntityTrackerCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <CheckBox DockPanel.Dock="Right"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Show all entities in project comparison"
                                  Content="Show all"
                                  IsChecked="{Binding ProjectReporting.ShowAllEntities}" />
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Entity comparison" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="{Binding ProjectReporting.ComparisonSummary}" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Margin="0,0,0,8">
                        <ToggleButton AutomationProperties.Name="Filter comparison to missing entities"
                                IsChecked="{Binding ProjectReporting.IsMissingSelected, Mode=OneWay}"
                                ToolTip="Filter to missing entities. Unavailable when the count is zero."
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.Missing}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ComparisonFilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsMissingSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Green100}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel>
                                <TextBlock Text="Missing" />
                                <TextBlock Margin="0,2,0,0" FontSize="18" FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.MissingCount}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton AutomationProperties.Name="Filter comparison to divergent entities"
                                IsChecked="{Binding ProjectReporting.IsDivergentSelected, Mode=OneWay}"
                                ToolTip="Filter to divergent entities. Unavailable when the count is zero."
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.Divergent}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ComparisonFilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsDivergentSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Green100}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel>
                                <TextBlock Text="Divergent" />
                                <TextBlock Margin="0,2,0,0" FontSize="18" FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.DivergentCount}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton AutomationProperties.Name="Filter comparison to blocked entities"
                                IsChecked="{Binding ProjectReporting.IsBlockedSelected, Mode=OneWay}"
                                ToolTip="Filter to blocked entities. Unavailable when the count is zero."
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.Blocked}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ComparisonFilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsBlockedSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Status.Blocked}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.ReworkNeeded}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Brand.DarkGreen}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel>
                                <TextBlock Text="Blocked" />
                                <TextBlock Margin="0,2,0,0" FontSize="18" FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.BlockedCount}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton AutomationProperties.Name="Filter comparison to rework entities"
                                IsChecked="{Binding ProjectReporting.IsReworkSelected, Mode=OneWay}"
                                ToolTip="Filter to Rework needed entities. Unavailable when the count is zero."
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.ReworkNeeded}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ComparisonFilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsReworkSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Status.ReworkNeeded}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.ReworkNeeded}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Brand.DarkGreen}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel>
                                <TextBlock Text="Rework" />
                                <TextBlock Margin="0,2,0,0" FontSize="18" FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.ReworkCount}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton AutomationProperties.Name="Filter comparison to unresolved entities"
                                IsChecked="{Binding ProjectReporting.IsUnresolvedSelected, Mode=OneWay}"
                                ToolTip="Filter to unresolved entities. Unavailable when the count is zero."
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.Unresolved}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ComparisonFilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsUnresolvedSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Alert}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.ReworkNeeded}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel>
                                <TextBlock Text="Unresolved" />
                                <TextBlock Margin="0,2,0,0" FontSize="18" FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.UnresolvedCount}" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Margin="0,0,8,8"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Clear comparison category filter"
                                Command="{Binding ProjectReporting.ClearCategoryCommand}"
                                Content="Clear filter"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding ProjectReporting.HasCategoryFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>

                    <TextBlock Margin="0,8"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="These trackers have no active entities to compare."
                               Visibility="{Binding ProjectReporting.ShowNoComparisonEntities, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Margin="0,8"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ProjectReporting.ShowNoActionableRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"
                                   Text="{Binding ProjectReporting.ComparisonEmptyTitle}" />
                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding ProjectReporting.ComparisonEmptyHint}" />
                    </StackPanel>

                    <DataGrid x:Name="ComparisonGrid"
                              Height="470"
                              AutomationProperties.Name="Project entity comparison"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              FrozenColumnCount="1"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding ProjectReporting.ComparisonRows}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="CellOrRowHeader"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Entity"
                                                Binding="{Binding DisplayName}"
                                                IsReadOnly="True"
                                                MinWidth="180"
                                                Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
