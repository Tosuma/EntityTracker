<UserControl x:Class="EntityTracker.Wpf.Views.ProjectDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls"
             xmlns:domain="clr-namespace:EntityTracker.Domain;assembly=EntityTracker.Domain"
             xmlns:projects="clr-namespace:EntityTracker.Application.Projects;assembly=EntityTracker.Application"
             xmlns:workflow="clr-namespace:EntityTracker.Application.Workflow;assembly=EntityTracker.Application"
             xmlns:viewModels="clr-namespace:EntityTracker.Wpf.ViewModels"
             xmlns:views="clr-namespace:EntityTracker.Wpf.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="ComparisonDevelopmentStatusBadgeTemplate">
            <!-- A hollow status (Not relevant) has no fill: a dashed edge is drawn over the badge,
                 as a Border can't be dashed. -->
            <Grid HorizontalAlignment="Left">
                <Border x:Name="Badge"
                        Padding="12,5"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Status.NotStarted}"
                        CornerRadius="10">
                    <TextBlock x:Name="BadgeText"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Status.NotStarted.Text}"
                               Text="Not started" />
                </Border>
                <Rectangle x:Name="HollowEdge" RadiusX="10" RadiusY="10" StrokeThickness="1"
                           StrokeDashArray="3 2" Visibility="Collapsed"
                           Stroke="{DynamicResource Brush.Status.NotRelevant.Edge}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                    <Setter TargetName="Badge" Property="BorderThickness" Value="1" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Not present" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.InProgress}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.InProgress}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.InProgress.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="In progress" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.ReworkNeeded}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.ReworkNeeded}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.ReworkNeeded.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Rework needed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.Reworking}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.Reworking}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.Reworking.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Reworking" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.Blocked}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.Blocked}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.Blocked.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Blocked" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.DevelopmentCompleted}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.DevelopmentCompleted}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.DevelopmentCompleted.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Completed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.Reconciled}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.Reconciled}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.Reconciled.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Reconciled" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.NotRelevant}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.NotRelevant}" />
                    <Setter TargetName="HollowEdge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.NotRelevant.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Not relevant" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ComparisonWorkStatusBadgeTemplate">
            <!-- A hollow status (Not relevant) has no fill: a dashed edge is drawn over the badge,
                 as a Border can't be dashed. -->
            <Grid HorizontalAlignment="Left">
                <Border x:Name="Badge" Margin="0,4,0,0" Padding="12,5"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Surface.Subtle}"
                        CornerRadius="10">
                    <TextBlock x:Name="BadgeText" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </Border>
                <Rectangle x:Name="HollowEdge" RadiusX="10" RadiusY="10" StrokeThickness="1"
                           StrokeDashArray="3 2" Visibility="Collapsed"
                           Stroke="{DynamicResource Brush.WorkStatus.NotRelevant.Edge}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.Ready}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.Ready}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.Ready.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Ready" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.Blocked}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.Blocked}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.Blocked.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Blocked" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.WaitingOnDependencies}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.WaitingOnDependencies}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.WaitingOnDependencies.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Waiting on dependencies" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.InProgress}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.InProgress}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.InProgress.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="In progress" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.Completed}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.Completed}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.Completed.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Completed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.Reconciled}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.Reconciled}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.Reconciled.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Reconciled" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.NotRelevant}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.NotRelevant}" />
                    <Setter TargetName="HollowEdge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.NotRelevant.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Not relevant" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ComparisonCellTemplate">
            <Button MinWidth="195"
                    MinHeight="72"
                    Padding="10,7"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Top"
                    AutomationProperties.Name="{Binding AutomationName}"
                    Click="OnOpenComparisonCell"
                    IsEnabled="{Binding IsPresent}"
                    Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel>
                    <!-- Captioned, since both badges can show the same word (Reconciled, In progress). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Normal"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Text="Dev" ToolTip="Development status" />
                        <ContentControl Grid.Column="1" Content="{Binding Model.DevelopmentStatus}"
                                        ContentTemplate="{StaticResource ComparisonDevelopmentStatusBadgeTemplate}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="11" FontWeight="Normal"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Text="Work" ToolTip="Work status"
                                   Visibility="{Binding IsPresent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding WorkStatusValue}"
                                        ContentTemplate="{StaticResource ComparisonWorkStatusBadgeTemplate}"
                                        Visibility="{Binding IsPresent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Critical}"
                               Text="{Binding IssueText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding IssueText}"
                               Visibility="{Binding HasIssues, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="DashboardRoot" ClipToBounds="True">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- The header stays put while the page below it scrolls. -->
    <DockPanel x:Name="PageHeader" Grid.Row="0" Margin="0,0,0,18">
        <WrapPanel Style="{StaticResource PageToolbarStyle}">
            <!-- The Project's pages, then its less frequent actions in "…", then the main action. -->
            <Button Margin="0,0,8,0" Click="OnOpenProjectReport" Content="Project report"
                    AutomationProperties.HelpText="Open the page that creates a report of this project to share" />
            <Button Margin="0,0,8,0" Click="OnOpenDevelopers" Content="Developers"
                    AutomationProperties.HelpText="Open the page that manages the developers in this project" />
            <Button x:Name="ProjectActionsButton" Margin="0,0,8,0" Click="OnProjectActionsClick"
                    ToolTip="More project actions"
                    AutomationProperties.Name="More project actions"
                    Style="{StaticResource SecondaryIconButtonStyle}">
                <controls:Icon IconKey="Icon.MoreHorizontal" />
                <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem Header="_Rename project…" Click="OnRenameProject" />
                        <MenuItem Header="Recycle _bin…" Click="OnOpenRecycleBin"
                                  ToolTip="Recycled trackers of this project, to restore or permanently delete" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Click="OnCreateTracker" Content="Create tracker"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </WrapPanel>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource PageHeadingTextStyle}"
                       Text="{Binding ProjectReporting.Dashboard.Project.Name}" />
        </StackPanel>
    </DockPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  ScrollChanged="OnDashboardScrollChanged">
        <StackPanel>
            <Border Margin="0,0,0,12" Style="{StaticResource InfoMessageStyle}"
                    Visibility="{Binding ProjectReporting.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="Loading Project dashboard…" />
            </Border>

            <Border Margin="0,0,0,18" Padding="16" Style="{StaticResource EntityTrackerCardStyle}"
                    DataContext="{Binding ProjectReporting.RepositoryCard}">
                <!-- One header row in both modes, so the card keeps its title and buttons in place.
                     Synced with nothing to do: the status sits in the header and the details are folded. -->
                <StackPanel>
                    <DockPanel MinHeight="{DynamicResource Height.Control}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsCompact, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Margin="0,0,8,0" Content="Cancel sync" Command="{Binding CancelSyncCommand}"
                                    AutomationProperties.HelpText="Cancel a waiting or running project sync"
                                    Visibility="{Binding CanCancelSync, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,0,8,0" Content="Sync now" Command="{Binding SyncCommand}"
                                    AutomationProperties.HelpText="Commit the project snapshot and sync it with the repository now"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="Details" Command="{Binding ToggleDetailsCommand}"
                                    AutomationProperties.HelpText="Show the repository path, branch, upstream and actions" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Hide details"
                                Command="{Binding ToggleDetailsCommand}"
                                Visibility="{Binding CanHideDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel x:Name="CompactRepositoryRow" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Text="Git repository" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsCompact, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:SyncStatusIcon Margin="12,0,0,0" Size="18" VerticalAlignment="Center"
                                                         x:Name="CompactRepositorySyncIcon"
                                                         ProjectId="{Binding ProjectId}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="{Binding Indicator.Label, ElementName=CompactRepositorySyncIcon}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- The Project's sync state: the same icon as in the header and the Portfolio,
                             with its sentence beside it. -->
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <controls:SyncStatusIcon x:Name="RepositorySyncIcon" Size="18" VerticalAlignment="Center"
                                                     ProjectId="{Binding ProjectId}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="{Binding Indicator.Label, ElementName=RepositorySyncIcon}"
                                       Visibility="{Binding Visibility, ElementName=RepositorySyncIcon}" />
                        </StackPanel>
                        <TextBlock Margin="0,5,0,0" Text="{Binding RepositoryPath}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding Branch}"
                                   Visibility="{Binding IsLinked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding Upstream}"
                                   Visibility="{Binding IsLinked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding LastResult}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding LastSyncTiming}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Visibility="{Binding HasLastSyncTiming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding PendingAction}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Visibility="{Binding HasPendingAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Content="Link repository" Command="{Binding LinkCommand}"
                                    AutomationProperties.HelpText="Link an existing Git repository to this project" />
                            <Button Margin="0,0,8,0" Content="Sync now" Command="{Binding SyncCommand}"
                                    AutomationProperties.HelpText="Commit the project snapshot and sync it with the repository now"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="Unlink" Command="{Binding UnlinkCommand}"
                                    AutomationProperties.Name="Unlink Git repository" />
                            <Button Margin="8,0,0,0" Content="Cancel sync"
                                    Command="{Binding CancelSyncCommand}"
                                    IsEnabled="{Binding CanCancelSync}"
                                    AutomationProperties.HelpText="Cancel a waiting or running project sync" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,0,0,10" FontSize="20" FontWeight="SemiBold" Text="Trackers" />
            <Border Margin="0,0,0,16" Padding="20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EntityTrackerCardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProjectReporting.HasTrackers}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="No active trackers" />
                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Create a blank tracker or copy an existing tracker."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding ProjectReporting.Dashboard.Trackers}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="390" MinHeight="285" Margin="0,0,14,14" Padding="18"
                                Style="{StaticResource EntityTrackerCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="1" Margin="0,12">
                                    <TextBlock Text="{Binding Progress.ActiveEntityCount, StringFormat={}{0} active entities}" />
                                    <StackPanel Margin="0,4,0,0" Background="Transparent">
                                        <StackPanel.ToolTip>
                                            <controls:ImplementedBreakdown Completed="{Binding Progress.DevelopmentCompletedCount}"
                                                                           Reconciled="{Binding Progress.ReconciledCount}"
                                                                           ReworkNeeded="{Binding Progress.ReworkNeededCount}"
                                                                           Reworking="{Binding Progress.ReworkingCount}" />
                                        </StackPanel.ToolTip>
                                        <TextBlock Text="{Binding Progress.ImplementedProgressText}" />
                                        <controls:ImplementedComposition Width="140" Margin="0,4,0,2" HorizontalAlignment="Left" Completed="{Binding Progress.DevelopmentCompletedCount}"
                                                                         Reconciled="{Binding Progress.ReconciledCount}"
                                                                         ReworkNeeded="{Binding Progress.ReworkNeededCount}"
                                                                         Reworking="{Binding Progress.ReworkingCount}"
                                                                         Total="{Binding Progress.ActiveEntityCount}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ReconciledProgressText}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ReadyCount, StringFormat={}{0} ready to start}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.BlockedCount, StringFormat={}{0} waiting on dependencies}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ManuallyBlockedCount, StringFormat={}{0} blocked}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ReworkNeededCount, StringFormat={}{0} rework needed}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.ReworkingCount, StringFormat={}{0} reworking}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Progress.UnresolvedReferenceCount, StringFormat={}{0} unresolved references}" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding Progress.LastActivityText}" />
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Margin="0,0,8,0" Click="OnOpenTracker" Content="Open"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Open tracker {0}}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <ToggleButton x:Name="TrackerActionsToggle" Grid.Column="1"
                                                  Padding="10,5"
                                                  MinHeight="{DynamicResource Height.Control}"
                                                  ToolTip="Tracker actions"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Actions for tracker {0}}"
                                                  AutomationProperties.HelpText="Show tracker actions"
                                                  Checked="OnTrackerActionsChecked"
                                                  Unchecked="OnTrackerActionsUnchecked">
                                        <controls:Icon IconKey="Icon.MoreHorizontal" Size="18" />
                                    </ToggleButton>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <views:AggregateProgressView Margin="0,8,0,22"
                                         DataContext="{Binding ProjectReporting.Progress}" />

            <Border Margin="0,8,0,0" Padding="16" Style="{StaticResource EntityTrackerCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Entity comparison" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="{Binding ProjectReporting.ComparisonSummary}" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Margin="0,0,0,8">
                        <Button AutomationProperties.Name="{Binding ProjectReporting.TotalEntityCount, StringFormat=Show all entities in the comparison. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding ProjectReporting.ShowAllEntities, StringFormat=Selected: {0}}"
                                Command="{Binding ProjectReporting.ToggleShowAllCommand}"
                                ToolTip="Show every entity, including those that match in every Tracker. Choose again to show only differences.">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.ShowAllEntities}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="All" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.TotalEntityCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding ProjectReporting.MissingCount, StringFormat=Filter comparison to missing entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding ProjectReporting.IsMissingSelected, StringFormat=Selected: {0}}"
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.Missing}"
                                Tag="{DynamicResource Brush.Brand.Green60}"
                                ToolTip="Filter to missing entities. Unavailable when the count is zero.">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsMissingSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Missing" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.MissingCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding ProjectReporting.DivergentCount, StringFormat=Filter comparison to divergent entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding ProjectReporting.IsDivergentSelected, StringFormat=Selected: {0}}"
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.Divergent}"
                                Tag="{DynamicResource Brush.Brand.Green60}"
                                ToolTip="Filter to divergent entities. Unavailable when the count is zero.">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsDivergentSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Divergent" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.DivergentCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding ProjectReporting.BlockedCount, StringFormat=Filter comparison to blocked entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding ProjectReporting.IsBlockedSelected, StringFormat=Selected: {0}}"
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.Blocked}"
                                Tag="{DynamicResource Brush.Status.Blocked}"
                                ToolTip="Filter to blocked entities. Unavailable when the count is zero.">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsBlockedSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Blocked" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.BlockedCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding ProjectReporting.WaitingOnDependenciesCount, StringFormat=Filter comparison to entities waiting on dependencies. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding ProjectReporting.IsWaitingOnDependenciesSelected, StringFormat=Selected: {0}}"
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.WaitingOnDependencies}"
                                Tag="{DynamicResource Brush.WorkStatus.WaitingOnDependencies}"
                                ToolTip="Filter to entities waiting on dependencies. Unavailable when the count is zero.">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsWaitingOnDependenciesSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Waiting on dependencies" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.WaitingOnDependenciesCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding ProjectReporting.ReworkCount, StringFormat=Filter comparison to rework entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding ProjectReporting.IsReworkSelected, StringFormat=Selected: {0}}"
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.ReworkNeeded}"
                                Tag="{DynamicResource Brush.Status.ReworkNeeded}"
                                ToolTip="Filter to Rework needed entities. Unavailable when the count is zero.">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsReworkSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Rework" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.ReworkCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding ProjectReporting.UnresolvedCount, StringFormat=Filter comparison to unresolved entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding ProjectReporting.IsUnresolvedSelected, StringFormat=Selected: {0}}"
                                Command="{Binding ProjectReporting.SelectCategoryCommand}"
                                CommandParameter="{x:Static projects:ProjectComparisonCategory.Unresolved}"
                                Tag="{DynamicResource Brush.Brand.Green60}"
                                ToolTip="Filter to unresolved entities. Unavailable when the count is zero.">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProjectReporting.IsUnresolvedSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Unresolved" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ProjectReporting.UnresolvedCount}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,8"
                                VerticalAlignment="Center"
                                AutomationProperties.HelpText="Clear the comparison category filter"
                                Command="{Binding ProjectReporting.ClearCategoryCommand}"
                                Content="Clear filter"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding ProjectReporting.HasCategoryFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>

                    <TextBlock Margin="0,8"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="These trackers have no active entities to compare."
                               Visibility="{Binding ProjectReporting.ShowNoComparisonEntities, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Margin="0,8"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ProjectReporting.ShowNoActionableRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"
                                   Text="{Binding ProjectReporting.ComparisonEmptyTitle}" />
                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding ProjectReporting.ComparisonEmptyHint}" />
                    </StackPanel>

                    <DataGrid x:Name="ComparisonGrid"
                              Height="470"
                              AutomationProperties.Name="Project entity comparison"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              FrozenColumnCount="1"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding ProjectReporting.ComparisonRows}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="CellOrRowHeader"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Entity"
                                                Binding="{Binding DisplayName}"
                                                IsReadOnly="True"
                                                MinWidth="180"
                                                Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    <Canvas x:Name="TrackerActionLayer" Grid.RowSpan="2" Panel.ZIndex="1" ClipToBounds="True"
            SizeChanged="OnTrackerActionLayerSizeChanged">
        <Border x:Name="TrackerActionsMenu" MinWidth="190" Padding="8"
                Background="{DynamicResource Brush.Surface.Page}"
                BorderBrush="{DynamicResource Brush.Border.Medium}"
                BorderThickness="1" CornerRadius="0,0,6,6"
                Visibility="Collapsed"
                PreviewKeyDown="OnTrackerActionsPreviewKeyDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.16" ShadowDepth="2" />
            </Border.Effect>
            <StackPanel>
                <Button x:Name="RenameTrackerAction" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="OnRenameTracker" Content="Rename"
                        AutomationProperties.Name="{Binding Name, StringFormat=Rename tracker {0}}" />
                <Button x:Name="SyncTrackerAction" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="OnSyncTracker" Content="Sync from source"
                        ToolTip="Bring later changes from the Tracker this one was copied from"
                        AutomationProperties.Name="{Binding Name, StringFormat=Sync tracker {0} from source}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CopiedFromTrackerId}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="RecycleTrackerAction" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnRecycleTracker" Content="Recycle"
                        AutomationProperties.Name="{Binding Name, StringFormat=Recycle tracker {0}}"
                        Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
        </Border>
    </Canvas>
    </Grid>
</UserControl>
