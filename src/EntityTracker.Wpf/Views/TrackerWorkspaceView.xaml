<UserControl x:Class="EntityTracker.Wpf.Views.TrackerWorkspaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:configuration="clr-namespace:EntityTracker.Infrastructure.Configuration;assembly=EntityTracker.Infrastructure"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:controls="clr-namespace:EntityTracker.Wpf.Controls"
        xmlns:domain="clr-namespace:EntityTracker.Domain;assembly=EntityTracker.Domain"
        xmlns:workflow="clr-namespace:EntityTracker.Application.Workflow;assembly=EntityTracker.Application"
        xmlns:reporting="clr-namespace:EntityTracker.Reporting;assembly=EntityTracker.Reporting"
        xmlns:services="clr-namespace:EntityTracker.Wpf.Services"
        xmlns:viewModels="clr-namespace:EntityTracker.Wpf.ViewModels"
        mc:Ignorable="d"
        Background="{DynamicResource Brush.Surface.Page}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        PreviewKeyDown="OnWorkspacePreviewKeyDown"
        PreviewMouseDown="OnWindowPreviewMouseDown">
    <UserControl.Resources>
        <!-- Column headers sit outside the view's tree for binding, so they reach the view model through this. -->
        <controls:BindingProxy x:Key="WorkspaceProxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <!-- An Overview summary card: no box at rest, only its status colour as a bar along its left edge
             (the card's Tag; Total has none), as on the Project dashboard. Hovering shows a rounded box, as a
             sidebar item does; the selected card keeps its box visible. -->
        <Style x:Key="SummaryFilterButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,8" />
            <Setter Property="Padding" Value="12,10,16,10" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- The focus ring shows only when moving with the keyboard, outside the card, so a click never
                 covers the card. -->
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Margin="-3" BorderBrush="{DynamicResource Brush.Focus}" BorderThickness="2" CornerRadius="9" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="StatusEdge"
                                           Width="5"
                                           Margin="0,0,10,0"
                                           RadiusX="2.5"
                                           RadiusY="2.5"
                                           Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Card" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- A style trigger, so a card's own Selected trigger (declared later) wins over hover. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EntityNameButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <DataTemplate x:Key="DevelopmentStatusBadgeTemplate">
            <!-- A hollow status (Not relevant) has no fill: a dashed edge is drawn over the badge,
                 as a Border can't be dashed. -->
            <Grid HorizontalAlignment="Left">
                <Border x:Name="Badge"
                        Padding="12,5"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Status.NotStarted}"
                        CornerRadius="10">
                    <TextBlock x:Name="BadgeText"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Status.NotStarted.Text}"
                               Text="Not started" />
                </Border>
                <Rectangle x:Name="HollowEdge" RadiusX="10" RadiusY="10" StrokeThickness="1"
                           StrokeDashArray="3 2" Visibility="Collapsed"
                           Stroke="{DynamicResource Brush.Status.NotRelevant.Edge}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.InProgress}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.InProgress}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.InProgress.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="In progress" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.ReworkNeeded}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.ReworkNeeded}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.ReworkNeeded.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Rework needed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.Reworking}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.Reworking}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.Reworking.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Reworking" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.Blocked}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.Blocked}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.Blocked.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Blocked" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.DevelopmentCompleted}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.DevelopmentCompleted}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.DevelopmentCompleted.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Completed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.Reconciled}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.Reconciled}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.Reconciled.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Reconciled" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:DevelopmentStatus.NotRelevant}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Status.NotRelevant}" />
                    <Setter TargetName="HollowEdge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Status.NotRelevant.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Not relevant" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="WorkStatusBadgeTemplate">
            <!-- A hollow status (Not relevant) has no fill: a dashed edge is drawn over the badge,
                 as a Border can't be dashed. -->
            <Grid HorizontalAlignment="Left">
                <Border x:Name="Badge"
                        Padding="12,5"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Surface.Subtle}"
                        CornerRadius="10">
                    <TextBlock x:Name="BadgeText"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Text="Archived" />
                </Border>
                <Rectangle x:Name="HollowEdge" RadiusX="10" RadiusY="10" StrokeThickness="1"
                           StrokeDashArray="3 2" Visibility="Collapsed"
                           Stroke="{DynamicResource Brush.WorkStatus.NotRelevant.Edge}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.Ready}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.Ready}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.Ready.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Ready" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.Blocked}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.Blocked}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.Blocked.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Blocked" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.WaitingOnDependencies}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.WaitingOnDependencies}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.WaitingOnDependencies.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Waiting on dependencies" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.InProgress}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.InProgress}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.InProgress.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="In progress" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.Completed}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.Completed}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.Completed.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Completed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.Reconciled}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.Reconciled}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.Reconciled.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Reconciled" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static viewModels:WorkStatusDisplay.NotRelevant}">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WorkStatus.NotRelevant}" />
                    <Setter TargetName="HollowEdge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.WorkStatus.NotRelevant.Text}" />
                    <Setter TargetName="BadgeText" Property="Text" Value="Not relevant" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="DataGrid" BasedOn="{StaticResource EntityTrackerDataGridStyle}">
            <EventSetter Event="PreviewMouseMove" Handler="OnDataGridPreviewMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnDataGridPreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnDataGridPreviewMouseLeftButtonUp" />
            <EventSetter Event="MouseLeave" Handler="OnDataGridMouseLeave" />
            <EventSetter Event="LostMouseCapture" Handler="OnDataGridLostMouseCapture" />
        </Style>
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Height" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
    </UserControl.InputBindings>

    <Grid>
    <DockPanel x:Name="ApplicationContent">
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <Setter Property="IsHitTestVisible" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Editor.IsOpen}" Value="True">
                        <Setter Property="IsHitTestVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ManualCreation.IsOpen}" Value="True">
                        <Setter Property="IsHitTestVisible" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>
        <Border DockPanel.Dock="Top"
                Visibility="Collapsed"
                Padding="26,18"
                Background="{DynamicResource Brush.Surface.Primary}">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Text.OnDark}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Text="EntityTracker" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                           Text="Dependency-safe implementation overview" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="18,10"
                Background="{DynamicResource Brush.Surface.Subtle}"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="110"
                             Height="5"
                             Margin="0,0,12,0"
                             IsIndeterminate="True" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Text="{Binding BusyMessage}" />
            </StackPanel>
        </Border>

        <!-- The sidebar picks the page through SelectedTab, so the tabs have no height and the TabControl
             draws no frame of its own: each page sits in the work area like every other page. -->
        <TabControl x:Name="WorkspaceTabs"
                    Focusable="False"
                    IsTabStop="False"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedValue="{Binding SelectedTab}"
                    SelectedValuePath="Tag"
                    SelectionChanged="OnWorkspaceTabChanged">
            <TabItem Header="Overview" Focusable="False" IsTabStop="False" Tag="{x:Static viewModels:MainWindowTab.Overview}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <WrapPanel Style="{StaticResource PageToolbarStyle}">
                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="{Binding OverviewSearchResultSummary}" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding ActiveTable.ClearAllFiltersCommand}"
                                    ToolTip="Clear filters and sort"
                                    AutomationProperties.Name="Clear filters and sort"
                                    Style="{StaticResource SecondaryIconButtonStyle}">
                                <controls:Icon IconKey="Icon.FilterDismiss" />
                            </Button>
                            <!-- The page's search: always visible, focused by Ctrl+F; Fluent's clear button
                                 empties it. The same box is on Archived. -->
                            <controls:Icon Margin="0,0,6,0" VerticalAlignment="Center" Size="16"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" IconKey="Icon.Search" />
                            <TextBox x:Name="OverviewSearchTextBox"
                                     GotKeyboardFocus="OnSearchBoxFocused"
                                     Width="240"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     controls:Placeholder.Text="Search entities (Ctrl+F)"
                                     AutomationProperties.Name="Search active entities"
                                     Text="{Binding OverviewSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      Content="Dependency names"
                                      ToolTip="Search the names of dependencies instead of entity names"
                                      IsEnabled="{Binding ActiveTable.CanSearchDependencies}"
                                      IsChecked="{Binding SearchOverviewDependencies}" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="Refresh (F5)"
                                    AutomationProperties.Name="Refresh overview"
                                    Style="{StaticResource SecondaryIconButtonStyle}">
                                <controls:Icon IconKey="Icon.ArrowClockwise" />
                            </Button>
                            <Button x:Name="OverviewNewEntityButton"
                                    Margin="0,0,8,0"
                                    Command="{Binding OpenCreateEntityCommand}"
                                    AutomationProperties.Name="New entity"
                                    ToolTip="New entity (Ctrl+N)"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <controls:IconLabel IconKey="Icon.Add" Text="New entity" />
                            </Button>
                            <Button x:Name="OverviewExportButton"
                                    ToolTip="Export as Excel or CSV (Ctrl+E)"
                                    AutomationProperties.Name="Export overview"
                                    AutomationProperties.HelpText="Choose Excel or CSV export"
                                    PreviewMouseDown="OnOverviewExportButtonPreviewMouseDown"
                                    Click="OnOverviewExportButtonClick"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                <controls:IconLabel IconKey="Icon.ArrowExportUp" Text="Export" />
                            </Button>
                            <Popup x:Name="OverviewExportPopup"
                                   PlacementTarget="{Binding ElementName=OverviewExportButton}"
                                   Placement="Bottom" VerticalOffset="4"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                   StaysOpen="False" AllowsTransparency="True"
                                   Opened="OnOverviewExportPopupOpened"
                                   PreviewKeyDown="OnOverviewExportPopupKeyDown">
                                <Border Padding="8" Width="280"
                                        Background="{DynamicResource Brush.Surface.Page}"
                                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                                        BorderThickness="1" CornerRadius="5">
                                    <!-- What the export holds, before choosing a format: the rows (as set in
                                         Settings) and the internal content a client report leaves out. -->
                                    <StackPanel>
                                        <TextBlock x:Name="OverviewExportScope" Margin="2,0,2,8"
                                                   Style="{StaticResource PageDescriptionTextStyle}"
                                                   Text="{Binding ExportScopeSummary, Mode=OneWay}" />
                                        <Button x:Name="OverviewExcelExportButton" Content="Excel workbook (.xlsx)"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Command="{Binding ExportOverviewCommand}"
                                                CommandParameter="{x:Static services:OverviewExportFormat.Excel}"
                                                Click="OnOverviewExportChosen"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Margin="0,4,0,0" Content="CSV file (.csv)"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Command="{Binding ExportOverviewCommand}"
                                                CommandParameter="{x:Static services:OverviewExportFormat.Csv}"
                                                Click="OnOverviewExportChosen"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </WrapPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="Overview" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="Entities are ordered by due date, then priority, while dependencies remain before the entities that use them." />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">

                        <Button AutomationProperties.Name="{Binding TotalEntityCount, StringFormat=Show all active entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding IsTotalSummarySelected, StringFormat=Selected: {0}}"
                                Command="{Binding ActiveTable.ClearAllFiltersCommand}"
                                ToolTip="Show all active entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Total" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding TotalEntityCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding NotStartedCount, StringFormat=Show not started entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding IsNotStartedSummarySelected, StringFormat=Selected: {0}}"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.NotStarted}"
                                Tag="{DynamicResource Brush.Status.NotStarted}"
                                ToolTip="Show not started entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNotStartedSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Not started" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding NotStartedCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding InProgressCount, StringFormat=Show in progress entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding IsInProgressSummarySelected, StringFormat=Selected: {0}}"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.InProgress}"
                                Tag="{DynamicResource Brush.Status.InProgress}"
                                ToolTip="Show in progress entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInProgressSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="In progress" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding InProgressCount}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{Binding ReworkNeededCount, StringFormat=Show rework needed entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding IsReworkNeededSummarySelected, StringFormat=Selected: {0}}"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.ReworkNeeded}"
                                Tag="{DynamicResource Brush.Status.ReworkNeeded}"
                                ToolTip="Show rework needed entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReworkNeededSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Rework needed" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ReworkNeededCount}" />
                            </StackPanel>
                        </Button>

                        <Button AutomationProperties.Name="{Binding ReworkingCount, StringFormat=Show reworking entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding IsReworkingSummarySelected, StringFormat=Selected: {0}}"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.Reworking}"
                                Tag="{DynamicResource Brush.Status.Reworking}"
                                ToolTip="Show reworking entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReworkingSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Reworking" />
                                <TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold"
                                           Text="{Binding ReworkingCount}" />
                            </StackPanel>
                        </Button>

                        <Button AutomationProperties.Name="{Binding BlockedCount, StringFormat=Show blocked entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding IsBlockedSummarySelected, StringFormat=Selected: {0}}"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.Blocked}"
                                Tag="{DynamicResource Brush.Status.Blocked}"
                                ToolTip="Show manually blocked entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBlockedSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Blocked" />
                                <TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold"
                                           Text="{Binding BlockedCount}" />
                            </StackPanel>
                        </Button>

                        <Button AutomationProperties.Name="{Binding DevelopmentCompletedCount, StringFormat=Show development completed entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding IsDevelopmentCompletedSummarySelected, StringFormat=Selected: {0}}"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.DevelopmentCompleted}"
                                Tag="{DynamicResource Brush.Status.DevelopmentCompleted}"
                                ToolTip="Show development completed entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDevelopmentCompletedSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Completed" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding DevelopmentCompletedCount}" />
                            </StackPanel>
                        </Button>

                        <Button AutomationProperties.Name="{Binding ReconciledCount, StringFormat=Show reconciled entities. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding IsReconciledSummarySelected, StringFormat=Selected: {0}}"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.Reconciled}"
                                Tag="{DynamicResource Brush.Status.Reconciled}"
                                ToolTip="Show reconciled entities">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReconciledSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Reconciled" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding ReconciledCount}" />
                            </StackPanel>
                        </Button>

                        <!-- Not relevant in this Tracker: listed, but left out of "% implemented". -->
                        <Button AutomationProperties.Name="{Binding NotRelevantCount, StringFormat=Show entities that are not relevant. {0} entities}"
                                AutomationProperties.ItemStatus="{Binding IsNotRelevantSummarySelected, StringFormat=Selected: {0}}"
                                Command="{Binding SelectOverviewStatusCommand}"
                                CommandParameter="{x:Static domain:DevelopmentStatus.NotRelevant}"
                                Tag="{DynamicResource Brush.Status.NotRelevant.Edge}"
                                ToolTip="Show entities that are not relevant in this Tracker; they are left out of progress">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNotRelevantSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="Not relevant" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding NotRelevantCount}" />
                            </StackPanel>
                        </Button>

                        <!-- "% implemented" shows what it counts: its parts as a bar with a legend, their counts on
                             hover, and a click filters the list to those statuses (again: back to Total). -->
                        <Button AutomationProperties.Name="{Binding ImplementedPercentage, StringFormat='Show implemented entities: Completed, Reconciled, Rework needed and Reworking. {0:F0} percent implemented'}"
                                AutomationProperties.ItemStatus="{Binding IsImplementedSummarySelected, StringFormat=Selected: {0}}"
                                Command="{Binding SelectImplementedSummaryCommand}">
                            <Button.ToolTip>
                                <controls:ImplementedBreakdown Completed="{Binding DevelopmentCompletedCount}"
                                                               Reconciled="{Binding ReconciledCount}"
                                                               ReworkNeeded="{Binding ReworkNeededCount}"
                                                               Reworking="{Binding ReworkingCount}" />
                            </Button.ToolTip>
                            <Button.Style>
                                <Style BasedOn="{StaticResource SummaryFilterButtonStyle}"
                                       TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImplementedSummarySelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="{Binding ImplementedPercentage, StringFormat={}{0:F0}% implemented}" />
                                <controls:ImplementedComposition Margin="0,9,0,0" Completed="{Binding DevelopmentCompletedCount}"
                                                                 Reconciled="{Binding ReconciledCount}"
                                                                 ReworkNeeded="{Binding ReworkNeededCount}"
                                                                 Reworking="{Binding ReworkingCount}"
                                                                 Total="{Binding RelevantEntityCount}" />
                                <WrapPanel Margin="0,6,0,0">
                                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                        <Border Width="8"
                                                Height="8"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.Status.DevelopmentCompleted}"
                                                CornerRadius="4" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="Completed" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                        <Border Width="8"
                                                Height="8"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.Status.ReworkNeeded}"
                                                CornerRadius="4" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="Rework needed" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                        <Border Width="8" Height="8" Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.Status.Reworking}"
                                                CornerRadius="4" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="Reworking" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8"
                                                Height="8"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.Status.Reconciled}"
                                                CornerRadius="4" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="Reconciled" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Border x:Name="BulkStatusToolbar"
                            Grid.Row="3"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="{DynamicResource Brush.Surface.Subtle}"
                            BorderBrush="{DynamicResource Brush.Border.Medium}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DockPanel LastChildFill="False">
                            <TextBlock Margin="0,0,18,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       Text="{Binding BulkSelectionSummary}" />
                            <TextBlock Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="Set status to" />
                            <ComboBox MinWidth="155"
                                      Margin="0,0,8,0"
                                      AutomationProperties.Name="Bulk target status"
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding BulkStatusOptions}"
                                      SelectedValue="{Binding SelectedBulkStatus}"
                                      SelectedValuePath="Value" />
                            <Button AutomationProperties.Name="Apply status to selected entities"
                                    Command="{Binding ApplyBulkStatusCommand}"
                                    Content="Apply status"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </DockPanel>
                    </Border>


                    <Grid Grid.Row="5">
                        <DataGrid x:Name="OverviewDataGrid"
                                  AutomationProperties.Name="Active entities"
                                  ItemsSource="{Binding OverviewItems}"
                                  MouseDoubleClick="OnEntityDataGridMouseDoubleClick"
                                  SelectionChanged="OnOverviewSelectionChanged"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="72" Binding="{Binding Priority}" Header="Priority" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                                <DataGridTextColumn Width="70" Binding="{Binding Rank}" Header="Rank" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                                <DataGridTextColumn Width="100" Binding="{Binding Due}" Header="Due" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                                <DataGridTemplateColumn Width="2.2*" MinWidth="180" Header="Entity">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button AutomationProperties.Name="{Binding SourceName, StringFormat=View details for {0}}"
                                                        Command="{Binding DataContext.OpenEntityDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        PreviewMouseLeftButtonDown="OnEntityNamePreviewMouseLeftButtonDown"
                                                        Style="{StaticResource EntityNameButtonStyle}">
                                                    <TextBlock Text="{Binding SourceName}"
                                                               TextDecorations="Underline" />
                                                </Button>
                                                <Button Width="24"
                                                        Height="24"
                                                        Margin="6,0,0,0"
                                                        Padding="2"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding GraphIssueTitle}"
                                                        AutomationProperties.HelpText="{Binding GraphIssueDescription}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding GraphIssueTitle}"
                                                        Visibility="{Binding HasGraphIssue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Click="OnContextMenuButtonClick">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Caution}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDirectlyUnresolved}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Caution}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <controls:Icon IconKey="Icon.Warning" Size="18" IsHitTestVisible="False" />
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Focusable="False" IsHitTestVisible="False">
                                                                <MenuItem.Template>
                                                                    <ControlTemplate TargetType="MenuItem">
                                                                        <ContentPresenter ContentSource="Header" />
                                                                    </ControlTemplate>
                                                                </MenuItem.Template>
                                                                <MenuItem.Header>
                                                                    <StackPanel Width="320" Margin="12">
                                                                        <TextBlock FontSize="15"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                                                   Text="{Binding GraphIssueTitle}" />
                                                                        <TextBlock Margin="0,8,0,0"
                                                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                                   Text="{Binding GraphIssueDescription}"
                                                                                   TextWrapping="Wrap" />
                                                                        <TextBlock Margin="0,10,0,0"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                                                   Text="{Binding GraphIssueNames}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </MenuItem.Header>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="200">
                                    <DataGridTemplateColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding Data.ActiveTable.WorkStatusFilter, Source={StaticResource WorkspaceProxy}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl AutomationProperties.Name="{Binding WorkStatus, StringFormat=Work status: {0}}"
                                                            Content="{Binding WorkStatusDisplay}"
                                                            ContentTemplate="{StaticResource WorkStatusBadgeTemplate}"
                                                            Margin="4,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="180">
                                    <DataGridTemplateColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding Data.ActiveTable.StatusFilter, Source={StaticResource WorkspaceProxy}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl AutomationProperties.Name="{Binding Status, StringFormat=Development status: {0}}"
                                                            Content="{Binding DevelopmentStatus}"
                                                            ContentTemplate="{StaticResource DevelopmentStatusBadgeTemplate}"
                                                            Margin="4,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="150">
                                    <DataGridTemplateColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding Data.ActiveTable.ResponsibleDeveloperFilter, Source={StaticResource WorkspaceProxy}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding DeveloperItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><controls:SingleRowPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,2,4,2" Padding="5,2" CornerRadius="3"
                                                                    Background="{DynamicResource Brush.Surface.Card}"
                                                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                                                    BorderThickness="1"
                                                                    ToolTip="{Binding Label}">
                                                                <TextBlock Text="{Binding Initials}"
                                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                                           AutomationProperties.Name="{Binding Label}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding ResponsibleDeveloperDisplay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCurrentDevelopers}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="145"
                                                    Binding="{Binding GroupNameDisplay}" ElementStyle="{StaticResource CenteredCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding Data.ActiveTable.GroupFilter, Source={StaticResource WorkspaceProxy}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="2.2*"
                                                    Binding="{Binding BlockersDisplay}" ElementStyle="{StaticResource CenteredCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock AutomationProperties.HelpText="Unresolved or not-yet-implemented direct dependencies"
                                                   Text="Blockers"
                                                   ToolTip="Unresolved or not-yet-implemented direct dependencies" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="30"
                                                    Height="28"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Entity actions"
                                                    AutomationProperties.Name="{Binding SourceName, StringFormat=Actions for {0}}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Click="OnContextMenuButtonClick">
                                                <controls:Icon IconKey="Icon.MoreVertical" Size="18" />
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="View details"
                                                                  Command="{Binding PlacementTarget.Tag.OpenEntityDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="{Binding PlacementTarget.DataContext.ActionLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Command="{Binding PlacementTarget.Tag.EditOverviewEntityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="{DynamicResource Brush.Surface.Subtle}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                Visibility="{Binding ShowOverviewEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="No active entities" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="Use Add entity to create the first one." />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Brush.Surface.Subtle}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                Visibility="{Binding ShowOverviewSearchEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="No matching entities" />
                                <TextBlock Margin="0,7,0,12"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="Try another search or clear one of the active column filters."
                                           TextWrapping="Wrap" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding ClearOverviewSearchCommand}"
                                            Content="Clear search"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Command="{Binding ActiveTable.ClearAllFiltersCommand}"
                                            Content="Clear filters &amp; sort"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Dependency graph" Focusable="False" IsTabStop="False" Tag="{x:Static viewModels:MainWindowTab.DependencyGraph}">
                <Grid x:Name="DependencyGraphPage" DataContext="{Binding DependencyGraph}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <WrapPanel Style="{StaticResource PageToolbarStyle}">
                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       ToolTip="{Binding HiddenLinksDescription}"
                                       Text="{Binding Summary}" />
                            <ComboBox x:Name="DependencyGraphViewSelector" Margin="0,0,8,0" MinWidth="130"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Dependency graph view"
                                      ToolTip="Switch between the solar system and the top-to-bottom tree"
                                      ItemsSource="{x:Static viewModels:DependencyGraphViewModel.ViewOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="View"
                                      SelectedValue="{Binding View, Mode=TwoWay}" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding FitToViewCommand}"
                                    Content="Fit to view"
                                    ToolTip="Fit the whole map in view (0)"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding DataContext.OpenCreateEntityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.Name="New entity"
                                    ToolTip="New entity (Ctrl+N)"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <controls:IconLabel IconKey="Icon.Add" Text="New entity" />
                            </Button>
                            <Button Command="{Binding ExportPngCommand}"
                                    Content="Export PNG"
                                    AutomationProperties.HelpText="Save the dependency graph as a PNG image"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="Dependency graph" />
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <!-- Searches like the dependency search: word-aware suggestions, arrow keys,
                             Enter to choose (or find the best match), Esc to close the list. -->
                        <controls:SuggestionComboBox x:Name="DependencyGraphSearchBox"
                                                     controls:Placeholder.Text="Find an entity (Ctrl+F)"
                                                     Width="240" Margin="0,0,8,6" VerticalAlignment="Center"
                                                     AutomationProperties.Name="Find entity in dependency graph"
                                                     AutomationProperties.HelpText="Type part of a name; words in spaced, snake_case, PascalCase and camelCase names match. Use the arrow keys and Enter to choose."
                                                     ToolTip="Type an entity name (Ctrl+F); use the arrow keys and Enter to choose"
                                                     ToolTipService.ShowsToolTipOnKeyboardFocus="False"
                                                     IsEditable="True"
                                                     IsTextSearchEnabled="False"
                                                     Style="{StaticResource SuggestionComboBoxStyle}"
                                                     DisplayMemberPath="Label"
                                                     TextSearch.TextPath="Label"
                                                     ItemsSource="{Binding Suggestions}"
                                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsDropDownOpen="{Binding IsSuggestionsOpen}"
                                                     ChooseCommand="{Binding ChooseSuggestionCommand}"
                                                     SubmitCommand="{Binding FindCommand}"
                                                     RefreshCommand="{Binding RefreshSuggestionsCommand}" />
                        <!-- Enter in the box finds the best match, so the box needs no Find button. -->
                        <Border Width="8" />
                        <CheckBox Margin="0,0,16,6" VerticalAlignment="Center"
                                  Content="Focus on selection"
                                  AutomationProperties.HelpText="Hide everything except the selected entities and what they highlight."
                                  IsChecked="{Binding IsFocusMode}" />
                        <CheckBox Margin="0,0,16,6" VerticalAlignment="Center"
                                  Content="Hide unconnected"
                                  AutomationProperties.HelpText="Hide entities without dependencies or dependents."
                                  IsChecked="{Binding HideUnconnected}" />
                        <TextBlock Margin="0,0,6,6" VerticalAlignment="Center" Text="Highlight" />
                        <ComboBox x:Name="DependencyHighlightSelector" Margin="0,0,16,6" MinWidth="130"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Dependency highlight"
                                  ToolTip="What a selected entity highlights. Ctrl+click to select more than one."
                                  ItemsSource="{x:Static viewModels:DependencyGraphViewModel.HighlightOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Mode"
                                  SelectedValue="{Binding HighlightMode, Mode=TwoWay}" />
                        <Button Margin="0,0,0,6"
                                Command="{Binding ClearSelectionCommand}"
                                Content="Clear selection"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>

                    <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="Dot size: entities referring to it">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTreeView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl DockPanel.Dock="Right" Focusable="False"
                                      AutomationProperties.Name="Dependency graph legend"
                                      ItemsSource="{Binding Legend}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:DependencyGraphLegendItem}">
                                    <StackPanel Margin="12,0,0,0" Orientation="Horizontal">
                                        <controls:DependencyGraphLegendSwatch Width="14" Height="14" VerticalAlignment="Center"
                                                                              BrushKey="{Binding BrushKey}"
                                                                              Status="{Binding Status}"
                                                                              IsPlaceholder="{Binding IsPlaceholder}" />
                                        <TextBlock Margin="5,0,0,0" FontSize="12"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- The selected entity's links as a list: Tab moves from the map into it, and each row
                         selects that entity on the map or opens its details. -->
                    <Border x:Name="DependencyGraphRelationshipsPanel"
                            Grid.Column="1"
                            Width="260"
                            Margin="12,0,0,0"
                            Padding="12"
                            Style="{StaticResource EntityTrackerCardStyle}"
                            Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeadingTextStyle}"
                                       Text="{Binding SelectedNode.Label}" TextTrimming="CharacterEllipsis" />
                            <TextBlock DockPanel.Dock="Top" Margin="0,4,0,10"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="{Binding SelectionSummary}" />
                            <ListBox AutomationProperties.Name="Linked entities"
                                     BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     ItemsSource="{Binding Relationships}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="AutomationProperties.Name">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0} {1}, {2}">
                                                    <Binding Path="Relation" />
                                                    <Binding Path="Label" />
                                                    <Binding Path="Description" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.SelectRelationshipCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Select on the map"
                                                        AutomationProperties.Name="{Binding Label, StringFormat=Select {0} on the map}"
                                                        Style="{StaticResource IconButtonStyle}">
                                                    <controls:Icon IconKey="Icon.Flowchart" Size="14" />
                                                </Button>
                                                <Button Command="{Binding DataContext.OpenRelationshipDetailsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Open details"
                                                        AutomationProperties.Name="{Binding Label, StringFormat=Open details of {0}}"
                                                        Style="{StaticResource IconButtonStyle}">
                                                    <controls:Icon IconKey="Icon.Info" Size="14" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Relation}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Description}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid>
                            <controls:DependencyGraphCanvas x:Name="DependencyGraphCanvas"
                                                            AutomationProperties.Name="Dependency graph"
                                                            AutomationProperties.HelpText="Click an entity to highlight its dependencies. Double-click or press Enter to open details. Tab to the list of its linked entities. Escape clears the selection."
                                                            Graph="{Binding}"
                                                            Background="{DynamicResource Brush.Surface.Card}"
                                                            LabelBrush="{DynamicResource Brush.Text.Primary}"
                                                            EdgeBrush="{DynamicResource Brush.Border.Strong}"
                                                            HighlightBrush="{DynamicResource Brush.Text.Primary}"
                                                            SelectionBrush="{DynamicResource Brush.Graph.Selection}"
                                                            PlaceholderBrush="{DynamicResource Brush.Text.Secondary}"
                                                            CardBackground="{DynamicResource Brush.Surface.Page}" />
                            <TextBlock x:Name="DependencyGraphEmptyState"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="This Tracker has no active entities yet.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNodes}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Margin="12" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Style="{StaticResource ErrorMessageStyle}"
                                    Visibility="{Binding HasSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock AutomationProperties.LiveSetting="Assertive" Text="{Binding SearchMessage}" />
                            </Border>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Archived" Focusable="False" IsTabStop="False" Tag="{x:Static viewModels:MainWindowTab.Archived}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <WrapPanel Style="{StaticResource PageToolbarStyle}">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding ArchivedTable.ClearAllFiltersCommand}"
                                    ToolTip="Clear filters and sort"
                                    AutomationProperties.Name="Clear archived filters and sort"
                                    Style="{StaticResource SecondaryIconButtonStyle}">
                                <controls:Icon IconKey="Icon.FilterDismiss" />
                            </Button>
                            <controls:Icon Margin="0,0,6,0" VerticalAlignment="Center" Size="16"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" IconKey="Icon.Search" />
                            <TextBox x:Name="ArchivedSearchTextBox"
                                     GotKeyboardFocus="OnSearchBoxFocused"
                                     Width="240"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     controls:Placeholder.Text="Search archived entities (Ctrl+F)"
                                     AutomationProperties.Name="Search archived entities"
                                     Text="{Binding ArchivedTable.SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding RefreshCommand}"
                                    ToolTip="Refresh (F5)"
                                    AutomationProperties.Name="Refresh archived entities"
                                    Style="{StaticResource SecondaryIconButtonStyle}">
                                <controls:Icon IconKey="Icon.ArrowClockwise" />
                            </Button>
                        </WrapPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="Archived" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="Inspect archived metadata or restore an entity to the active dependency graph." />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Margin="0,0,0,8"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding ArchivedSearchResultSummary}" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <DataGrid x:Name="ArchivedDataGrid"
                                  AutomationProperties.Name="Archived entities"
                                  ItemsSource="{Binding ArchivedItems}"
                                  MouseDoubleClick="OnEntityDataGridMouseDoubleClick"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="2.2*" MinWidth="180" Header="Entity">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button AutomationProperties.Name="{Binding SourceName, StringFormat=View details for {0}}"
                                                    Command="{Binding DataContext.OpenEntityDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    PreviewMouseLeftButtonDown="OnEntityNamePreviewMouseLeftButtonDown"
                                                    Style="{StaticResource EntityNameButtonStyle}">
                                                <TextBlock Text="{Binding SourceName}"
                                                           TextDecorations="Underline" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="180">
                                    <DataGridTemplateColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding Data.ArchivedTable.StatusFilter, Source={StaticResource WorkspaceProxy}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl AutomationProperties.Name="{Binding Status, StringFormat=Development status: {0}}"
                                                            Content="{Binding DevelopmentStatus}"
                                                            ContentTemplate="{StaticResource DevelopmentStatusBadgeTemplate}"
                                                            Margin="4,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="150">
                                    <DataGridTemplateColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding Data.ArchivedTable.ResponsibleDeveloperFilter, Source={StaticResource WorkspaceProxy}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding DeveloperItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><controls:SingleRowPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,2,4,2" Padding="5,2" CornerRadius="3"
                                                                    Background="{DynamicResource Brush.Surface.Card}"
                                                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                                                    BorderThickness="1"
                                                                    ToolTip="{Binding Label}">
                                                                <TextBlock Text="{Binding Initials}"
                                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                                           AutomationProperties.Name="{Binding Label}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding ResponsibleDeveloperDisplay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCurrentDevelopers}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="145" Binding="{Binding GroupNameDisplay}" ElementStyle="{StaticResource CenteredCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <controls:FilterableColumnHeader Filter="{Binding Data.ArchivedTable.GroupFilter, Source={StaticResource WorkspaceProxy}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="76" Header="Actions">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="30"
                                                    Height="28"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Archived entity actions"
                                                    AutomationProperties.Name="{Binding SourceName, StringFormat=Archived actions for {0}}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Click="OnContextMenuButtonClick">
                                                <controls:Icon IconKey="Icon.MoreVertical" Size="18" />
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="View details"
                                                                  Command="{Binding PlacementTarget.Tag.OpenEntityDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="{Binding PlacementTarget.DataContext.ActionLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  Command="{Binding PlacementTarget.Tag.EditOverviewEntityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="{DynamicResource Brush.Surface.Subtle}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                Visibility="{Binding ShowArchivedEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="No archived entities" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="Archived entities will appear here and can be inspected or restored." />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Brush.Surface.Subtle}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                Visibility="{Binding ShowArchivedSearchEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="No matching archived entities" />
                                <TextBlock Margin="0,7,0,12"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="Try another search or clear one of the active column filters." />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding ArchivedTable.ClearSearchCommand}"
                                            Content="Clear search"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Command="{Binding ArchivedTable.ClearAllFiltersCommand}"
                                            Content="Clear filters &amp; sort"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>

        <!-- Starts below the page's heading and toolbar (set from code), so Export, search and Fit to view
             stay usable while it is open. -->
        <Border x:Name="EntityDetailsPane"
                Width="420"
                MaxWidth="420"
                Padding="20"
                IsVisibleChanged="OnDetailsPaneVisibilityChanged"
                Panel.ZIndex="50"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                AutomationProperties.LiveSetting="Polite"
                Background="{DynamicResource Brush.Surface.Page}"
                BorderBrush="{DynamicResource Brush.Border.Strong}"
                BorderThickness="1"
                CornerRadius="6"
                DataContext="{Binding SelectedEntityDetails}"
                Visibility="{Binding DataContext.IsEntityDetailsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14"
                           Visibility="{Binding IsSummaryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Margin="0,0,8,0" Content="{Binding SelfAssignmentActionLabel}"
                                AutomationProperties.Name="{Binding SelfAssignmentAccessibleName}"
                                Command="{Binding DataContext.AssignMeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,0,8,0"
                                Content="Edit"
                                AutomationProperties.Name="{Binding SourceName, StringFormat=Edit entity {0}}"
                                Command="{Binding DataContext.EditOverviewEntityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding OverviewRow}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,0,8,0"
                                Content="Restore…"
                                AutomationProperties.HelpText="Open the archived entity to restore it, or to delete it permanently"
                                Command="{Binding DataContext.EditOverviewEntityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding OverviewRow}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsArchived, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button x:Name="CloseEntityDetailsButton"
                                Width="34"
                                Height="34"
                                Padding="0"
                                AutomationProperties.Name="Close entity details"
                                Command="{Binding DataContext.CloseEntityDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Close details (Esc)">
                            <controls:Icon IconKey="Icon.Dismiss" Size="14" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock AutomationProperties.HeadingLevel="Level2"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Text="{Binding SourceName}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding Lifecycle}" />
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Row="0" Margin="0,0,0,14"
                           Visibility="{Binding IsFullHistoryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button x:Name="BackFromResponsibilityHistoryButton"
                            DockPanel.Dock="Left" Content="Back"
                            AutomationProperties.Name="Back to entity details"
                            Command="{Binding DataContext.BackFromResponsibilityHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="20"
                                   FontWeight="SemiBold" Text="Responsibility history" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding SourceName}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              Padding="0,0,14,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False"
                              Visibility="{Binding IsSummaryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding DataContext.HasAssignmentGuidance, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding DataContext.AssignmentGuidance, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                            <Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="Open Settings"
                                    AutomationProperties.Name="Open Settings to choose You in this Project"
                                    Command="{Binding DataContext.OpenIdentitySettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <WrapPanel Margin="0,0,0,16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Work status" />
                                <ContentControl AutomationProperties.Name="{Binding WorkStatus, StringFormat=Work status: {0}}"
                                                Content="{Binding WorkStatusDisplayValue}"
                                                ContentTemplate="{StaticResource WorkStatusBadgeTemplate}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Development status" />
                                <ContentControl AutomationProperties.Name="{Binding DevelopmentStatus, StringFormat=Development status: {0}}"
                                                Content="{Binding DevelopmentStatusValue}"
                                                ContentTemplate="{StaticResource DevelopmentStatusBadgeTemplate}" />
                            </StackPanel>
                        </WrapPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontWeight="SemiBold" Text="Requested priority" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding RequestedPriority}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="Effective priority" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding EffectivePriority}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,12,12,0">
                                <TextBlock FontWeight="SemiBold" Text="Due date" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding DueDate}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                <TextBlock FontWeight="SemiBold" Text="Effective due date" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding EffectiveDueDate}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,12,12,0">
                                <TextBlock FontWeight="SemiBold" Text="Rank" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding Rank}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontWeight="SemiBold" Text="Current developers" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding CurrentDevelopers}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="Group" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding GroupName}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <TextBlock FontWeight="SemiBold" Text="Responsibility timeline" />
                        <ItemsControl Margin="0,5,0,5" ItemsSource="{Binding ResponsibilityTimeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="{Binding Description}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="ViewFullResponsibilityHistoryButton"
                                Margin="0,0,0,16" HorizontalAlignment="Left"
                                Content="View full history"
                                AutomationProperties.Name="View full responsibility history"
                                Command="{Binding DataContext.ShowFullResponsibilityHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding HasHiddenResponsibilityHistory, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock FontWeight="SemiBold" Text="Internal notes" />
                        <TextBlock Margin="0,4,0,18"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding Notes}"
                                   TextWrapping="Wrap" />

                        <TextBlock FontWeight="SemiBold" Text="Shared notes" />
                        <TextBlock Margin="0,4,0,18"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding SharedNotes}"
                                   TextWrapping="Wrap" />

                        <TextBlock FontWeight="SemiBold" Text="Filter active" />
                        <TextBlock Margin="0,4,0,18"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding FilterActive}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,0,0,16"
                                Padding="10"
                                Style="{StaticResource WarningMessageStyle}"
                                Visibility="{Binding HasGraphIssue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding GraphIssueTitle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding GraphIssueDescription}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0"
                                           FontWeight="SemiBold"
                                           Text="{Binding GraphIssueNames}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="{Binding DependencyCount, StringFormat=Count: {0}}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding DependencySectionTitle}" />
                        </DockPanel>
                        <ItemsControl Margin="0,0,0,16"
                                      ItemsSource="{Binding Dependencies}"
                                      Visibility="{Binding HasDependencies, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" Text="{Binding Name, StringFormat=• {0}}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,0,0,16"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="None">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDependencies}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock AutomationProperties.HelpText="Unresolved or not-yet-implemented direct dependencies"
                                   FontWeight="SemiBold"
                                   Text="Blockers" />
                        <ItemsControl Margin="0,6,0,16"
                                      ItemsSource="{Binding Blockers}"
                                      Visibility="{Binding HasBlockers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,7">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,6,0,16"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding BlockersEmptyMessage}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBlockers}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock FontWeight="SemiBold" Text="Audit timestamps" />
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Created" />
                            <TextBlock Grid.Column="1" Text="{Binding CreatedAt}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Margin="0,5,0,0" Text="Name/lifecycle updated" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Text="{Binding SchemaUpdatedAt}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Margin="0,5,0,0" Text="Status/notes updated" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" Text="{Binding ProgressUpdatedAt}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto" CanContentScroll="False"
                              Visibility="{Binding IsFullHistoryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding FullResponsibilityTimeline}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding Description}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- New entity: the same modal surface as the entity editor, over whichever page opened it. -->
        <Grid x:Name="CreationOverlay"
              Panel.ZIndex="100"
              Background="{DynamicResource Brush.Overlay}"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              KeyboardNavigation.TabNavigation="Cycle"
              Visibility="{Binding ManualCreation.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="CreationSurface"
                    MaxWidth="960"
                    MaxHeight="760"
                    Margin="24"
                    Padding="22"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.Surface.Page}"
                    BorderBrush="{DynamicResource Brush.Border.Medium}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Focusable="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock FontSize="20"
                                   AutomationProperties.HeadingLevel="Level2"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Text="{Binding DataContext.TrackerContextName, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=New entity in {0}, FallbackValue=New entity}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="Add a new entity and its initial dependencies. A name no entity has yet is kept as an unresolved reference, and is connected when an entity with that name is added."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer x:Name="CreationScrollViewer"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Identity on the left, dependencies on the right, as in the entity editor. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            <Border Padding="16"
                                    Style="{StaticResource EntityTrackerCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Identity and planning" />
                                    <TextBlock Margin="0,3,0,14"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="Name the entity and optionally record ownership, grouping, its requested priority, and a due date."
                                               TextWrapping="Wrap" />

                                    <Label Target="{Binding ElementName=ManualEntityNameTextBox}" Content="Entity name" />
                                    <TextBox x:Name="ManualEntityNameTextBox"
                                             controls:Placeholder.Text="Name of the entity, e.g. customer_account"
                                             Margin="0,4,0,12"
                                             Padding="9,7"
                                             AutomationProperties.Name="Entity name"
                                             Text="{Binding ManualCreation.EntityName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock FontWeight="SemiBold" Text="Responsible developers" />
                                    <TextBlock Margin="0,3,0,5" Text="Select one or more Project developers." />
                                    <TextBox Margin="0,0,0,5" Padding="9,7"
                                             AutomationProperties.Name="Search Project developers"
                                             controls:Placeholder.Text="Search developers by initials or name"
                                             Text="{Binding ManualCreation.DeveloperPicker.Query, UpdateSourceTrigger=PropertyChanged}" />
                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="False">
                                        <ItemsControl ItemsSource="{Binding ManualCreation.DeveloperPicker.FilteredChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Margin="2,3" Content="{Binding Label}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              AutomationProperties.Name="{Binding Label}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Margin="0,7,0,12"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="No available developers. Add one from Project → Developers."
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ManualCreation.DeveloperPicker.HasAvailableDevelopers}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <Label Target="{Binding ElementName=ManualGroupComboBox}" Content="Group" />
                                            <controls:SuggestionComboBox x:Name="ManualGroupComboBox"
                                                      controls:Placeholder.Text="Type or choose a group"
                                                      Margin="0,4,0,0"
                                                      AutomationProperties.HelpText="Type a new group or choose an existing group."
                                                      AutomationProperties.Name="Group"
                                                      Style="{StaticResource SuggestionComboBoxStyle}"
                                                      ItemsSource="{Binding ManualCreation.GroupSuggestions}"
                                                      ChooseCommand="{Binding ManualCreation.UseGroupSuggestionCommand}"
                                                      Text="{Binding ManualCreation.GroupName, UpdateSourceTrigger=PropertyChanged}"
                                                      IsDropDownOpen="{Binding ManualCreation.IsGroupSuggestionsOpen}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Target="{Binding ElementName=ManualPriorityComboBox}" Content="Requested priority" />
                                            <ComboBox x:Name="ManualPriorityComboBox"
                                                      Margin="0,4,0,0"
                                                      AutomationProperties.HelpText="Optional priority from one, highest, to five."
                                                      AutomationProperties.Name="Requested priority"
                                                      DisplayMemberPath="DisplayName"
                                                      ItemsSource="{Binding ManualCreation.PriorityOptions}"
                                                      SelectedValue="{Binding ManualCreation.SelectedRequestedPriority}"
                                                      SelectedValuePath="Value" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                            <Label Target="{Binding ElementName=ManualDueDatePicker}" Content="Due date" />
                                            <DatePicker x:Name="ManualDueDatePicker"
                                                        Margin="0,4,0,0"
                                                        AutomationProperties.HelpText="Optional. A due date orders before priority, and the entity's dependencies inherit it."
                                                        AutomationProperties.Name="Due date"
                                                        SelectedDate="{Binding ManualCreation.SelectedDueDate}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,7,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding ManualCreation.GroupSearchMessage}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding ManualCreation.HasGroupSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ManualDependenciesSection"
                                    Grid.Column="2"
                                    Padding="16"
                                    Style="{StaticResource EntityTrackerCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Dependencies" />
                                    <TextBlock Margin="0,3,0,12"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="Choose an active entity, or add a name that is not an entity yet as unresolved."
                                               TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:SuggestionComboBox x:Name="ManualDependencyComboBox"
                                                                     controls:Placeholder.Text="Type an entity name to add a dependency"
                                                                     AutomationProperties.HelpText="Open the dropdown to browse active entities, or type to search. Choose an entity to add it."
                                                                     AutomationProperties.Name="Dependency"
                                                                     IsEditable="True"
                                                                     IsTextSearchEnabled="False"
                                                                     DisplayMemberPath="SourceName"
                                                                     TextSearch.TextPath="SourceName"
                                                                     Style="{StaticResource SuggestionComboBoxStyle}"
                                                                     ItemsSource="{Binding ManualCreation.Suggestions}"
                                                                     ChooseCommand="{Binding ManualCreation.AddExistingCommand}"
                                                                     Text="{Binding ManualCreation.DependencyQuery, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsDropDownOpen="{Binding ManualCreation.IsDependencySuggestionsOpen}"
                                                                     RefreshCommand="{Binding ManualCreation.RefreshDependencySuggestionsCommand}" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                AutomationProperties.HelpText="Add the typed dependency even though it does not match an active entity."
                                                Command="{Binding ManualCreation.AddUnresolvedCommand}"
                                                Content="Add as unresolved"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock Margin="0,7,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding ManualCreation.SearchMessage}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding ManualCreation.HasSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <TextBlock Margin="0,16,0,7" FontWeight="SemiBold" Text="Selected dependencies" />
                                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="No dependencies selected."
                                               Visibility="{Binding ManualCreation.HasNoSelectedDependencies, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{Binding ManualCreation.SelectedDependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="9"
                                                Background="{DynamicResource Brush.Surface.Card}"
                                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding SourceName, StringFormat=Remove dependency on {0}}"
                                                        ToolTip="{Binding SourceName, StringFormat=Remove dependency on {0}}"
                                                        Command="{Binding DataContext.ManualCreation.RemoveDependencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButtonStyle}">
                                                    <controls:Icon IconKey="Icon.Dismiss" />
                                                </Button>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                        <controls:Icon Margin="0,0,5,0" Size="14" VerticalAlignment="Center"
                                                                       IconKey="Icon.Warning"
                                                                       Foreground="{DynamicResource Brush.Caution}"
                                                                       Visibility="{Binding IsUnresolved, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                   Text="{Binding ResolutionLabel}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            </Grid>
                            <Border Margin="0,12,0,0"
                                    MaxHeight="110"
                                    Style="{StaticResource WarningMessageStyle}"
                                    Visibility="{Binding ManualCreation.HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <controls:Icon DockPanel.Dock="Left" Margin="0,1,8,0" Size="16" VerticalAlignment="Top"
                                                   IconKey="Icon.Warning"
                                                   Foreground="{DynamicResource Brush.Caution}"
                                                   AutomationProperties.Name="Warning" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ManualCreation.Warnings}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Style="{StaticResource InfoMessageStyle}"
                                    Visibility="{Binding ManualCreation.HasArchivedEntityMatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Margin="12,0,0,0"
                                            Command="{Binding ManualCreation.RestoreArchivedCommand}"
                                            Content="Restore existing entity"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               Text="{Binding ManualCreation.ArchivedEntityMessage}"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    MaxHeight="110"
                                    Style="{StaticResource ErrorMessageStyle}"
                                    Visibility="{Binding ManualCreation.HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <controls:Icon DockPanel.Dock="Left" Margin="0,1,8,0" Size="16" VerticalAlignment="Top"
                                                   IconKey="Icon.DismissCircle"
                                                   Foreground="{DynamicResource Brush.Critical}"
                                                   AutomationProperties.Name="Error" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ManualCreation.Errors}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <TextBlock Margin="0,12,0,0"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       Text="{Binding ManualCreation.OperationMessage}"
                                       Visibility="{Binding ManualCreation.HasOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Command="{Binding ManualCreation.CreateCommand}"
                                Content="_Create entity"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding ManualCreation.CreateAnotherCommand}"
                                Content="Create and _add another"
                                AutomationProperties.HelpText="Create this entity and keep the form open for the next one"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="CancelCreationButton"
                                Command="{Binding ManualCreation.CancelCommand}"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="EditorOverlay"
              Panel.ZIndex="100"
              Background="{DynamicResource Brush.Overlay}"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              KeyboardNavigation.TabNavigation="Cycle"
              Visibility="{Binding Editor.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="EditorSurface"
                    MaxWidth="960"
                    MaxHeight="760"
                    Margin="24"
                    Padding="22"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.Surface.Page}"
                    BorderBrush="{DynamicResource Brush.Border.Medium}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Focusable="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock FontSize="20"
                                   AutomationProperties.HeadingLevel="Level2"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Text="{Binding Editor.ContextTitle}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding Editor.ContextDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer x:Name="EditorScrollViewer"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
                            <TextBlock Margin="0,0,0,16"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="{Binding Editor.SelectedEntityName}" />
                            <StackPanel Visibility="{Binding Editor.HasSelectedEntity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Margin="0,0,0,14"
                                        Padding="16"
                                        Style="{StaticResource EntityTrackerCardStyle}"
                                        Visibility="{Binding Editor.ShowArchivedSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Archived entity" />
                                        <TextBlock Margin="0,6,0,0" Text="{Binding Editor.SelectedStatusDisplay, StringFormat=Status: {0}}" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Editor.ArchivedCurrentDevelopers, StringFormat=Current developers: {0}}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,3" FontWeight="SemiBold" Text="Responsibility timeline" />
                                        <ItemsControl ItemsSource="{Binding Editor.ArchivedResponsibilityTimeline}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,5">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                   Text="{Binding Description}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Margin="0,7,0,0" HorizontalAlignment="Left"
                                                Content="View full history"
                                                AutomationProperties.Name="View full archived responsibility history"
                                                Command="{Binding ShowArchivedResponsibilityHistoryCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Visibility="{Binding Editor.HasArchivedHiddenResponsibilityHistory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Editor.EditedGroupName, StringFormat=Group: {0}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Editor.EditedGroupName}" Value="">
                                                            <Setter Property="Text" Value="Group: —" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Editor.EffectivePriority, StringFormat=Effective priority: {0}}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="{Binding Editor.EditedNotes}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding Editor.ShowStandaloneSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border x:Name="EditorNameSection" Margin="0,0,0,14" Padding="16" Style="{StaticResource EntityTrackerCardStyle}">
                                    <StackPanel>
                                        <Label x:Name="EditorNameLabel" Padding="0" FontSize="16" FontWeight="SemiBold" Content="Name"
                                               Target="{Binding ElementName=EditorNameTextBox}" />
                                        <TextBox x:Name="EditorNameTextBox" Margin="0,6,0,0" Padding="8"
                                                 controls:Placeholder.Text="Name of the entity"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=EditorNameLabel}"
                                                 IsEnabled="{Binding Editor.CanEditName}"
                                                 Text="{Binding Editor.EditedName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Border Margin="0,8,0,0" Style="{StaticResource ErrorMessageStyle}"
                                                Visibility="{Binding Editor.HasNameError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Editor.NameError}" TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Assertive" />
                                        </Border>
                                        <Border Margin="0,8,0,0" Style="{StaticResource WarningMessageStyle}"
                                                Visibility="{Binding Editor.HasRenameNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Editor.RenameNotice}" TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,0,14" Padding="16" Style="{StaticResource EntityTrackerCardStyle}">
                                <StackPanel>
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="Progress and ownership" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="EditorProgressFields" Grid.Column="0">
                                        <TextBlock FontWeight="SemiBold" Text="Development status" />
                                        <ComboBox x:Name="EditorStatusComboBox"
                                                  AutomationProperties.Name="Development status"
                                                  Margin="0,5,0,0"
                                                  DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding Editor.CanEditProgress}"
                                                  ItemsSource="{Binding Editor.StatusOptions}"
                                                  SelectedValue="{Binding Editor.SelectedStatus}"
                                                  SelectedValuePath="Value" />
                                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Internal notes" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="Never shown in client report"
                                                   TextWrapping="Wrap" />
                                        <TextBox MinHeight="64"
                                                 AutomationProperties.Name="Internal notes"
                                                 AutomationProperties.HelpText="Never shown in client report"
                                                 Margin="0,5,0,0"
                                                 Padding="8"
                                                 AcceptsReturn="True"
                                                 IsEnabled="{Binding Editor.CanEditProgress}"
                                                 Text="{Binding Editor.EditedNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Shared notes" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="Shared with the client in Project reports."
                                                   TextWrapping="Wrap" />
                                        <TextBox MinHeight="64"
                                                 AutomationProperties.Name="Shared notes"
                                                 AutomationProperties.HelpText="Shared with the client in Project reports."
                                                 Margin="0,5,0,0"
                                                 Padding="8"
                                                 AcceptsReturn="True"
                                                 IsEnabled="{Binding Editor.CanEditProgress}"
                                                 Text="{Binding Editor.EditedSharedNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Filter active" />
                                        <TextBox MinHeight="64"
                                                 AutomationProperties.Name="Filter active"
                                                 controls:Placeholder.Text="How active rows are filtered"
                                                 Margin="0,5,0,0"
                                                 Padding="8"
                                                 AcceptsReturn="True"
                                                 IsEnabled="{Binding Editor.CanEditProgress}"
                                                 Text="{Binding Editor.EditedFilterActive, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- As tall as the fields in column 1: the developer list fills the space down to the Group field. -->
                                    <DockPanel x:Name="EditorDeveloperColumn" Grid.Column="2" LastChildFill="True"
                                               Height="{Binding ActualHeight, ElementName=EditorProgressFields}"
                                               IsEnabled="{Binding Editor.CanEditProgress}">
                                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Responsible developers" />
                                    <Button DockPanel.Dock="Top" Margin="0,7,0,4" HorizontalAlignment="Left" Content="{Binding Editor.SelfAssignmentActionLabel}"
                                            AutomationProperties.Name="{Binding Editor.SelfAssignmentAccessibleName}"
                                            Command="{Binding Editor.AssignMeCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding Editor.HasAssignmentGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Editor.AssignmentGuidance}" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Assertive" />
                                        <Button Margin="0,6,0,4" HorizontalAlignment="Left" Content="Open Settings"
                                                AutomationProperties.Name="Open Settings to choose You in this Project"
                                                Command="{Binding Editor.OpenIdentitySettingsCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="EditorDeveloperSearchBox" DockPanel.Dock="Top" Margin="0,5,0,5" Padding="8,6"
                                             controls:Placeholder.Text="Search developers by initials or name"
                                             AutomationProperties.Name="Search Project developers"
                                             Text="{Binding Editor.DeveloperPicker.Query, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock DockPanel.Dock="Bottom" Margin="0,7,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="No available developers. Add one from Project → Developers."
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Editor.DeveloperPicker.HasAvailableDevelopers}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border x:Name="EditorDeveloperListFrame" Padding="6,4" CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Border.Default}">
                                        <ScrollViewer x:Name="EditorDeveloperList" VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="False">
                                            <ItemsControl ItemsSource="{Binding Editor.DeveloperPicker.FilteredChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Margin="2,3" Content="{Binding Label}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{Binding Label}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    </DockPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock FontWeight="SemiBold" Text="Group" />
                                    <controls:SuggestionComboBox x:Name="EditorGroupComboBox"
                                              controls:Placeholder.Text="Type or choose a group"
                                              Margin="0,5,0,0"
                                              AutomationProperties.HelpText="Type a new group or choose an existing group."
                                              AutomationProperties.Name="Group"
                                              Style="{StaticResource SuggestionComboBoxStyle}"
                                              IsEnabled="{Binding Editor.CanEditProgress}"
                                              ItemsSource="{Binding Editor.GroupSuggestions}"
                                              ChooseCommand="{Binding Editor.UseGroupSuggestionCommand}"
                                              Text="{Binding Editor.EditedGroupName, UpdateSourceTrigger=PropertyChanged}"
                                              IsDropDownOpen="{Binding Editor.IsGroupSuggestionsOpen}" />
                                    <TextBlock Margin="0,7,0,0"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               Text="{Binding Editor.GroupSearchMessage}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Editor.HasGroupSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock FontWeight="SemiBold" Text="Requested priority" />
                                        <ComboBox Margin="0,5,0,0"
                                                  AutomationProperties.Name="Requested priority"
                                                  DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding Editor.CanEditPriority}"
                                                  ItemsSource="{Binding Editor.PriorityOptions}"
                                                  SelectedValue="{Binding Editor.SelectedRequestedPriority}"
                                                  SelectedValuePath="Value" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="Effective priority" />
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Editor.EffectivePriority}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="Inherited from this entity or an active dependent target."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="EditorDueDatePanel" Margin="0,0,0,12">
                                    <TextBlock FontWeight="SemiBold" Text="Due date" />
                                    <DatePicker Width="208"
                                                Margin="0,5,0,0"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.HelpText="Optional. A due date orders before priority, and the entities this one depends on inherit it."
                                                AutomationProperties.Name="Due date"
                                                IsEnabled="{Binding Editor.CanEditPriority}"
                                                SelectedDate="{Binding Editor.SelectedDueDate}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="Orders before priority; the entities this one depends on inherit it. Clear the date to remove it."
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Margin="0,0,0,14"
                                        Padding="10"
                                        Background="{DynamicResource Brush.Surface.Subtle}"
                                        BorderBrush="{DynamicResource Brush.Border.Medium}"
                                        BorderThickness="1"
                                        Visibility="{Binding Editor.HasPendingPriorityChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Priority impact preview" />
                                        <TextBlock Margin="0,2,0,8"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Text="This shows the target and resolved prerequisites affected when you save."
                                                   TextWrapping="Wrap" />
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Editor.PriorityPreviewRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="100" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Role}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding RequestedPriority, StringFormat=Requested: {0}}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding EffectivePriority, StringFormat=Effective: {0}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </ScrollViewer>
                                        <Border Margin="0,7,0,0"
                                                Padding="8"
                                                Style="{StaticResource WarningMessageStyle}"
                                                Visibility="{Binding Editor.HasPriorityUnresolvedDependencies, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="Unresolved dependencies cannot receive priority:" />
                                                <ItemsControl Margin="0,3,0,0"
                                                              ItemsSource="{Binding Editor.PriorityUnresolvedDependencyNames}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                                </Border>
                                </StackPanel>

                                <Border x:Name="EditorDependenciesSection"
                                        Margin="0,0,0,14"
                                        Padding="16"
                                        Style="{StaticResource EntityTrackerCardStyle}">
                                <StackPanel>
                                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="Dependencies" />
                                <StackPanel Visibility="{Binding Editor.ShowDependencyEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontWeight="SemiBold" Text="Add a dependency" />
                                <TextBlock Margin="0,3,0,7"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="Search active entities, or add a name that is not an entity yet as unresolved."
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:SuggestionComboBox x:Name="EditorDependencyComboBox"
                                                                 controls:Placeholder.Text="Type an entity name to add a dependency"
                                                                 AutomationProperties.HelpText="Open the dropdown to browse active entities, or type to search. Choose an entity to add it."
                                                                 AutomationProperties.Name="Dependency"
                                                                 IsEditable="True"
                                                                 IsTextSearchEnabled="False"
                                                                 DisplayMemberPath="SourceName"
                                                                 TextSearch.TextPath="SourceName"
                                                                 Style="{StaticResource SuggestionComboBoxStyle}"
                                                                 ItemsSource="{Binding Editor.Suggestions}"
                                                                 ChooseCommand="{Binding Editor.AddExistingCommand}"
                                                                 Text="{Binding Editor.DependencyQuery, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsDropDownOpen="{Binding Editor.IsDependencySuggestionsOpen}"
                                                                 RefreshCommand="{Binding Editor.RefreshDependencySuggestionsCommand}" />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding Editor.AddUnresolvedCommand}"
                                            Content="Add as unresolved"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>

                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Text="{Binding Editor.SearchMessage}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Editor.HasSearchMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                </StackPanel>

                                <TextBlock Margin="0,6,0,7" FontWeight="SemiBold" Text="Dependencies" />
                                <ItemsControl ItemsSource="{Binding Editor.Dependencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="9" Background="{DynamicResource Brush.Surface.Page}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding DataContext.Editor.ShowDependencyEditor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button Margin="6,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.Editor.RemoveDependencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="{Binding SourceName, StringFormat=Remove dependency on {0}}"
                                                                ToolTip="{Binding SourceName, StringFormat=Remove dependency on {0}}"
                                                                Style="{StaticResource IconButtonStyle}">
                                                            <controls:Icon IconKey="Icon.Dismiss" />
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" />
                                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                            <controls:Icon Margin="0,0,5,0" Size="14" VerticalAlignment="Center"
                                                                           IconKey="Icon.Warning"
                                                                           Foreground="{DynamicResource Brush.Caution}"
                                                                           Visibility="{Binding IsUnresolved, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Resolution}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        MaxHeight="110"
                                        Style="{StaticResource WarningMessageStyle}"
                                        Visibility="{Binding Editor.HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <controls:Icon DockPanel.Dock="Left" Margin="0,1,8,0" Size="16" VerticalAlignment="Top"
                                                       IconKey="Icon.Warning"
                                                       Foreground="{DynamicResource Brush.Caution}"
                                                       AutomationProperties.Name="Warning" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Editor.Warnings}" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        MaxHeight="110"
                                        Style="{StaticResource ErrorMessageStyle}"
                                        Visibility="{Binding Editor.HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <controls:Icon DockPanel.Dock="Left" Margin="0,1,8,0" Size="16" VerticalAlignment="Top"
                                                       IconKey="Icon.DismissCircle"
                                                       Foreground="{DynamicResource Brush.Critical}"
                                                       AutomationProperties.Name="Error" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Editor.Errors}" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The destructive action stays alone on the left; the commit and Cancel (or Close, for
                         a read-only archived entity) sit on the right, commit first. -->
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button x:Name="ArchiveEntityButton" DockPanel.Dock="Left"
                                Command="{Binding Editor.RequestArchiveCommand}"
                                Content="Archive entity"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding Editor.CanArchive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button DockPanel.Dock="Left"
                                x:Name="PurgeEntityButton"
                                Command="{Binding Editor.RequestPurgeCommand}"
                                Content="Permanently delete entity"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding Editor.CanPurgeEntity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding Editor.SaveCommand}"
                                    Content="{Binding Editor.SaveLabel}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="{Binding Editor.ShowSave, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button x:Name="RestoreEntityButton"
                                    Margin="0,0,8,0"
                                    Command="{Binding Editor.RestoreEntityCommand}"
                                    Content="Restore entity"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="{Binding Editor.CanRestoreEntity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Command="{Binding Editor.CancelCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Content" Value="Cancel" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Editor.IsArchivedMode}" Value="True">
                                                <Setter Property="Content" Value="Close" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.RowSpan="3"
                          Panel.ZIndex="10"
                          Background="{DynamicResource Brush.Overlay}"
                          FocusManager.IsFocusScope="True"
                          FocusManager.FocusedElement="{Binding ElementName=CancelArchiveButton}"
                          Visibility="{Binding Editor.IsArchiveConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border x:Name="ArchiveConfirmationSurface"
                                Width="560"
                                MaxWidth="560"
                                Padding="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Surface.Page}"
                                BorderBrush="{DynamicResource Brush.Accent}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           AutomationProperties.HeadingLevel="Level2"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Text="Archive entity?" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Text="{Binding Editor.ArchiveConfirmationMessage}"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,20,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <!-- Cancel is the default and starts focused, so Enter and Esc keep the entity. -->
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding Editor.ConfirmArchiveCommand}"
                                            Content="Archive entity"
                                            Style="{StaticResource DangerButtonStyle}" />
                                    <Button x:Name="CancelArchiveButton"
                                            Command="{Binding Editor.CancelArchiveCommand}"
                                            Content="Cancel"
                                            IsDefault="True"
                                            IsCancel="True"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.RowSpan="3"
                          Panel.ZIndex="11"
                          Background="{DynamicResource Brush.Overlay}"
                          FocusManager.IsFocusScope="True"
                          FocusManager.FocusedElement="{Binding ElementName=CancelPurgeButton}"
                          Visibility="{Binding Editor.IsPurgeConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border x:Name="PurgeConfirmationSurface"
                                Width="560"
                                MaxWidth="560"
                                Padding="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Surface.Page}"
                                BorderBrush="{DynamicResource Brush.Accent}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           AutomationProperties.HeadingLevel="Level2"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Text="Permanently delete entity?" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Text="{Binding Editor.PurgeConfirmationMessage}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,14,0,4"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Text="Type the exact entity name to continue:"
                                           TextWrapping="Wrap" />
                                <TextBox x:Name="PurgeConfirmationTextBox"
                                         controls:Placeholder.Text="Type the entity name to confirm"
                                         AutomationProperties.Name="Exact entity name confirmation"
                                         Text="{Binding Editor.TypedPurgeConfirmation, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Margin="0,20,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding Editor.ConfirmPurgeCommand}"
                                            Content="Permanently delete"
                                            Style="{StaticResource DangerButtonStyle}" />
                                    <Button x:Name="CancelPurgeButton"
                                            Command="{Binding Editor.CancelPurgeCommand}"
                                            Content="Cancel"
                                            IsDefault="True"
                                            IsCancel="True"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
