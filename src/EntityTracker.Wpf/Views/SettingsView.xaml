<UserControl x:Class="EntityTracker.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:configuration="clr-namespace:EntityTracker.Infrastructure.Configuration;assembly=EntityTracker.Infrastructure"
             xmlns:viewModels="clr-namespace:EntityTracker.Wpf.ViewModels"
             xmlns:services="clr-namespace:EntityTracker.Wpf.Services"
             xmlns:app="clr-namespace:EntityTracker.Wpf">
    <UserControl.Resources>
        <!-- Separates groups of cards on a settings page, such as Overview and Dependency graph. -->
        <Style x:Key="SettingsGroupHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeadingTextStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SettingsPageStyle" TargetType="StackPanel">
            <Setter Property="MaxWidth" Value="720" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="Settings" />
            <TextBlock Margin="0,4,0,20" Style="{StaticResource PageDescriptionTextStyle}"
                       Text="Changes apply immediately and are saved locally." />
        </StackPanel>
        <ListBox x:Name="SettingsCategoryList" Grid.Row="1" Margin="0,0,20,0"
                 VerticalAlignment="Top"
                 Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="Settings categories"
                 ItemsSource="{Binding SettingsCategories}"
                 SelectedItem="{Binding SelectedSettingsCategory, Mode=TwoWay}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding Converter={x:Static services:SettingsCategoryLabelConverter.Instance}}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static services:SettingsCategoryLabelConverter.Instance}}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer Grid.Row="1" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="GeneralSettingsPage">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource SettingsPageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static viewModels:SettingsCategory.General}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Padding="18" Style="{StaticResource EntityTrackerCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionHeadingTextStyle}" Text="Appearance" />
                            <TextBlock Margin="0,0,0,12" Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="System follows the current Windows app theme. Light and Dark stay selected until you change this setting." />
                            <RadioButton Margin="0,4" Content="System — follow Windows" GroupName="Appearance" Command="{Binding Appearance.SelectAppearanceCommand}"
                                         AutomationProperties.HelpText="Use the current Windows app theme."
                                         CommandParameter="{x:Static configuration:ApplicationAppearance.System}" IsChecked="{Binding Appearance.IsSystem, Mode=OneWay}" />
                            <RadioButton Margin="0,4" Content="Light" GroupName="Appearance" Command="{Binding Appearance.SelectAppearanceCommand}"
                                         AutomationProperties.HelpText="Always use the light appearance."
                                         CommandParameter="{x:Static configuration:ApplicationAppearance.Light}" IsChecked="{Binding Appearance.IsLight, Mode=OneWay}" />
                            <RadioButton Margin="0,4" Content="Dark" GroupName="Appearance" Command="{Binding Appearance.SelectAppearanceCommand}"
                                         AutomationProperties.HelpText="Always use the dark appearance."
                                         CommandParameter="{x:Static configuration:ApplicationAppearance.Dark}" IsChecked="{Binding Appearance.IsDark, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ProjectSettingsPage">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource SettingsPageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static viewModels:SettingsCategory.Project}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Padding="18" Style="{StaticResource EntityTrackerCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeadingTextStyle}" Text="You in this Project" />
                            <TextBlock Margin="0,4,0,10" Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="Choose the Developer used by Assign me. This choice stays on this installation and can be changed at any time."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Configure identity for project" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="Any of your Projects; it does not change the Project you are working in." />
                            <ComboBox Margin="0,5,0,10" MinWidth="280" HorizontalAlignment="Left"
                                      AutomationProperties.Name="Configure identity for project"
                                      AutomationProperties.HelpText="Select the Project whose local settings you want to change."
                                      ItemsSource="{Binding Projects}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SettingsProject, Mode=TwoWay}" />
                            <TextBlock FontWeight="SemiBold" Text="Developer" />
                            <ComboBox Margin="0,5,0,0" MinWidth="280" HorizontalAlignment="Left"
                                      AutomationProperties.Name="You in this Project Developer"
                                      AutomationProperties.HelpText="Select an available Developer for the selected Project."
                                      ItemsSource="{Binding LocalIdentity.AvailableDevelopers}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding LocalIdentity.SelectedDeveloper, Mode=TwoWay}"
                                      IsEnabled="{Binding LocalIdentity.CanChoose}" />
                            <TextBlock Margin="0,7,0,0" Text="{Binding LocalIdentity.SelectionDescription}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="Clear choice"
                                    AutomationProperties.Name="Clear You in this Project choice"
                                    Command="{Binding LocalIdentity.ClearCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="TrackerSettingsPage">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource SettingsPageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static viewModels:SettingsCategory.Tracker}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Margin="0,0,0,14" Style="{StaticResource PageDescriptionTextStyle}"
                               Text="These preferences apply to every Tracker on this installation." />
                    <TextBlock Style="{StaticResource SettingsGroupHeadingStyle}" Margin="0,0,0,10" Text="Overview" />
                    <Border Padding="18" Style="{StaticResource EntityTrackerCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionHeadingTextStyle}"
                                       Text="Overview search" />
                            <TextBlock Margin="0,0,0,12" Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="Include current developers' initials and names when searching entities. Dependency search stays separate."
                                       TextWrapping="Wrap" />
                            <CheckBox Content="Search responsible names"
                                      AutomationProperties.Name="Search responsible names in entity overviews"
                                      Command="{Binding ResponsibilitySearch.ToggleCommand}"
                                      IsChecked="{Binding ResponsibilitySearch.IsEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="DueDateSettingsCard" Margin="0,16,0,0" Padding="18" Style="{StaticResource EntityTrackerCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionHeadingTextStyle}"
                                       Text="Due dates" />
                            <TextBlock Margin="0,0,0,12" Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="An entity must be done before the entities that depend on it, so it inherits their earliest due date. The order always uses it; the Due column shows only an entity's own due date unless this is on."
                                       TextWrapping="Wrap" />
                            <CheckBox Content="Show inherited due dates"
                                      AutomationProperties.Name="Show inherited due dates in the overview"
                                      Command="{Binding DueDates.ToggleCommand}"
                                      IsChecked="{Binding DueDates.IsEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="OverviewExportSettingsCard" Margin="0,16,0,0" Padding="18" Style="{StaticResource EntityTrackerCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionHeadingTextStyle}"
                                       Text="Overview export" />
                            <TextBlock Margin="0,0,0,12" Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="Choose which active entities are exported. Shown entities follow the current search, filters and sort; all active entities keep the sort."
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Rows to export" />
                            <ComboBox Margin="0,5,0,10" MinWidth="240" HorizontalAlignment="Left"
                                      AutomationProperties.Name="Rows to export"
                                      IsEnabled="{Binding OverviewExport.CanEdit}"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding OverviewExport.Rows, Mode=OneWay}"
                                      SelectionChanged="OnExportRowsChanged">
                                <ComboBoxItem Content="Shown entities" Tag="{x:Static configuration:OverviewExportRows.ShownEntities}" />
                                <ComboBoxItem Content="All active entities" Tag="{x:Static configuration:OverviewExportRows.AllActiveEntities}" />
                            </ComboBox>
                            <TextBlock FontWeight="SemiBold" Text="CSV separator" />
                            <ComboBox Margin="0,5,0,0" MinWidth="240" HorizontalAlignment="Left"
                                      AutomationProperties.Name="CSV separator"
                                      IsEnabled="{Binding OverviewExport.CanEdit}"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding OverviewExport.Separator, Mode=OneWay}"
                                      SelectionChanged="OnCsvSeparatorChanged">
                                <ComboBoxItem Content="Semicolon" Tag="{x:Static configuration:OverviewCsvSeparator.Semicolon}" />
                                <ComboBoxItem Content="Comma" Tag="{x:Static configuration:OverviewCsvSeparator.Comma}" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SettingsGroupHeadingStyle}" Margin="0,28,0,10" Text="Dependency graph" />
                    <Border x:Name="DependencyGraphSettingsCard" Padding="18" Style="{StaticResource EntityTrackerCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionHeadingTextStyle}" Text="Display" />
                            <TextBlock Margin="0,0,0,12" Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="The rotation pauses while you hover, drag, pan, zoom or have an entity selected."
                                       TextWrapping="Wrap" />
                            <CheckBox Content="Slowly rotate the dependency graph"
                                      AutomationProperties.Name="Slowly rotate the dependency graph"
                                      Command="{Binding GraphSettings.ToggleAnimationCommand}"
                                      IsChecked="{Binding GraphSettings.IsAnimationEnabled, Mode=OneWay}" />
                            <CheckBox Margin="0,8,0,0" Content="Show orbit rings"
                                      AutomationProperties.Name="Show orbit rings in the dependency graph"
                                      AutomationProperties.HelpText="Draw a faint circle for each dependency level."
                                      Command="{Binding GraphSettings.ToggleRingsCommand}"
                                      IsChecked="{Binding GraphSettings.ShowRings, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="SyncSettingsPage">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource SettingsPageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static viewModels:SettingsCategory.Sync}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Padding="18" Style="{StaticResource EntityTrackerCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionHeadingTextStyle}"
                                       Text="Automatic Project sync" />
                            <TextBlock Margin="0,0,0,12" Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="Checks linked Projects after startup and at the selected interval. Sync now remains available when automatic sync is off. Configure Git and credentials outside EntityTracker." TextWrapping="Wrap" />
                            <CheckBox Content="Enable automatic sync"
                                      AutomationProperties.Name="Enable automatic Project sync"
                                      Command="{Binding AutoSync.ToggleCommand}"
                                      IsChecked="{Binding AutoSync.IsEnabled, Mode=OneWay}" />
                            <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Text="Check every" />
                            <WrapPanel>
                                <RadioButton Margin="0,4,16,4" GroupName="AutoSyncInterval" Content="1 minute"
                                             Command="{Binding AutoSync.SelectIntervalCommand}"
                                             CommandParameter="{x:Static viewModels:AutoSyncSettingsViewModel.OneMinute}"
                                             IsChecked="{Binding AutoSync.IsOneMinute, Mode=OneWay}" />
                                <RadioButton Margin="0,4,16,4" GroupName="AutoSyncInterval" Content="5 minutes"
                                             Command="{Binding AutoSync.SelectIntervalCommand}"
                                             CommandParameter="{x:Static viewModels:AutoSyncSettingsViewModel.FiveMinutes}"
                                             IsChecked="{Binding AutoSync.IsFiveMinutes, Mode=OneWay}" />
                                <RadioButton Margin="0,4,16,4" GroupName="AutoSyncInterval" Content="15 minutes"
                                             Command="{Binding AutoSync.SelectIntervalCommand}"
                                             CommandParameter="{x:Static viewModels:AutoSyncSettingsViewModel.FifteenMinutes}"
                                             IsChecked="{Binding AutoSync.IsFifteenMinutes, Mode=OneWay}" />
                                <RadioButton Margin="0,4,16,4" GroupName="AutoSyncInterval" Content="30 minutes"
                                             Command="{Binding AutoSync.SelectIntervalCommand}"
                                             CommandParameter="{x:Static viewModels:AutoSyncSettingsViewModel.ThirtyMinutes}"
                                             IsChecked="{Binding AutoSync.IsThirtyMinutes, Mode=OneWay}" />
                                <RadioButton Margin="0,4,16,4" GroupName="AutoSyncInterval" Content="60 minutes"
                                             Command="{Binding AutoSync.SelectIntervalCommand}"
                                             CommandParameter="{x:Static viewModels:AutoSyncSettingsViewModel.SixtyMinutes}"
                                             IsChecked="{Binding AutoSync.IsSixtyMinutes, Mode=OneWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AboutSettingsPage">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource SettingsPageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static viewModels:SettingsCategory.About}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Padding="18" Style="{StaticResource EntityTrackerCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="App version:" />
                                <TextBlock Margin="6,0,0,0"
                                           AutomationProperties.Name="{Binding AppVersion, StringFormat=App version {0}}"
                                           Text="{Binding AppVersion}" />
                            </StackPanel>
                            <!-- A newer minor or patch version (a major one is required and has its own overlay). -->
                            <DockPanel x:Name="AboutUpdate" Margin="0,10,0,0" LastChildFill="False"
                                       Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding AvailableUpdateVersion, StringFormat=EntityTracker {0} is available.}" />
                                <Button x:Name="AboutUpdateButton" Margin="12,0,0,0" Content="Update"
                                        Command="{Binding UpdateAppCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.Name="{Binding AvailableUpdateVersion, StringFormat=Update to EntityTracker {0}}"
                                        AutomationProperties.HelpText="Closes EntityTracker, installs the new version and opens it again" />
                            </DockPanel>
                            <!-- What an offered update brings, or what changed in this version. -->
                            <StackPanel x:Name="AboutWhatsNew" Margin="0,14,0,0" DataContext="{Binding WhatsNew}"
                                        Visibility="{Binding HasEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Heading}" />
                                <ScrollViewer Margin="0,8,0,0" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                              AutomationProperties.Name="{Binding Heading}">
                                    <ItemsControl Margin="0,0,14,0" ItemsSource="{Binding Entries}"
                                                  ItemTemplate="{StaticResource ReleaseNoteTemplate}" />
                                </ScrollViewer>
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="Created by:" />
                                <TextBlock x:Name="AboutCreatorLine" Margin="6,0,0,0"
                                           AutomationProperties.Name="{Binding Source={x:Static app:AppCredits.CreatorLine}, StringFormat=Created by {0}}"
                                           Text="{x:Static app:AppCredits.CreatorLine}" />
                            </StackPanel>
                            <TextBlock x:Name="AboutCopyrightLine" Margin="0,10,0,0"
                                       Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="{x:Static app:AppCredits.CopyrightLine}" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource PageDescriptionTextStyle}"
                                       Text="Open-source under the MIT License." />
                        </StackPanel>
                    </Border>
                    <Border x:Name="AboutDiagnostics" Margin="0,14,0,0" Padding="18"
                            Style="{StaticResource EntityTrackerCardStyle}"
                            DataContext="{Binding Diagnostics}">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Logs" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap"
                                       Text="EntityTracker keeps a log of the last 14 days. It helps find out what went wrong when something fails." />
                            <TextBlock Margin="0,8,0,0" Text="{Binding LogFolder}" TextWrapping="Wrap"
                                       AutomationProperties.Name="{Binding LogFolder, StringFormat=Log folder {0}}" />
                            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="Open log folder"
                                    Command="{Binding OpenLogFolderCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <CheckBox Margin="0,14,0,0" Content="Detailed logging (for troubleshooting)"
                                      IsChecked="{Binding DetailedLogging, Mode=OneWay}"
                                      Command="{Binding ToggleDetailedLoggingCommand}" />
                            <TextBlock Margin="24,2,0,0" Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap"
                                       Text="Also records each step, for example every Git command's details. Turn it on while reproducing a problem; the log grows faster." />
                            <TextBlock Margin="24,6,0,0" Foreground="{DynamicResource Brush.Review.Warning.Header}" TextWrapping="Wrap"
                                       Text="{Binding OverrideNote}"
                                       Visibility="{Binding HasOverrideNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
