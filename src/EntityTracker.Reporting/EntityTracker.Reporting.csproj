<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EntityTracker.Reporting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Styles and script written into every exported Project report. -->
    <EmbeddedResource Include="ProjectReports/Assets/report.css" LogicalName="EntityTracker.Reporting.ProjectReports.Assets.report.css" />
    <EmbeddedResource Include="ProjectReports/Assets/report-search.js" LogicalName="EntityTracker.Reporting.ProjectReports.Assets.report-search.js" />
    <EmbeddedResource Include="ProjectReports/Assets/report-charts.js" LogicalName="EntityTracker.Reporting.ProjectReports.Assets.report-charts.js" />
    <EmbeddedResource Include="ProjectReports/Assets/report-graph.js" LogicalName="EntityTracker.Reporting.ProjectReports.Assets.report-graph.js" />
    <EmbeddedResource Include="ProjectReports/Assets/report.js" LogicalName="EntityTracker.Reporting.ProjectReports.Assets.report.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EntityTracker.Application\EntityTracker.Application.csproj" />
    <ProjectReference Include="..\EntityTracker.Domain\EntityTracker.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
